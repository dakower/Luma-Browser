<?xml version="1.0" encoding="utf-8"?>
<!-- Luma Glass Tile: shortcut tile with specular highlight and touch ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2EFFFFFF">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#1CFFFFFF"
                android:endColor="#0AFFFFFF"
                android:type="linear"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</ripple>
