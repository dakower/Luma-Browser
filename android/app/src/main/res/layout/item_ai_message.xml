<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Assistant Header (Avatar + Title) - only shown for LumaAI -->
    <LinearLayout
        android:id="@+id/msgAssistantHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_luma_ai"
            android:layout_marginEnd="7dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LumaAI"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- User Role label (only for user messages) -->
    <TextView
        android:id="@+id/msgRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/luma_text_muted"
        android:textSize="10.5sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp"/>

    <!-- Bubble container -->
    <LinearLayout
        android:id="@+id/msgBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Attached / Circled Image Preview -->
        <ImageView
            android:id="@+id/msgImage"
            android:layout_width="220dp"
            android:layout_height="130dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_glass_card"
            android:clipToOutline="true"
            android:layout_marginBottom="6dp"
            android:visibility="gone"/>

        <!-- Message text -->
        <TextView
            android:id="@+id/msgText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/luma_text_primary"
            android:textSize="13.5sp"
            android:background="@drawable/bg_glass_card"
            android:padding="11dp"
            android:textIsSelectable="true"/>

        <!-- Telegram-style typing dots animation -->
        <LinearLayout
            android:id="@+id/msgTypingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <View
                android:id="@+id/dot1"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle_badge"
                android:layout_marginEnd="5dp"/>

            <View
                android:id="@+id/dot2"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle_badge"
                android:layout_marginEnd="5dp"/>

            <View
                android:id="@+id/dot3"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle_badge"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
