<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Role / sender label + time -->
    <TextView
        android:id="@+id/supportMsgRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/luma_text_muted"
        android:textSize="10.5sp"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp"/>

    <!-- Bubble container for image(s) + text -->
    <LinearLayout
        android:id="@+id/supportMsgBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="8dp">

        <!-- Single media view (when exactly 1 image or video) -->
        <FrameLayout
            android:id="@+id/supportMsgMediaFrame"
            android:layout_width="220dp"
            android:layout_height="160dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/supportMsgImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_surface_raised"/>

            <ImageView
                android:id="@+id/supportMsgPlayIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_pill"
                android:src="@drawable/ic_play"
                android:padding="11dp"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Multi-image container (when >1 image) -->
        <HorizontalScrollView
            android:id="@+id/supportMsgMultiScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/supportMsgMultiContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/supportMsgText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/luma_text_primary"
            android:textSize="13.5sp"/>
    </LinearLayout>

</LinearLayout>
