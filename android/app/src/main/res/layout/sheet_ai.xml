<?xml version="1.0" encoding="utf-8"?>
<!--
    sheet_ai.xml — LumaAI Panel
    Direct RecyclerView with native smooth scrolling (no ScrollView wrapper conflicts).
    Header + Context + Actions + Direct Chat List + Input Bar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0F12"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/luma_logo"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LumaAI"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/aiTabSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Контекст активной вкладки"
                android:textColor="#716C82"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- New Chat Button -->
        <FrameLayout
            android:id="@+id/btnAiNewChat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_raised"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus"/>
        </FrameLayout>

        <!-- Close Button -->
        <FrameLayout
            android:id="@+id/btnAiClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"/>
        </FrameLayout>

    </LinearLayout>

    <!-- ===== TOP SMART ACTIONS (Pills) ===== -->
    <HorizontalScrollView
        android:id="@+id/aiActionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardActionSummarize"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Суммаризация"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:background="@drawable/bg_surface_raised"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/cardActionExplain"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Объяснение"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/cardActionPlan"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="План действий"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/cardActionImprove"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Улучшить текст"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:background="@drawable/bg_glass_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== EMPTY STATE PLACEHOLDER ===== -->
    <LinearLayout
        android:id="@+id/aiEmptyBox"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LumaAI готов ответить на любые вопросы"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Видит текст и контекст активной вкладки"
            android:textColor="#716C82"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- ===== DIRECT RECYCLERVIEW (Native smooth scrolling without conflicts) ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/aiMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical"/>

    <!-- ===== CHIPS SUGGESTIONS ROW ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipExample"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Приведи пример"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipDetails"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Объясни подробнее"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipCompare"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Сравни варианты"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipSoundcloud"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="открой саундклауд"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== INPUT CAPSULE ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Спросите что-нибудь..."
            android:textColor="#FFFFFF"
            android:textColorHint="#716C82"
            android:textSize="13.5sp"
            android:singleLine="true"
            android:imeOptions="actionSend"/>

        <!-- Attachment Paperclip -->
        <ImageButton
            android:id="@+id/aiAttachment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@drawable/ic_bookmark"
            android:padding="6dp"
            android:contentDescription="Прикрепить"
            android:layout_marginEnd="4dp"/>

        <!-- Send Up Arrow Button -->
        <FrameLayout
            android:id="@+id/aiSendBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_raised"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_left"
                android:rotation="90"/>
        </FrameLayout>

    </LinearLayout>

    <!-- ===== FOOTER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/aiModelPill"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_surface_raised"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="LumaAI быстрый"
            android:textColor="#C7C3D1"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Безлимитный доступ"
            android:textColor="#716C82"
            android:textSize="11sp"/>

    </LinearLayout>

</LinearLayout>
