<?xml version="1.0" encoding="utf-8"?>
<!--
    sheet_ai.xml — 100% faithful replication of media_1790866502361.png
    Complete desktop LumaAI panel ported to Android bottom sheet.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0F12"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Luma Logo -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/luma_logo"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LumaAI"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/aiTabSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет активной вкладки"
                android:textColor="#716C82"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <!-- New Chat Icon Button -->
        <FrameLayout
            android:id="@+id/btnAiNewChat"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_raised"
            android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus"/>
        </FrameLayout>

        <!-- Close Icon Button -->
        <FrameLayout
            android:id="@+id/btnAiClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"/>
        </FrameLayout>

    </LinearLayout>

    <!-- ===== SEGMENTED TABS (Ассистент | История | Сохранённое) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="#16171B"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tabBtnAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_surface_raised"
            android:text="Ассистент"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tabBtnHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="История"
            android:textColor="#716C82"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tabBtnSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Сохранённое"
            android:textColor="#716C82"
            android:textSize="12sp"/>

    </LinearLayout>

    <ScrollView
        android:id="@+id/aiScrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== "ТЕКУЩАЯ СТРАНИЦА" CARD ===== -->
            <LinearLayout
                android:id="@+id/aiPageContextCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_book_open"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Текущая страница"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Контекст вкладки подключён"
                            android:textColor="#716C82"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Green "Подключено" Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Подключено"
                        android:textColor="#3AB87E"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="#152B1E"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>

                </LinearLayout>

                <!-- Inner box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#111215"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LumaAI видит текст и изображения активной вкладки."
                        android:textColor="#C7C3D1"
                        android:textSize="12sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ===== "ЧТО СДЕЛАТЬ? / УМНЫЕ ДЕЙСТВИЯ" SECTION ===== -->
            <LinearLayout
                android:id="@+id/aiActionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Что сделать?"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Умные действия"
                        android:textColor="#716C82"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <!-- 2x2 Grid of Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Action 1: Суммаризация -->
                    <LinearLayout
                        android:id="@+id/cardActionSummarize"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_search"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Суммаризация"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Кратко выделить главное"
                            android:textColor="#716C82"
                            android:textSize="10.5sp"/>
                    </LinearLayout>

                    <!-- Action 2: Объяснение -->
                    <LinearLayout
                        android:id="@+id/cardActionExplain"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_spark"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Объяснение"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Разобрать сложные места"
                            android:textColor="#716C82"
                            android:textSize="10.5sp"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Action 3: План действий -->
                    <LinearLayout
                        android:id="@+id/cardActionPlan"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_tabs"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="План действий"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Превратить текст в задачи"
                            android:textColor="#716C82"
                            android:textSize="10.5sp"/>
                    </LinearLayout>

                    <!-- Action 4: Улучшить текст -->
                    <LinearLayout
                        android:id="@+id/cardActionImprove"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_wand"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Улучшить текст"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Переписать яснее и лучше"
                            android:textColor="#716C82"
                            android:textSize="10.5sp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ===== "НЕДАВНЕЕ / ТЕКУЩАЯ СЕССИЯ" SECTION ===== -->
            <LinearLayout
                android:id="@+id/aiRecentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Недавнее"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Текущая сессия"
                        android:textColor="#716C82"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <!-- Box with empty state text -->
                <LinearLayout
                    android:id="@+id/aiEmptyBox"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Здесь появятся ваши последние вопросы"
                        android:textColor="#716C82"
                        android:textSize="12.5sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Active Messages RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/aiMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <!-- ===== CHIPS SUGGESTIONS (matching reference image) ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipExample"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Приведи пример"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/chipDetails"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Объясни подробнее"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/chipCompare"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Сравни варианты"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/chipSoundcloud"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="открой саундклауд"
                android:textColor="#C7C3D1"
                android:textSize="11.5sp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== INPUT CAPSULE (matching reference image) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Спросите что-нибудь..."
            android:textColor="#FFFFFF"
            android:textColorHint="#716C82"
            android:textSize="13.5sp"
            android:singleLine="true"
            android:imeOptions="actionSend"/>

        <!-- Attachment Paperclip -->
        <ImageButton
            android:id="@+id/aiAttachment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@null"
            android:src="@drawable/ic_bookmark"
            android:padding="6dp"
            android:contentDescription="Прикрепить"
            android:layout_marginEnd="4dp"/>

        <!-- Send Up Arrow Button -->
        <FrameLayout
            android:id="@+id/aiSendBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_left"
                android:rotation="90"/>
        </FrameLayout>

    </LinearLayout>

    <!-- ===== FOOTER (LumaAI быстрый | Безлимитный доступ) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- LumaAI быстрый pill -->
        <TextView
            android:id="@+id/aiModelPill"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_surface_raised"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="LumaAI быстрый"
            android:textColor="#C7C3D1"
            android:textSize="11sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Безлимитный доступ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Безлимитный доступ"
            android:textColor="#716C82"
            android:textSize="11sp"/>

    </LinearLayout>

</LinearLayout>
