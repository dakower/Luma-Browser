<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/luma_panel"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/luma_logo"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Luma ID"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Единый аккаунт браузера и сайта"
                android:textColor="#716C82"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnAccountClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"/>
        </FrameLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/luma_border" android:layout_marginBottom="14dp"/>

    <!-- Profile & AI Quota Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_accent_circle"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/accountAvatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accountDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Гость Luma"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/accountEmailText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Не авторизован"
                    android:textColor="#716C82"
                    android:textSize="12sp"
                    android:singleLine="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/accountStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Гость"
                android:textColor="#A29DB8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_surface_raised"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/luma_border"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- AI Quota Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_surface_raised"
            android:padding="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_luma_ai"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лимит запросов к LumaAI"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/accountQuotaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Осталось: 15 / 15 сегодня"
                    android:textColor="#FFB86C"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/accountQuotaType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Базовый"
                android:textColor="#716C82"
                android:textSize="10.5sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- LOGGED OUT: Login / Register Form -->
    <LinearLayout
        android:id="@+id/accountLoginForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ВХОД ИЛИ РЕГИСТРАЦИЯ"
            android:textColor="#716C82"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/accountInputEmail"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_card"
            android:textColor="#FFFFFF"
            android:textColorHint="#716C82"
            android:textSize="13.5sp"
            android:hint="Email аккаунта"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/accountInputPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_card"
            android:textColor="#FFFFFF"
            android:textColorHint="#716C82"
            android:textSize="13.5sp"
            android:hint="Пароль"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAccountLogin"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Войти"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/selector_accent_button"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnAccountRegister"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Регистрация"
                android:textColor="#A29DB8"
                android:textSize="13sp"
                android:background="@drawable/bg_surface_raised"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/accountAuthStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF6B6B"
            android:textSize="11.5sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- LOGGED IN: Actions (Logout / Sync) -->
    <LinearLayout
        android:id="@+id/accountLoggedInSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnAccountLogout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Выйти из аккаунта"
            android:textColor="#FF6B6B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_surface_raised"/>
    </LinearLayout>

</LinearLayout>
