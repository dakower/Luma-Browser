<?xml version="1.0" encoding="utf-8"?>
<!-- Complete Luma Settings Bottom Sheet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0F12"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_gear"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Настройки Luma"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <FrameLayout
            android:id="@+id/btnSettingsClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"/>
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECTION: ПОИСКОВАЯ СИСТЕМА -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПОИСКОВАЯ СИСТЕМА"
                android:textColor="#716C82"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/btnSearchGoogle"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Google"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_surface_raised"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnSearchYandex"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Яндекс"
                    android:textColor="#716C82"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnSearchDuck"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="DuckDuckGo"
                    android:textColor="#716C82"
                    android:textSize="11sp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnSearchBing"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Bing"
                    android:textColor="#716C82"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- SECTION: КАСТОМИЗАЦИЯ ГЛАВНОЙ ВКЛАДКИ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ГЛАВНАЯ ВКЛАДКА"
                android:textColor="#716C82"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Форма строки поиска"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/btnShapePill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Капсула"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:background="@drawable/bg_surface_raised"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/btnShapeRounded"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Скруглённая"
                        android:textColor="#716C82"
                        android:textSize="11.5sp"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/btnShapeSquare"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Квадратная"
                        android:textColor="#716C82"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222329" android:layout_marginBottom="12dp"/>

                <!-- Switches -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Показывать заголовок «Куда отправимся?»"
                        android:textColor="#C7C3D1"
                        android:textSize="12.5sp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Показывать быстрые плашки (Pills)"
                        android:textColor="#C7C3D1"
                        android:textSize="12.5sp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

            </LinearLayout>

            <!-- SECTION: КОНФИДЕНЦИАЛЬНОСТЬ И БЕЗОПАСНОСТЬ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="БЕЗОПАСНОСТЬ И ПРИВАТНОСТЬ"
                android:textColor="#716C82"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Блокировка рекламы (AdBlocker)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAdBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Защита от трекеров и аналитики"
                        android:textColor="#C7C3D1"
                        android:textSize="12.5sp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTrackers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222329" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnClearData"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_surface_raised"
                    android:text="Очистить историю и кэш"
                    android:textColor="#E05252"
                    android:textSize="12.5sp"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- SECTION: LUMAAI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUMAAI"
                android:textColor="#716C82"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Используемая модель"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnModelFast"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="LumaAI Быстрый"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:background="@drawable/bg_surface_raised"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/btnModelPro"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="LumaAI Pro"
                        android:textColor="#716C82"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION: О БРАУЗЕРЕ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/luma_logo"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luma Browser 2.1.4"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Версия для Android • Движок Luma v2"
                    android:textColor="#716C82"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
