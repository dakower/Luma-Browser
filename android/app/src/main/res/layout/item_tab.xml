<?xml version="1.0" encoding="utf-8"?>
<!-- Single tab item in the tab list -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_tab_inactive"
    android:layout_marginBottom="6dp"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <!-- Favicon -->
    <ImageView
        android:id="@+id/tabFavicon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_globe"
        android:layout_marginEnd="12dp"/>

    <!-- Title + URL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tabTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/luma_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/tabUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/luma_text_muted"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Close tab -->
    <ImageButton
        android:id="@+id/tabClose"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/selector_icon_button"
        android:src="@drawable/ic_close"
        android:padding="5dp"
        android:contentDescription="@string/close_tab"/>

</LinearLayout>
