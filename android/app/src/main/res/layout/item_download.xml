<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemDownloadCard"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_glass_card"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/itemDownloadIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_download"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemDownloadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle"/>

        <TextView
            android:id="@+id/itemDownloadSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#716C82"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Share button -->
    <ImageButton
        android:id="@+id/itemDownloadShare"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share"
        android:padding="8dp"
        android:contentDescription="Поделиться"/>

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/itemDownloadDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:padding="9dp"
        android:contentDescription="Удалить"/>

</LinearLayout>
