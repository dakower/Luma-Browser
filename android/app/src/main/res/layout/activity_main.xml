<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — 100% faithful replication of media_1790866441976.png
    Dark ambient backdrop, centered Luma brand & search, floating "Спросить LumaAI" gradient button.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luma_bg">

    <!-- ===== WEBVIEW (for web pages) ===== -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:visibility="gone"/>

    <!-- ===== PROGRESS BAR ===== -->
    <ProgressBar
        android:id="@+id/pageProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="56dp"
        android:progressTint="@color/luma_accent"
        android:progressBackgroundTint="@color/transparent"
        android:max="100"
        android:progress="0"
        android:visibility="invisible"/>

    <!-- ===== TOP APP BAR (matching reference mockup) ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="6dp">

        <!-- Address Bar Pill (contains Luma logo + text) -->
        <LinearLayout
            android:id="@+id/topAddressPill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <!-- Luma Logo inside the pill -->
            <ImageView
                android:id="@+id/topBarLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/luma_logo"
                android:layout_marginEnd="10dp"/>

            <!-- URL or page title -->
            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:text="Новая вкладка"
                android:textColor="@color/luma_text_primary"
                android:textColorHint="@color/luma_text_muted"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:selectAllOnFocus="true"/>

            <!-- Reload / Stop Button -->
            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/selector_icon_button"
                android:src="@drawable/ic_reload"
                android:padding="4dp"
                android:contentDescription="Обновить"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Tab Count Badge Button -->
        <FrameLayout
            android:id="@+id/btnTabCount"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/selector_icon_button">
            <TextView
                android:id="@+id/tabCountText"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_surface_raised"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/luma_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Three dots Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/selector_icon_button"
            android:src="@drawable/ic_menu"
            android:padding="8dp"
            android:contentDescription="Меню"/>

    </LinearLayout>

    <!-- ===== HOME DASHBOARD (matching media_1790866441976.png exactly) ===== -->
    <ScrollView
        android:id="@+id/homeDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="56dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="90dp"
            android:paddingBottom="100dp">

            <!-- Luma Logo + Title Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/luma_logo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luma"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"/>

            </LinearLayout>

            <!-- Headline: "Куда отправимся?" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Куда отправимся?"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="26dp"/>

            <!-- Search Capsule -->
            <LinearLayout
                android:id="@+id/homeSearchShell"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_glass_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:elevation="6dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"/>

                <EditText
                    android:id="@+id/homeSearchBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@null"
                    android:hint="Поиск или адрес сайта"
                    android:textColor="@color/luma_text_primary"
                    android:textColorHint="@color/luma_text_muted"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"/>

                <!-- Circular Arrow Button -->
                <FrameLayout
                    android:id="@+id/homeSearchBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_surface_raised">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"/>
                </FrameLayout>

            </LinearLayout>

            <!-- Quick Action Pills Row: LumaAI, История, Настройки, Аккаунт -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <!-- ✦ LumaAI -->
                <LinearLayout
                    android:id="@+id/pillLumaAI"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_spark"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LumaAI"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <!-- 🕒 История -->
                <LinearLayout
                    android:id="@+id/pillHistory"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_history"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="История"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <!-- ⚙ Настройки -->
                <LinearLayout
                    android:id="@+id/pillSettings"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_gear"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11.5sp"/>
                </LinearLayout>

                <!-- 👤 Аккаунт -->
                <LinearLayout
                    android:id="@+id/pillAccount"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_user"
                        android:layout_marginEnd="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Аккаунт"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11.5sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== FLOATING "СПРОСИТЬ LUMAAI" GRADIENT BUTTON (from reference image) ===== -->
    <LinearLayout
        android:id="@+id/btnFloatingAi"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_luma_ai_button"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Спросить LumaAI"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>

</FrameLayout>
