<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Luma Mobile Browser (Safari-style Bottom Bar)
    Matches Screenshot 2 docked at the bottom with Luma logo pill, AI button, tab badge, and hamburger menu.
    Harmonious home screen with centered Luma brand and search box.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luma_bg">

    <!-- ===== WEBVIEW (Full Screen Content) ===== -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="62dp"
        android:visibility="gone"/>

    <!-- ===== PROGRESS BAR (Docked right above bottom bar) ===== -->
    <ProgressBar
        android:id="@+id/pageProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="62dp"
        android:progressTint="@color/luma_accent"
        android:progressBackgroundTint="@color/transparent"
        android:max="100"
        android:progress="0"
        android:visibility="invisible"/>

    <!-- ===== HOME DASHBOARD (Minimalist, harmonious) ===== -->
    <ScrollView
        android:id="@+id/homeDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="62dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="100dp"
            android:paddingBottom="40dp">

            <!-- Luma Logo + Title Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/luma_logo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luma"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

            <!-- Headline: "Куда отправимся?" -->
            <TextView
                android:id="@+id/homeHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Куда отправимся?"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="22dp"/>

            <!-- Center Search Capsule -->
            <LinearLayout
                android:id="@+id/homeSearchShell"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:elevation="4dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"/>

                <EditText
                    android:id="@+id/homeSearchBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@null"
                    android:hint="Поиск или адрес сайта"
                    android:textColor="@color/luma_text_primary"
                    android:textColorHint="@color/luma_text_muted"
                    android:textSize="13.5sp"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"/>

                <!-- Circular Arrow Button -->
                <FrameLayout
                    android:id="@+id/homeSearchBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_surface_raised">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"/>
                </FrameLayout>

            </LinearLayout>

            <!-- Quick Action Pills Row: История, Настройки, Закладки, Поддержка -->
            <LinearLayout
                android:id="@+id/homePillsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <!-- 🕒 История -->
                <LinearLayout
                    android:id="@+id/pillHistory"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_history"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="История"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- ⚙ Настройки -->
                <LinearLayout
                    android:id="@+id/pillSettings"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_gear"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- 🔖 Закладки -->
                <LinearLayout
                    android:id="@+id/pillBookmarks"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_bookmark"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Закладки"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- 💬 Поддержка -->
                <LinearLayout
                    android:id="@+id/pillSupport"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_support"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Поддержка"
                        android:textColor="@color/luma_text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== READER MODE OVERLAY ===== -->
    <LinearLayout
        android:id="@+id/readerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="62dp"
        android:background="#121316"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="10dp"
        android:paddingTop="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#0E0F12">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Режим чтения Luma"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnReaderClose"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="Закрыть"
                android:textColor="@color/luma_accent"
                android:textSize="12sp"
                android:background="@drawable/bg_surface_raised"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/readerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/readerByline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#716C82"
                    android:textSize="12sp"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:id="@+id/readerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D7D2DC"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ===== SAFARI-STYLE BOTTOM BAR (Matching Screenshot 2 exactly) ===== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:background="#FA0B0912"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="12dp">

        <!-- Search/Address Capsule (Screenshot 2: logo + "Новая вкладка") -->
        <LinearLayout
            android:id="@+id/bottomAddressPill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Luma Logo -->
            <ImageView
                android:id="@+id/bottomBarLogo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/luma_logo"
                android:layout_marginEnd="8dp"/>

            <!-- URL / Search text field -->
            <EditText
                android:id="@+id/bottomAddressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:text="Новая вкладка"
                android:textColor="#FFFFFF"
                android:textColorHint="#716C82"
                android:textSize="13.5sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:selectAllOnFocus="true"/>

            <!-- Reload / Stop button -->
            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@null"
                android:src="@drawable/ic_reload"
                android:padding="3dp"
                android:contentDescription="Обновить"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- LumaAI Button (Dedicated spark button on the bottom bar) -->
        <FrameLayout
            android:id="@+id/btnBottomAi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_surface_raised"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_spark"/>
        </FrameLayout>

        <!-- Tab Count Badge Button (Screenshot 2: dark circle badge) -->
        <FrameLayout
            android:id="@+id/btnTabCount"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@null"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tabCountText"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_badge"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Menu Button (Screenshot 2: hamburger menu icon) -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@null"
            android:src="@drawable/ic_menu"
            android:padding="7dp"
            android:contentDescription="Меню"/>

    </LinearLayout>

</FrameLayout>
