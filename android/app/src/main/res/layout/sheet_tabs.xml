<?xml version="1.0" encoding="utf-8"?>
<!-- Clean, fast Luma Tabs Bottom Sheet without spaces clutter -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0F12"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tabsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Вкладки"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnNewTab"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+ Новая"
            android:textColor="@color/luma_accent"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_surface_raised"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <FrameLayout
            android:id="@+id/btnTabsClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Tabs RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom Actions: Close All -->
    <Button
        android:id="@+id/btnCloseAll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_raised"
        android:text="Закрыть все вкладки"
        android:textColor="#E05252"
        android:textSize="13sp"
        android:textAllCaps="false"/>

</LinearLayout>
