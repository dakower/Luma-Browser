<?xml version="1.0" encoding="utf-8"?>
<!-- Luma Tabs Bottom Sheet with Spaces and Incognito -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0F12"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tabsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Вкладки"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnNewTab"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+ Новая"
            android:textColor="@color/luma_accent"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_surface_raised"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <FrameLayout
            android:id="@+id/btnTabsClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_raised">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"/>
        </FrameLayout>
    </LinearLayout>

    <!-- SPACES BAR (Основное | Работа | Учёба | Медиа) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/spacesContainer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spaceBtnMain"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✦ Основное"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_surface_raised"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/spaceBtnWork"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="💼 Работа"
                android:textColor="#716C82"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_glass_card"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/spaceBtnStudy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📚 Учёба"
                android:textColor="#716C82"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_glass_card"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/spaceBtnMedia"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🎵 Медиа"
                android:textColor="#716C82"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_glass_card"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Tabs RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom Actions: Close All -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnCloseAll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_surface_raised"
            android:text="Закрыть все вкладки"
            android:textColor="#E05252"
            android:textSize="13sp"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
