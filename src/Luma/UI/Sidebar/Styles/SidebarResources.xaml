    <!-- ========================================================================= -->
    <!-- 1. COLOR PALETTE & BRUSHES (Zen / Arc inspired Dark Mode)                -->
    <!-- ========================================================================= -->
    <Color x:Key="SidebarBgColor">#3D3D42</Color>
    <Color x:Key="SidebarDrawerBgColor">#3D3D42</Color>
    <Color x:Key="SidebarItemHoverColor">#4B4B50</Color>
    <Color x:Key="SidebarItemActiveColor">#56565A</Color>
    <Color x:Key="TextPrimaryColor">#F2F2F5</Color>
    <Color x:Key="TextSecondaryColor">#C8C8CE</Color>
    <Color x:Key="TextDimmedColor">#9A9AA0</Color>
    <Color x:Key="AccentIndicatorColor">#0A84FF</Color>
    <Color x:Key="SeparatorColor">#4B4B50</Color>

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarDrawerBackgroundBrush" Color="{StaticResource SidebarDrawerBgColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDimmedBrush" Color="{StaticResource TextDimmedColor}"/>
    <SolidColorBrush x:Key="AccentIndicatorBrush" Color="{StaticResource AccentIndicatorColor}"/>
    <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="{StaticResource SeparatorColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#4B4B50"/>
    <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="#56565A"/>

