    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->
            <Style x:Key="WhiteboardNavButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="66"/>
        <Setter Property="Width" Value="86"/>
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.85" Duration="0:0:0.06"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentStack"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveHighlight"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Подложка цвета #2D2D2D с CornerRadius=8 для наведения и активации -->
                        <Border x:Name="ActiveHighlight"
                                CornerRadius="8"
                                Background="#2D2D2D"
                                Opacity="0"/>

                        <!-- Внутри кнопки: вертикальный StackPanel (Иконка 24x24 + Текст 10px) -->
                        <StackPanel x:Name="ContentStack" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Сверху: Векторная иконка школьной доски (24x24, Fill=White, реалистичная геометрия) -->
                            <Path x:Name="BoardIcon"
                                  Data="M 2,4 C 2,2.9 2.9,2 4,2 L 20,2 C 21.1,2 22,2.9 22,4 L 22,16 C 22,17.1 21.1,18 20,18 L 16,18 L 17.5,21.5 L 15.5,22.2 L 13.7,18 L 10.3,18 L 8.5,22.2 L 6.5,21.5 L 8,18 L 4,18 C 2.9,18 2,17.1 2,16 Z M 4,4 L 4,16 L 20,16 L 20,4 Z M 13,16.5 L 17,16.5 C 17.3,16.5 17.5,16.7 17.5,17 C 17.5,17.3 17.3,17.5 17,17.5 L 13,17.5 C 12.7,17.5 12.5,17.3 12.5,17 C 12.5,16.7 12.7,16.5 13,16.5 Z"
                                  Width="24" Height="24"
                                  Stretch="Uniform"
                                  Fill="White"
                                  HorizontalAlignment="Center"/>

                            <!-- Снизу: TextBlock с текстом "Доска" (FontSize 10, выравнивание по центру, Margin сверху 4) -->
                            <TextBlock x:Name="BoardText"
                                       Text="Доска"
                                       FontSize="10"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Прямые триггеры WPF для 100% надежности -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActiveHighlight" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ActiveHighlight" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
