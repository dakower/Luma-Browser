        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <!-- Bottom Utility Icon Button (Folder, Gear, User, Extensions) -->
    <Style x:Key="UtilityIconButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <!-- Close Tab Small Cross Button -->
    <Style x:Key="CloseTabButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}">
                        <Path Data="{StaticResource IconClose}"
                              Width="9" Height="9"
                              Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Zen_56565A}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <!-- ========================================================================= -->
    <!-- 5. VERTICAL TAB LISTBOX ITEM TEMPLATE (Screenshot 1)                     -->
    <!-- ========================================================================= -->
    <Style x:Key="VerticalTabListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="TabBody"
                            CornerRadius="7"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <Grid Margin="0,0,6,0">
                            <Grid.ColumnDefinitions>
                                <!-- Col 0: Active Left Accent Strip -->
                                <ColumnDefinition Width="6"/>
                                <!-- Col 1: Favicon -->
                                <ColumnDefinition Width="28"/>
                                <!-- Col 2: Title -->
                                <ColumnDefinition Width="*"/>
                                <!-- Col 3: Close Button -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vertical Active Accent Strip Indicator -->
                            <Border x:Name="ActiveIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    CornerRadius="1.5"
                                    Background="{StaticResource AccentIndicatorBrush}"
                                    Visibility="Collapsed"/>

                            <!-- Favicon or Fallback Icon -->
                            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding Favicon}"
                                       Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Favicon, Converter={x:Null}}"/>
                                <Path x:Name="FallbackIcon"
                                      Data="{StaticResource IconGlobe}"
                                      Width="14" Height="14"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Tab Title Text -->
                            <TextBlock x:Name="TabTitleText"
                                       Grid.Column="2"
                                       Text="{Binding Title}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="2,0,6,0"/>

                            <!-- Close Button (Visible on Hover/Selected) -->
                            <Button x:Name="TabCloseBtn"
                                    Grid.Column="3"
                                    Style="{StaticResource CloseTabButtonStyle}"
                                    Command="{Binding CloseCommand}"
                                    CommandParameter="{Binding}"
                                    Opacity="0"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBody" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                            <Setter TargetName="TabTitleText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="FallbackIcon" Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="TabCloseBtn" Property="Opacity" Value="1"/>
                        </Trigger>

                        <!-- Selected / Active State -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBody" Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                            <Setter TargetName="TabTitleText" Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="FallbackIcon" Property="Stroke" Value="#FFFFFF"/>
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TabCloseBtn" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <Style x:Key="DrawerNavRailButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="74"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RailBorder" CornerRadius="10" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Background" Value="Transparent"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RailBorder" Property="Background" Value="{DynamicResource Zen_4B4B50}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RailBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <!-- ========================================================================= -->
    <!-- 6. DRAWER MINI RAIL NAVIGATION BUTTON (Screenshot 3 left column)         -->
    <!-- ========================================================================= -->
    <Style x:Key="DrawerNavRailItemStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Margin" Value="2,2"/>
        <Setter Property="GroupName" Value="DrawerNavGroup"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RailBorder"
                            CornerRadius="7"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Left Active Accent Strip -->
                            <Border x:Name="RailActiveIndicator"
                                    Width="3"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    CornerRadius="1.5"
                                    Background="{StaticResource AccentIndicatorBrush}"
                                    Visibility="Collapsed"/>

                            <!-- Icon + Label Stack -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="NavIcon"
                                      Data="{Binding IconGeometry}"
                                      Width="18" Height="18"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock x:Name="NavTitle"
                                           Text="{Binding Title}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RailBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                            <Setter TargetName="NavIcon" Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="NavTitle" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RailBorder" Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                            <Setter TargetName="RailActiveIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="NavIcon" Property="Stroke" Value="#FFFFFF"/>
                            <Setter TargetName="NavTitle" Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="NavTitle" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <!-- ========================================================================= -->
    <!-- 7. HISTORY LISTBOX ITEM TEMPLATE (Screenshot 3 right column)             -->
    <!-- ========================================================================= -->
    <Style x:Key="HistoryItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            CornerRadius="7"
                            Background="Transparent"
                            Padding="8,5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Resource Icon / Favicon -->
                            <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="HistoryIcon"
                                      Data="{StaticResource IconGlobe}"
                                      Width="14" Height="14"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5"/>
                            </Grid>

                            <!-- Title (Light White) + URL (Muted Secondary) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleBlock"
                                           Text="{Binding Title}"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UrlBlock"
                                           Text="{Binding Url}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                            <Setter TargetName="TitleBlock" Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="HistoryIcon" Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                            <Setter TargetName="TitleBlock" Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <Style x:Key="ModernMenuRowButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBorder" CornerRadius="6" Background="{TemplateBinding Background}" Padding="8,0" Margin="0,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <!-- ========================================================================= -->
    <!-- 8. CONTEXT MENU & MENU ITEMS (Screenshot 2: Browser Dropdown Menu)        -->
    <!-- ========================================================================= -->
    <Style x:Key="ModernContextMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect" Value="{StaticResource ModernMenuShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border CornerRadius="8"
                            Background="#1C1C1E"
                            BorderBrush="{DynamicResource Zen_2C2C2E}"
                            BorderThickness="1"
                            Padding="5,6">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="ItemBorder"
                            CornerRadius="6"
                            Background="Transparent"
                            Padding="8,0"
                            Margin="0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon -->
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <!-- Center Header Text -->
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Header}"
                                       FontSize="12"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,16,0"/>

                            <!-- Right Shortcut Hint -->
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- БЛОК 1: КНОПКА "ДОСКА" ДЛЯ БОКОВОЙ ПАНЕЛИ НАВИГАЦИИ                        -->
    <!-- ========================================================================= -->

    <Style x:Key="ModernMenuSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1" Fill="{DynamicResource Zen_2C2C2E}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


