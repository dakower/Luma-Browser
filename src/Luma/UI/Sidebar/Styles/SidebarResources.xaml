    <!-- Zen Layout Metrics (1:1 from zen-sidebar.css & zen-tabs.css) -->
    <CornerRadius x:Key="ZenBorderRadius">8</CornerRadius>
    <CornerRadius x:Key="ZenTabBorderRadius">7</CornerRadius>
    <CornerRadius x:Key="ZenEssentialBorderRadius">8</CornerRadius>
    <CornerRadius x:Key="ZenFloatingSidebarRadius">10</CornerRadius>
    <Thickness x:Key="ZenToolboxPadding">8,8,8,8</Thickness>
    <Thickness x:Key="ZenTabItemMargin">0,1,0,1</Thickness>
    <Thickness x:Key="ZenTabItemPadding">6,0,6,0</Thickness>

    <!-- Subtle DropShadow for Menus and Overlays -->
    <DropShadowEffect x:Key="ModernMenuShadow"
                      BlurRadius="20"
                      Direction="270"
                      ShadowDepth="6"
                      Opacity="0.45"
                      Color="#000000"/>

