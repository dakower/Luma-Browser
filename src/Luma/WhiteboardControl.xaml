<UserControl x:Class="Luma.WhiteboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Luma"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- ШРИФТЫ PROPYSY (Украинская школьная каллиграфия) -->
        <FontFamily x:Key="PropysyRegular">pack://application:,,,/Fonts/#Propysy Regular, pack://application:,,,/Fonts/#Propysy</FontFamily>
        <FontFamily x:Key="PropysyBold">pack://application:,,,/Fonts/#Propysy Bold, pack://application:,,,/Fonts/#Propysy</FontFamily>

        <!-- ЦВЕТОВАЯ ПАЛИТРА -->
        <SolidColorBrush x:Key="VseosvitaGreen" Color="#4F46E5"/>
        <SolidColorBrush x:Key="VseosvitaGreenHover" Color="#4338CA"/>
        <SolidColorBrush x:Key="ToolbarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBorder" Color="#E2E8F0"/>

        <!-- СТИЛЬ КНОПОК ПЛАВАЮЩЕЙ ПАНЕЛИ (ToggleButton) -->
        <Style x:Key="VseosvitaToolbarToggleBtn" TargetType="{x:Type ToggleButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ РАДИОКНОПОК ПЛАВАЮЩЕЙ ПАНЕЛИ СЛАЙД-ШОУ -->
        <Style x:Key="SlideshowToolbarRadioBtn" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ЦВЕТОВОГО ЧИПА СЛАЙД-ШОУ -->
        <Style x:Key="SlideshowColorChipBtn" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="#CBD5E1" BorderThickness="1.5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ДЕЙСТВИЙ ПЛАВАЮЩЕЙ ПАНЕЛИ (Button) -->
        <Style x:Key="VseosvitaToolbarActionBtn" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ДЛЯ КНОПОК ВЕРХНЕЙ ПАНЕЛИ ДЕЙСТВИЙ -->
        <Style x:Key="VseosvitaTopActionBtn" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- СТИЛЬ ДЛЯ КНОПКИ АВТОПРОПИСИ (АКТИВНЫЙ ПЕРЕКЛЮЧАТЕЛЬ) -->
        <Style x:Key="AutoConvertTopToggleBtn" TargetType="{x:Type ToggleButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4338CA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!-- СТИЛЬ ВЕРТИКАЛЬНОЙ ПАНЕЛИ СПРАВА (КВАДРАТНЫЕ КНОПКИ) -->
        <Style x:Key="RightDockBtnStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- РАЗДЕЛИТЕЛЬ -->
        <Style x:Key="ToolbarSeparatorStyle" TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Fill" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Корневая сетка WhiteboardControl (светлый школьный стол) -->
    <Grid x:Name="RootGrid"
          Background="#EDF2F7"
          ClipToBounds="True"
          Focusable="True"
          AllowDrop="True"
          Drop="MainCanvas_Drop"
          DragOver="MainCanvas_DragOver"
          PreviewKeyDown="RootGrid_PreviewKeyDown">

        <!-- ОСНОВНОЙ АРКУШ ДОШКИ С ТЕНЬЮ -->
        <Border x:Name="NotebookPageBorder"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                Background="#FFFFFF"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="3" Opacity="0.06"/>
            </Border.Effect>

            <Grid>
                <!-- Холст для рисования штрихов и элементов -->
                <InkCanvas x:Name="MainCanvas"
                           Background="White"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           PreviewMouseLeftButtonDown="MainCanvas_PreviewMouseLeftButtonDown"
                           PreviewMouseMove="MainCanvas_PreviewMouseMove"
                           PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp"
                           PreviewMouseWheel="HandleCanvasMouseWheel"/>

                <!-- Слой для предпросмотра геометрических фигур -->
                <Canvas x:Name="ShapePreviewCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"/>

                <!-- Слой для лазерной указки (след, луч) -->
                <Canvas x:Name="LaserCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"/>

                <!-- Червона лінія полів зошита (Ukrainian school notebook margin line) -->
                <Line x:Name="NotebookMarginLine"
                      X1="0" Y1="0" X2="0" Y2="5000"
                      Stroke="#EF4444"
                      StrokeThickness="1.5"
                      Opacity="0.55"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Left"
                      Margin="75,0,0,0"/>

                <!-- ШКОЛЬНЫЙ ЗАГОЛОВОК (ШАПКА АРКУША) -->
                <StackPanel x:Name="NotebookHeaderContainer"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,64,0,0"
                            Visibility="Collapsed"
                            IsHitTestVisible="True">
                    <TextBox x:Name="HeaderDateBox"
                             Text="27 жовтня"
                             FontFamily="{StaticResource PropysyRegular}"
                             FontSize="36"
                             Foreground="#1E293B"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             CaretBrush="#1E293B"
                             Cursor="IBeam"
                             LostFocus="HeaderBox_LostFocus"/>
                    <TextBox x:Name="HeaderWorkTypeBox"
                             Text="Класна робота"
                             FontFamily="{StaticResource PropysyRegular}"
                             FontSize="36"
                             Foreground="#1E293B"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Margin="0,-6,0,0"
                             CaretBrush="#1E293B"
                             Cursor="IBeam"
                             LostFocus="HeaderBox_LostFocus"/>
                </StackPanel>
            </Grid>
        </Border>

                <!-- ========================================================================= -->
        <!-- ========================================================================= -->
        <!-- ВБУДОВАНИЙ ПЕРЕГЛЯДАЧ ПРЕЗЕНТАЦІЇ НА ДОШЦІ (IN-BOARD PRESENTATION VIEWER) -->
        <!-- ========================================================================= -->
        <Grid x:Name="BoardPresentationOverlay"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              PreviewMouseWheel="BoardPresentationOverlay_PreviewMouseWheel">

            <!-- Парящий верхній контролер слайдів у фірмовому стилі Luma -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,58,0,0"
                    Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="6,4"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="22" ShadowDepth="3" Opacity="0.10"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Назва презентації -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="8,4" Margin="2,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 14,2 H 6 C 4.9,2 4,2.9 4,4 V 20 C 4,21.1 4.9,22 6,22 H 18 C 19.1,22 20,21.1 20,20 V 8 Z M 13,3.5 L 18.5,9 H 13 Z M 8,13 H 16 M 8,17 H 13"
                                  Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock x:Name="BoardPresentationTitleText" Text="Презентація" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>
                    </Border>

                    <!-- Стрілка назад [ ◀ ] -->
                    <Button x:Name="BoardSlidePrevBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="30" Height="28" Padding="0" Click="BoardSlidePrevBtn_Click" ToolTip="Попередній слайд (← / Коліщатко)">
                        <Path Data="M 15,18 L 9,12 L 15,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>

                    <!-- Лічильник слайдів -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="10,0" Height="28" Margin="3,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BoardSlideCounterText" Text="Слайд 1 з 1" Foreground="#0F172A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Стрілка вперед [ ▶ ] -->
                    <Button x:Name="BoardSlideNextBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="30" Height="28" Padding="0" Click="BoardSlideNextBtn_Click" ToolTip="Наступний слайд (→ / Коліщатко)">
                        <Path Data="M 9,18 L 15,12 L 9,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Кнопка: Сітка всіх слайдів (▦) -->
                    <Button x:Name="BoardSlidesGridBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="7,0" Click="SlidesGridBtn_Click" ToolTip="Огляд та вибір усіх слайдів">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z"
                                  Stroke="#475569" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Всі слайди" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Міні-таймер на слайді (⏱️) -->
                    <Button x:Name="BoardSlideTimerToggleBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0" Click="SlideTimerToggleBtn_Click" ToolTip="Таймер на слайді для виконання вправи">
                        <Path Data="M 12,22 A 9,9 0 1 0 12,4 A 9,9 0 0 0 12,22 Z M 12,6 V 12 L 16,14 M 9,1 H 15"
                              Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Кнопка: Повний екран (F5) -->
                    <Button x:Name="BoardSlideFullscreenBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="8,0" Click="BoardSlideFullscreenBtn_Click" ToolTip="Розгорнути на весь екран (F5)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,3 H 8 M 3,3 V 8 M 21,3 H 16 M 21,3 V 8 M 3,21 H 8 M 3,21 V 16 M 21,21 H 16 M 21,21 V 16"
                                  Stroke="#4F46E5" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="На весь екран (F5)" FontSize="11.5" FontWeight="SemiBold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Очистити помітки слайда -->
                    <Button x:Name="BoardSlideClearNotesBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0" Click="BoardSlideClearNotesBtn_Click" ToolTip="Очистити помітки поточного слайда">
                        <Path Data="M 3,6 H 21 M 8,6 V 4 A 1,1 0 0 1 9,3 H 15 A 1,1 0 0 1 16,4 V 6 M 19,6 V 19 A 2,2 0 0 1 17,21 H 7 A 2,2 0 0 1 5,19 V 6"
                              Stroke="#64748B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Кнопка: Закрити перегляд презентації -->
                    <Button x:Name="BoardSlideCloseBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0" Click="BoardSlideCloseBtn_Click" ToolTip="Закрити презентацію на цьому аркуші">
                        <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Центральна картка слайда (Aspect Ratio 100% збережено) -->
            <Grid Margin="40,110,40,75" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="BoardSlideCard"
                        CornerRadius="12"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="4" Opacity="0.14"/>
                    </Border.Effect>
                    <Viewbox x:Name="BoardSlideViewbox" Stretch="Uniform">
                        <Grid x:Name="BoardSlideContainer" Background="#FFFFFF">
                            <Image x:Name="BoardSlideImage" Stretch="Fill"/>
                            <InkCanvas x:Name="BoardSlideInkCanvas" Background="Transparent"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- Бокова ліва стрілка (плаваюча на слайді) -->
                <Button Style="{StaticResource VseosvitaTopActionBtn}"
                        Width="38" Height="38" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="-19,0,0,0" Background="#FFFFFF"
                        Click="BoardSlidePrevBtn_Click" ToolTip="Попередній слайд">
                    <Button.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/></Button.Effect>
                    <Path Data="M 15,18 L 9,12 L 15,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>

                <!-- Бокова права стрілка (плаваюча на слайді) -->
                <Button Style="{StaticResource VseosvitaTopActionBtn}"
                        Width="38" Height="38" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,-19,0" Background="#FFFFFF"
                        Click="BoardSlideNextBtn_Click" ToolTip="Наступний слайд">
                    <Button.Effect><DropShadowEffect Color="#0F172A" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/></Button.Effect>
                    <Path Data="M 9,18 L 15,12 L 9,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Grid>

        <!-- НОВА ЕРГОНОМІЧНА ВЕРХНЯ ПАНЕЛЬ (FLOATING TOP NAVIGATION HEADER)          -->
        <!-- ========================================================================= -->
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Margin="14,12,14,0"
              IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ЛІВИЙ ОСТРІВЕЦЬ: БРЕНД LUMA ДОШКА + ВКЛАДКИ АРКУШІВ + МЕНЕДЖЕР АРКУШІВ -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    Padding="6,4"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Бейдж Luma Доска (стильний сучасний нейтральний графіт) -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="10,5" Margin="2,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,4 H 21 V 17 H 3 Z M 8,21 H 16 M 12,17 V 21"
                                  Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Luma Дошка" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Вкладки відкритих листів -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  CanContentScroll="False"
                                  MaxWidth="280"
                                  HorizontalContentAlignment="Left">
                        <StackPanel x:Name="BoardsTabContainer" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Кнопка: Додати новий аркуш (+) -->
                    <Button x:Name="AddBoardBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28"
                            Padding="0"
                            Margin="4,0,2,0"
                            Click="AddBoardBtn_Click"
                            ToolTip="Добавить новый лист (+)">
                        <Path Data="M 12,4 V 20 M 4,12 H 20"
                              Stroke="#475569" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Менеджер аркушів (RightDockSheetsBtn) -->
                    <Button x:Name="RightDockSheetsBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28"
                            Padding="8,0"
                            Margin="2,0"
                            Click="RightDockSheetsBtn_Click"
                            ToolTip="Менеджер листов">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 16,3 H 4 A 2,2 0 0 0 2,5 V 17 A 2,2 0 0 0 4,19 H 16 A 2,2 0 0 0 18,17 V 5 A 2,2 0 0 0 16,3 Z M 22,7 V 21 A 2,2 0 0 1 20,23 H 8"
                                  Stroke="#475569" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Листы" FontSize="11.5" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ЦЕНТРАЛЬНИЙ ДИНАМІЧНИЙ ТОАСТ: СПОВІЩЕННЯ ШІ / СТАТУС РОЗПІЗНАВАННЯ -->
            <Border x:Name="AiStatusToast"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,6,18,6"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="2" Opacity="0.16"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#166534" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse x:Name="AiStatusDot" Width="6" Height="6" Fill="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AiStatusText"
                               Text="Оцифрування в пропис..."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ПРАВИЙ ОСТРІВЕЦЬ ДІЙ: ВІДМІНА + В ПРОПИС + РОЗМІТКА + ОЧИСТИТИ + ДОВІДКА -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    Padding="6,4"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="14" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Скасувати (Undo, ↶) -->
                    <Button x:Name="UndoBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="30" Height="28" Padding="0"
                            Click="UndoBtn_Click"
                            ToolTip="Скасувати останню дію (Ctrl+Z)">
                        <Path Data="M 9,14 L 4,9 L 9,4 M 4,9 H 15 A 6,6 0 0 1 21,15 A 6,6 0 0 1 15,21 H 11"
                              Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Повторити (Redo, ↷) -->
                    <Button x:Name="RedoBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="30" Height="28" Padding="0"
                            Click="RedoBtn_Click"
                            ToolTip="Повторити скасовану дію (Ctrl+Y)">
                        <Path Data="M 15,14 L 20,9 L 15,4 M 20,9 H 9 A 6,6 0 0 0 3,15 A 6,6 0 0 0 9,21 H 13"
                              Stroke="#475569" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- ГОЛОВНА ДІЯ: ШІ перетворення у пропис (Enter) -->
                    <ToggleButton x:Name="RightDockAiConvertBtn"
                                  Style="{StaticResource AutoConvertTopToggleBtn}"
                                  Height="28"
                                  Padding="9,0"
                                  Margin="2,0"
                                  Cursor="Hand"
                                  Click="RightDockAiConvertBtn_Click"
                                  ToolTip="Автопропис: ВИМК. Натисніть, щоб увімкнути автоматичне перетворення рукописного тексту у пропис">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Элегантная иконка пера (меняет цвет на белый при активации) -->
                            <Path x:Name="RightDockAiConvertIcon"
                                  Data="M 17,3 C 18,2 20,4 19,5 L 10,14 L 6,15 L 7,11 L 16,2 Z M 6,15 L 4,19 L 8,17 Z M 14,5 L 18,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RightDockAiConvertLabel"
                                       Text="У пропис"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Імпорт PDF презентації (📊) -->
                    <Button x:Name="ImportPdfPresentationBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="6,0"
                            Click="ImportPdfPresentationBtn_Click"
                            ToolTip="Імпорт презентації або сторінок підручника (PDF)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 14,2 H 6 C 4.9,2 4,2.9 4,4 V 20 C 4,21.1 4.9,22 6,22 H 18 C 19.1,22 20,21.1 20,20 V 8 Z M 13,3.5 L 18.5,9 H 13 Z M 8,13 H 16 M 8,17 H 13"
                                  Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="PDF" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Шкільна шторка для приховування відповідей (👁️) -->
                    <Button x:Name="CurtainToolBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="6,0"
                            Click="CurtainToolBtn_Click"
                            ToolTip="Шкільна шторка (приховування відповідей та рішень)">
                        <Path Data="M 3,4 H 21 M 3,9 H 21 M 3,14 H 21 M 3,19 H 21 M 4,4 V 20 M 20,4 V 20"
                              Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Таймер уроку (⏱️) -->
                    <Button x:Name="LessonTimerToolBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="6,0"
                            Click="LessonTimerToolBtn_Click"
                            ToolTip="Таймер уроку та самостійної роботи">
                        <Path Data="M 12,22 A 9,9 0 1 0 12,4 A 9,9 0 0 0 12,22 Z M 12,6 V 12 L 16,14 M 9,1 H 15"
                              Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>


                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Розмітка та тема аркуша (⚙️) -->
                    <Button x:Name="SheetSettingsBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="6,0"
                            Click="SheetSettingsBtn_Click"
                            ToolTip="Параметри аркуша (лінійка, клітинка, колір, поля, шапка)">
                        <Path Data="M 12,15 A 3,3 0 1 0 12,9 A 3,3 0 0 0 12,15 Z M 19.4,15 A 1.65,1.65 0 0 0 19.73,16.82 L 20,17.15 A 2,2 0 1 1 17.15,20 L 16.82,19.73 A 1.65,1.65 0 0 0 15,19.4 A 1.65,1.65 0 0 0 13.5,20.87 V 21.5 A 2,2 0 1 1 9.5,21.5 V 20.87 A 1.65,1.65 0 0 0 8,19.4 A 1.65,1.65 0 0 0 6.18,19.73 L 5.85,20 A 2,2 0 1 1 3,17.15 L 3.27,16.82 A 1.65,1.65 0 0 0 3.6,15 A 1.65,1.65 0 0 0 2.13,13.5 H 1.5 A 2,2 0 1 1 1.5,9.5 H 2.13 A 1.65,1.65 0 0 0 3.6,8 A 1.65,1.65 0 0 0 3.27,6.18 L 3,5.85 A 2,2 0 1 1 5.85,3 L 6.18,3.27 A 1.65,1.65 0 0 0 8,3.6 A 1.65,1.65 0 0 0 9.5,2.13 V 1.5 A 2,2 0 1 1 13.5,1.5 V 2.13 A 1.65,1.65 0 0 0 15,3.6 A 1.65,1.65 0 0 0 16.82,3.27 L 17.15,3 A 2,2 0 1 1 20,5.85 L 19.73,6.18 A 1.65,1.65 0 0 0 19.4,8 A 1.65,1.65 0 0 0 20.87,9.5 H 21.5 A 2,2 0 1 1 21.5,13.5 H 20.87 A 1.65,1.65 0 0 0 19.4,15 Z"
                              Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Очистити аркуш (🗑️) -->
                    <Button x:Name="ClearBoardBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="28" Padding="6,0"
                            Click="ClearBoardBtn_Click"
                            ToolTip="Очистити аркуш">
                        <Path Data="M 3,6 H 5 H 21 M 19,6 V 20 A 2,2 0 0 1 17,22 H 7 A 2,2 0 0 1 5,20 V 6 M 8,6 V 4 A 2,2 0 0 1 10,2 H 14 A 2,2 0 0 1 16,4 V 6"
                              Stroke="#EF4444" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Довідка та гарячі клавіші (❓) -->
                    <Button x:Name="RightDockHelpBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0"
                            Click="RightDockHelpBtn_Click"
                            ToolTip="Довідка та гарячі клавіші">
                        <Path Data="M 9.09,9 A 3,3 0 0 1 15,10 C 15,12 12,13 12,15 M 12,19 H 12.01 M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z"
                              Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Копіювати як зображення -->
                    <Button x:Name="CopyImageTopBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0"
                            Click="CopyImageTopBtn_Click"
                            ToolTip="Копіювати як зображення (Ctrl+C)">
                        <Path Data="M 16,4 H 4 A 2,2 0 0 0 2,6 V 18 A 2,2 0 0 0 4,20 H 16 A 2,2 0 0 0 18,18 V 6 A 2,2 0 0 0 16,4 Z M 8.5,10 A 1.5,1.5 0 1 1 8.5,7 A 1.5,1.5 0 0 1 8.5,10 Z M 4,17 L 8,12 L 11,15 L 14,10 L 16,17 Z"
                              Stroke="#475569" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <!-- Завантажити (PNG / PDF) -->
                    <Grid>
                        <Button x:Name="DownloadBtn"
                                Style="{StaticResource VseosvitaTopActionBtn}"
                                Width="28" Height="28" Padding="0"
                                Click="DownloadBtn_Click"
                                ToolTip="Завантажити (PNG / PDF)">
                            <Path Data="M 21,15 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 15 M 7,10 L 12,15 L 17,10 M 12,15 V 3"
                                  Stroke="#475569" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Popup x:Name="DownloadMenuPopup" PlacementTarget="{Binding ElementName=DownloadBtn}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6" Width="200" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="DownloadPngItem_Click" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 4,4 H 20 V 20 H 4 Z" Stroke="#2563EB" StrokeThickness="1.6" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Зберегти як PNG (якість 1:1)" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="DownloadPdfItem_Click" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 14,2 H 6 A 2,2 0 0 0 4,4 V 20 A 2,2 0 0 0 6,22 H 18 A 2,2 0 0 0 20,20 V 8 Z" Stroke="#DC2626" StrokeThickness="1.6" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Розумний друк / PDF" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Меню ⋮ -->
                    <Grid>
                        <Button x:Name="MoreActionsBtn"
                                Style="{StaticResource VseosvitaTopActionBtn}"
                                Width="28" Height="28" Padding="0"
                                Click="MoreActionsBtn_Click"
                                ToolTip="Меню додаткових дій (⋮)">
                            <Path Data="M 12,6 A 1.5,1.5 0 1 0 12,3 A 1.5,1.5 0 0 0 12,6 Z M 12,13.5 A 1.5,1.5 0 1 0 12,10.5 A 1.5,1.5 0 0 0 12,13.5 Z M 12,21 A 1.5,1.5 0 1 0 12,18 A 1.5,1.5 0 0 0 12,21 Z"
                                  Fill="#475569" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <Popup x:Name="MoreActionsPopup" PlacementTarget="{Binding ElementName=MoreActionsBtn}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6" Width="230" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.14"/></Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuHelpItem_Click" Margin="0,2">
                                        <TextBlock Text="❓ Довідка (Інфо-центр)" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuNewBoardItem_Click" Margin="0,2">
                                        <TextBlock Text="✨ Нова дошка (Шаблони)" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuDuplicateBoardItem_Click" Margin="0,2">
                                        <TextBlock Text="📋 Зробити копію аркуша" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuSettingsItem_Click" Margin="0,2">
                                        <TextBlock Text="⚙️ Налаштування та опис" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuEmbedItem_Click" Margin="0,2">
                                        <TextBlock Text="🌐 Вбудувати собі на сайт" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuPrintItem_Click" Margin="0,2">
                                        <TextBlock Text="🖨️ Розумний друк (Smart Print)" FontSize="11.5"/>
                                    </Button>
                                    <Separator Background="#E2E8F0" Margin="4,4"/>
                                    <TextBlock Text="Тема дошки:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="6,2"/>
                                    <UniformGrid Rows="1" Columns="3" Margin="0,2">
                                        <Button Content="Авто" Style="{StaticResource VseosvitaTopActionBtn}" Click="MenuThemeAuto_Click" FontSize="10.5"/>
                                        <Button Content="Світла" Style="{StaticResource VseosvitaTopActionBtn}" Click="MenuThemeLight_Click" FontSize="10.5"/>
                                        <Button Content="Темна" Style="{StaticResource VseosvitaTopActionBtn}" Click="MenuThemeDark_Click" FontSize="10.5"/>
                                    </UniformGrid>
                                    <Separator Background="#E2E8F0" Margin="4,4"/>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MenuDiscussionItem_Click" Margin="0,2">
                                        <TextBlock Text="💬 Обговорення та нотатки" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Повний екран (F11) -->
                    <Button x:Name="FullscreenBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0"
                            Click="ToggleFullscreenBtn_Click"
                            ToolTip="Повноекранний режим (F11 або Esc)">
                        <Path Data="M 3,9 V 3 H 9 M 21,9 V 3 H 15 M 3,15 V 21 H 9 M 21,15 V 21 H 15"
                              Stroke="#475569" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <!-- Закрити дошку (✖) -->
                    <Button x:Name="CloseBoardBtn"
                            Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="28" Height="28" Padding="0"
                            Click="CloseBoardBtn_Click"
                            ToolTip="Закрити дошку">
                        <Path Data="M 18,6 L 6,18 M 6,6 L 18,18"
                              Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Приховані елементи для повної сумісності з C# кодом -->
                    <Border x:Name="RightVerticalDock" Visibility="Collapsed"/>
                    <Button x:Name="RightDockCollapseBtn" Visibility="Collapsed"/>
                    <Path x:Name="RightDockCollapseIcon" Visibility="Collapsed"/>
                    <Button x:Name="RightDockPinBtn" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ПЛАВАЮЩАЯ ПАНЕЛЬ ИНСТРУМЕНТОВ (BOTTOM FLOATING TOOLBAR)                  -->
        <!-- РЕЖИМ 1: CURSOR / DRAWING TOOLS (↖ АКТИВЕН)                              -->
        <!-- РЕЖИМ 2: TEXT FORMATTING TOOLS (I АКТИВЕН)                               -->
        <!-- ========================================================================= -->
        <Border x:Name="FloatingToolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="10,0,10,20"
                MaxWidth="1050"
                Background="#FFFFFF"
                CornerRadius="14"
                Padding="4,4"
                BorderBrush="{StaticResource ToolbarBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="22" ShadowDepth="4" Opacity="0.10"/>
            </Border.Effect>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly"
                          Focusable="False">
                <Grid>
                <!-- ================================================================= -->
                <!-- ПАНЕЛЬ 1: РЕЖИМ РИСОВАНИЯ И КУРСОРА (CursorToolsPanel)            -->
                <!-- ================================================================= -->
                <StackPanel x:Name="CursorToolsPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Visible">

                    <!-- 1. ТЕКСТ (I) -> ПЕРЕКЛЮЧАЕТ В РЕЖИМ ТЕКСТА -->
                    <ToggleButton x:Name="TextToolBtn"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  Click="TextToolBtn_Click"
                                  ToolTip="Текст (I) — введення та редагування тексту">
                        <Path Data="M 4,7 V 4 H 20 V 7 M 9,20 H 15 M 12,4 V 20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </ToggleButton>

                    <!-- 2. ВКАЗІВНИК (↖) -> КУРСОР / ВИДІЛЕННЯ -->
                    <ToggleButton x:Name="PointerBtn"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  IsChecked="True"
                                  Click="PointerBtn_Click"
                                  ToolTip="Вказівник (↖) — виділення та переміщення об'єктів">
                        <Path Data="M 3,3 L 10,21 L 13,14 L 20,11 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </ToggleButton>

                    <!-- 3. УКАЗКА / ЛАЗЕР -->
                    <ToggleButton x:Name="LaserBtn"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  Click="LaserBtn_Click"
                                  ToolTip="Указка — лазерний слід для привернення уваги учнів">
                        <Path Data="M 18,11 V 6 A 2,2 0 0 0 14,6 V 11 M 14,7.5 V 4 A 2,2 0 0 0 10,4 V 11.5 M 10,9 V 2 A 2,2 0 0 0 6,2 V 14.5 C 6,19 9.5,22 14,22 H 15 A 7,7 0 0 0 22,15 V 10 A 2,2 0 0 0 18,10 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- 4. ОЛІВЕЦЬ З ТОЧКОЮ ЦВЕТА -->
                    <Grid>
                        <ToggleButton x:Name="PencilBtn"
                                      Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                      Click="PencilBtn_Click"
                                      ToolTip="Олівець — натисніть для вибору кольору, товщини та типу лінії">
                            <Grid>
                                <Path Data="M 17,3 A 2.828,2.828 0 1 1 21,7 L 7.5,20.5 L 2,22 L 3.5,16.5 L 17,3 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="16" Height="16" Stretch="Uniform"/>
                                <Ellipse x:Name="PencilColorDot"
                                         Width="6" Height="6"
                                         Fill="#1E293B"
                                         Stroke="#FFFFFF"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,1,1"/>
                            </Grid>
                        </ToggleButton>

                        <!-- ПОПАП НАЛАШТУВАНЬ ОЛІВЦЯ (S/M/L/XL, ПАЛИТРА, 6 ТИПОВ ЛИНИИ, ТУМБЛЕРЫ) -->
                        <Popup x:Name="PencilSettingsPopup"
                               PlacementTarget="{Binding ElementName=PencilBtn}"
                               Placement="Top"
                               VerticalOffset="-12"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,12" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
                                <StackPanel Width="230">
                                    <!-- Товщина лінії: S, M, L, XL -->
                                    <TextBlock Text="Розмір лінії" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                                        <!-- S -->
                                        <Border x:Name="PencilSizeS" Background="#F1F5F9" CornerRadius="8" Height="32" Margin="2" Cursor="Hand" MouseLeftButtonDown="PencilSizeChoice_Click" Tag="2">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="4" Height="4" Fill="#334155" Margin="0,0,4,0"/>
                                                <TextBlock Text="S" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- M -->
                                        <Border x:Name="PencilSizeM" Background="#F1F5F9" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="8" Height="32" Margin="2" Cursor="Hand" MouseLeftButtonDown="PencilSizeChoice_Click" Tag="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#0F172A" Margin="0,0,4,0"/>
                                                <TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- L -->
                                        <Border x:Name="PencilSizeL" Background="#F1F5F9" CornerRadius="8" Height="32" Margin="2" Cursor="Hand" MouseLeftButtonDown="PencilSizeChoice_Click" Tag="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Fill="#334155" Margin="0,0,4,0"/>
                                                <TextBlock Text="L" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- XL -->
                                        <Border x:Name="PencilSizeXL" Background="#F1F5F9" CornerRadius="8" Height="32" Margin="2" Cursor="Hand" MouseLeftButtonDown="PencilSizeChoice_Click" Tag="14">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="12" Height="12" Fill="#334155" Margin="0,0,4,0"/>
                                                <TextBlock Text="XL" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Скрытый слайдер для совместимости -->
                                    <Slider x:Name="PencilSizeSlider" Minimum="1" Maximum="20" Value="4" Visibility="Collapsed" ValueChanged="PencilSizeSlider_ValueChanged"/>
                                    <TextBlock x:Name="PencilSizeLabel" Text="4 px" Visibility="Collapsed"/>

                                    <!-- Колір олівця -->
                                    <TextBlock Text="Колір" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#1E293B" ToolTip="Графіт"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1.5"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#2563EB" ToolTip="Синій"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#2563EB"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#0D9488" ToolTip="Бірюзовий"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#0D9488"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#16A34A" ToolTip="Зелений"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#16A34A"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#EAB308" ToolTip="Жовтий"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#EAB308"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#EA580C" ToolTip="Помаранчевий"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#EA580C"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#DC2626" ToolTip="Червоний"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#DC2626"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#9333EA" ToolTip="Фіолетовий"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#9333EA"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#EC4899" ToolTip="Рожевий"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#EC4899"/></ControlTemplate></Button.Template></Button>
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#FFFFFF" ToolTip="Білий"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5"/></ControlTemplate></Button.Template></Button>
                                        <!-- Кнопка + другого кольору -->
                                        <Button Width="24" Height="24" Margin="3" Cursor="Hand" Click="PencilCustomColor_Click" ToolTip="Інший колір">
                                            <Button.Template><ControlTemplate><Border CornerRadius="12" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"><Path Data="M 12,5 V 19 M 5,12 H 19" Stroke="#64748B" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                    </WrapPanel>

                                    <!-- 6 ТИПІВ ЛІНІЙ: СУЦІЛЬНА, ПОДВІЙНА, ХВИЛЯСТА, ПУНКТИРНА, ШТРИХПУНКТИР, КРАПКИ -->
                                    <TextBlock Text="Тип лінії" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <UniformGrid Rows="2" Columns="3" Margin="0,0,0,12">
                                        <!-- 1. Суцільна -->
                                        <Button x:Name="StrokeSolidBtn" Height="26" Margin="2" Cursor="Hand" Click="StrokePattern_Click" Tag="Solid" ToolTip="Суцільна (───)">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#F1F5F9" BorderBrush="#0F172A" BorderThickness="1.5"><Line X1="4" Y1="12" X2="60" Y2="12" Stroke="#1E293B" StrokeThickness="2.2" HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <!-- 2. Подвійна -->
                                        <Button x:Name="StrokeDoubleBtn" Height="26" Margin="2" Cursor="Hand" Click="StrokePattern_Click" Tag="Double" ToolTip="Подвійна (═══)">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel VerticalAlignment="Center"><Line X1="4" Y1="0" X2="60" Y2="0" Stroke="#1E293B" StrokeThickness="1.4" HorizontalAlignment="Center"/><Line X1="4" Y1="3" X2="60" Y2="3" Stroke="#1E293B" StrokeThickness="1.4" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <!-- 3. Хвиляста -->
                                        <Button x:Name="StrokeWavyBtn" Height="26" Margin="2" Cursor="Hand" Click="StrokePattern_Click" Tag="Wavy" ToolTip="Хвиляста (~~~)">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><Path Data="M 0,13 Q 5,8 10,13 T 20,13 T 30,13 T 40,13 T 50,13" Stroke="#1E293B" StrokeThickness="1.8" HorizontalAlignment="Center" Stretch="Uniform" Width="50" Height="8"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <!-- 4. Пунктирна -->
                                        <Button x:Name="StrokeDashedBtn" Height="26" Margin="2" Cursor="Hand" Click="StrokePattern_Click" Tag="Dashed" ToolTip="Пунктирна (╌╌╌)">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><Line X1="4" Y1="12" X2="60" Y2="12" Stroke="#1E293B" StrokeThickness="2.2" StrokeDashArray="3,2" HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <!-- 5. Штрихпунктир -->
                                        <Button x:Name="StrokeDashDotBtn" Height="26" Margin="2" Cursor="Hand" Click="StrokePattern_Click" Tag="DashDot" ToolTip="Штрихпунктир (─•─•─)">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><Line X1="4" Y1="12" X2="60" Y2="12" Stroke="#1E293B" StrokeThickness="2.2" StrokeDashArray="4,2,1,2" HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <!-- 6. Крапки -->
                                        <Button x:Name="StrokeDottedBtn" Height="26" Margin="2" Cursor="Hand" Click="StrokePattern_Click" Tag="Dotted" ToolTip="Крапки (•••••)">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"><Line X1="4" Y1="12" X2="60" Y2="12" Stroke="#1E293B" StrokeThickness="2.2" StrokeDashArray="1,2" StrokeDashCap="Round" HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                    </UniformGrid>

                                    <!-- ТОГГЛЫ НАЛАШТУВАНЬ -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="PenShapeRecognitionCheck" Content="Розпізнавати фігури" FontSize="11" Foreground="#334155" IsChecked="True" Margin="0,0,0,6" Cursor="Hand" ToolTip="Затримка олівця в кінці штриха перетворює лінію на ідеальну фігуру"/>
                                            <CheckBox x:Name="PenSmoothingCheck" Content="Згладжувати лінію" FontSize="11" Foreground="#334155" IsChecked="True" Cursor="Hand" ToolTip="Автоматичне згладжування ліній для акуратного письма"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 5. МАРКЕР -->
                    <Grid>
                        <ToggleButton x:Name="HighlighterBtn"
                                      Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                      Click="HighlighterBtn_Click"
                                      ToolTip="Маркер — виділення напівпрозорим кольором">
                            <Path Data="M 9,11 L 12,14 M 4.5,15.5 L 2,22 L 8.5,19.5 L 19,9 A 2.828,2.828 0 0 0 15,5 L 4.5,15.5 Z"
                                  Stroke="#EAB308" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </ToggleButton>
                        <Popup x:Name="HighlighterPopup" PlacementTarget="{Binding ElementName=HighlighterBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="HighlighterColor_Click" Tag="#FFFFEB3B" ToolTip="Жовтий маркер"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#FFFFEB3B"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="HighlighterColor_Click" Tag="#FF4ADE80" ToolTip="Зелений маркер"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#FF4ADE80"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="HighlighterColor_Click" Tag="#FF38BDF8" ToolTip="Блакитний маркер"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#FF38BDF8"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="HighlighterColor_Click" Tag="#FFF472B6" ToolTip="Рожевий маркер"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#FFF472B6"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="HighlighterColor_Click" Tag="#FFFB923C" ToolTip="Помаранчевий маркер"><Button.Template><ControlTemplate><Border CornerRadius="12" Background="#FFFB923C"/></ControlTemplate></Button.Template></Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 6. ГУМКА -->
                    <ToggleButton x:Name="EraserBtn"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  Click="EraserBtn_Click"
                                  ToolTip="Гумка — стирання ліній (клік для перемикання режиму штрих/піксель)">
                        <Grid>
                            <Path Data="M 7,21 L 20.7,7.3 A 2.4,2.4 0 0 0 20.7,3.9 L 18.1,1.3 A 2.4,2.4 0 0 0 14.7,1.3 L 1,15 L 7,21 Z M 16,5 L 19,8 M 2,21 H 22"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                            <Border x:Name="EraserModeBadge" CornerRadius="3" Background="#0F172A" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                <TextBlock x:Name="EraserModeText" Text="S" FontSize="7" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- 7. ЛІНІЇ ТА СТРІЛКИ (↗) -->
                    <Grid>
                        <Button x:Name="LinesArrowsBtn"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Click="LinesArrowsBtn_Click"
                                ToolTip="Лінії та стрілки (↗)">
                            <Path Data="M 7,17 L 17,7 M 7,7 H 17 V 17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Popup x:Name="LinesArrowsPopup" PlacementTarget="{Binding ElementName=LinesArrowsBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Line" ToolTip="Відрізок">
                                        <Path Data="M 4,18 L 18,4" Stroke="#334155" StrokeThickness="2" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Arrow" ToolTip="Стрілка">
                                        <Path Data="M 5,17 L 17,7 M 9,7 H 17 V 15" Stroke="#334155" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="DoubleArrow" ToolTip="Двостороння стрілка">
                                        <Path Data="M 4,12 H 20 M 7,9 L 4,12 L 7,15 M 17,9 L 20,12 L 17,15" Stroke="#334155" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Ray" ToolTip="Промінь">
                                        <Path Data="M 4,16 A 2,2 0 1 0 4,16.01 M 5,15 L 18,6 M 12,6 H 18 V 12" Stroke="#334155" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 8. ФІГУРИ ( МЕГА-ПОПАП З КАТЕГОРІЯМИ ТА ТУМБЛЕРАМИ) -->
                    <Grid>
                        <ToggleButton x:Name="ShapesBtn"
                                      Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                      Click="ShapesBtn_Click"
                                      ToolTip="Геометричні фігури, дужки та графіки">
                            <Path Data="M 8.5,14.5 L 10,16 M 12,11 L 13.5,12.5 M 15.5,7.5 L 17,9 M 21.2,19.8 L 3.4,2 A 2,2 0 0 0 0.6,4.8 L 18.4,22.6 A 2,2 0 0 0 21.2,19.8 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </ToggleButton>

                        <!-- MEGA SHAPES POPUP С 6 СЕКЦИЯМИ И 4 ТУМБЛЕРАМИ -->
                        <Popup x:Name="ShapesPopup"
                               PlacementTarget="{Binding ElementName=ShapesBtn}"
                               Placement="Top"
                               VerticalOffset="-12"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Width="520" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="22" ShadowDepth="4" Opacity="0.14"/></Border.Effect>
                                <StackPanel>
                                    <!-- Верхняя вкладка категорий -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="CatBtnAll" Content="Найпростіші" Style="{StaticResource VseosvitaTopActionBtn}" Click="ShapesCategoryTab_Click" Tag="Simplest" FontWeight="Bold" Foreground="#0F172A"/>
                                            <Button Content="Планіметрія" Style="{StaticResource VseosvitaTopActionBtn}" Click="ShapesCategoryTab_Click" Tag="Planimetry"/>
                                            <Button Content="Дужки" Style="{StaticResource VseosvitaTopActionBtn}" Click="ShapesCategoryTab_Click" Tag="Brackets"/>
                                            <Button Content="Графіки" Style="{StaticResource VseosvitaTopActionBtn}" Click="ShapesCategoryTab_Click" Tag="Graphs"/>
                                            <Button Content="Побудови" Style="{StaticResource VseosvitaTopActionBtn}" Click="ShapesCategoryTab_Click" Tag="Constructions"/>
                                            <Button Content="3D Тіла" Style="{StaticResource VseosvitaTopActionBtn}" Click="ShapesCategoryTab_Click" Tag="Stereometry"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Сетка фигурок -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="190" Margin="0,0,0,10">
                                        <WrapPanel x:Name="ShapesGridContainer">
                                            <!-- Точка -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Point" ToolTip="Точка"><Ellipse Width="6" Height="6" Fill="#334155"/></Button>
                                            <!-- Відрізок -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Line" ToolTip="Відрізок"><Path Data="M 3,17 L 17,3" Stroke="#334155" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Промінь -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Ray" ToolTip="Промінь"><Path Data="M 3,17 L 17,5 M 10,5 H 17 V 12" Stroke="#334155" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Пряма -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="InfiniteLine" ToolTip="Пряма"><Path Data="M 2,18 L 18,2 M 2,13 L 2,18 L 7,18 M 18,7 L 18,2 L 13,2" Stroke="#334155" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Дуга -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Arc" ToolTip="Дуга"><Path Data="M 3,16 A 14,14 0 0 1 17,4" Stroke="#334155" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Кут -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Angle" ToolTip="Кут"><Path Data="M 18,5 L 3,17 L 19,17 M 9,17 A 6,6 0 0 0 7,13" Stroke="#334155" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Прямокутник -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Rectangle" ToolTip="Прямокутник"><Rectangle Width="16" Height="12" Stroke="#334155" StrokeThickness="1.8"/></Button>
                                            <!-- Коло -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Ellipse" ToolTip="Коло / Овал"><Ellipse Width="15" Height="15" Stroke="#334155" StrokeThickness="1.8"/></Button>
                                            <!-- Трикутник -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Triangle" ToolTip="Рівнобедрений трикутник"><Path Data="M 10,2 L 18,17 L 2,17 Z" Stroke="#334155" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Прямокутний трикутник -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="RightTriangle" ToolTip="Прямокутний трикутник"><Path Data="M 2,2 L 2,18 L 18,18 Z M 2,13 H 6 V 18" Stroke="#334155" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Ромб -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Rhombus" ToolTip="Ромб"><Path Data="M 9,2 L 16,10 L 9,18 L 2,10 Z" Stroke="#334155" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Паралелограм -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Parallelogram" ToolTip="Паралелограм"><Path Data="M 6,3 L 18,3 L 14,17 L 2,17 Z" Stroke="#334155" StrokeThickness="1.7" Width="17" Height="15" Stretch="Uniform"/></Button>
                                            <!-- Трапеція -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Trapezoid" ToolTip="Трапеція"><Path Data="M 5,3 L 15,3 L 19,17 L 1,17 Z" Stroke="#334155" StrokeThickness="1.7" Width="18" Height="15" Stretch="Uniform"/></Button>
                                            <!-- Многокутник -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Polygon" ToolTip="Шестикутник"><Path Data="M 6,2 L 14,2 L 18,9 L 14,16 L 6,16 L 2,9 Z" Stroke="#334155" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Зірка -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Star" ToolTip="Зірка"><Path Data="M 10,1 L 13,7 L 19,8 L 15,13 L 16,19 L 10,16 L 4,19 L 5,13 L 1,8 L 7,7 Z" Stroke="#F59E0B" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Дужка «Всього» } -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="CurlyBracket" ToolTip="Дужка умов «Всього» { ?"><Path Data="M 15,3 C 9,3 10,9 10,12 C 10,15 5,15 5,15 C 5,15 10,15 10,18 C 10,21 9,27 15,27" Stroke="#2563EB" StrokeThickness="2" Width="14" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Дужка порівняння <─> -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="ComparisonBrace" ToolTip="Дужка порівняння «На скільки / у скільки разів»"><Path Data="M 4,4 C 14,4 14,16 4,16 M 7,2 L 4,4 L 7,6 M 7,14 L 4,16 L 7,18" Stroke="#2563EB" StrokeThickness="1.7" Width="15" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Скоба «Ніж» ] -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="SquareBracket" ToolTip="Прямокутна скоба ]"><Path Data="M 4,3 H 14 V 19 H 4" Stroke="#2563EB" StrokeThickness="2" Width="14" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Осі координат X-Y -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="CoordinateAxes" ToolTip="Система координат (Осі X-Y)"><Path Data="M 2,12 L 22,12 M 19,9 L 22,12 L 19,15 M 12,22 L 12,2 M 9,5 L 12,2 L 15,5" Stroke="#16A34A" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Числова пряма -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="NumberLine" ToolTip="Числова пряма"><Path Data="M 2,12 H 22 M 19,9 L 22,12 L 19,15 M 6,9 V 15 M 12,8 V 16 M 16,9 V 15" Stroke="#16A34A" StrokeThickness="1.6" Width="17" Height="14" Stretch="Uniform"/></Button>
                                            <!-- Графік функції y = f(x) -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="FunctionGraph" ToolTip="Графік функції y = x²"><Path Data="M 2,16 H 20 M 11,20 V 2 M 3,5 Q 11,17 19,5" Stroke="#2563EB" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- 3D Куб -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Cube" ToolTip="3D Куб"><Path Data="M 2,7 L 12,2 L 22,7 L 12,12 Z M 2,7 L 2,17 L 12,22 L 12,12 Z M 22,7 L 22,17 L 12,22" Stroke="#9333EA" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- 3D Піраміда -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="SquarePyramid" ToolTip="3D Піраміда"><Path Data="M 12,2 L 2,17 L 14,21 L 22,16 Z M 12,2 L 14,21" Stroke="#9333EA" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- 3D Циліндр -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Cylinder" ToolTip="3D Циліндр"><Path Data="M 2,5 A 8,3 0 1 0 18,5 A 8,3 0 1 0 2,5 M 2,5 L 2,17 A 8,3 0 0 0 18,17 L 18,5" Stroke="#9333EA" StrokeThickness="1.5" Width="15" Height="16" Stretch="Uniform"/></Button>
                                            <!-- 3D Куля -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Sphere" ToolTip="3D Куля"><Path Data="M 10,2 A 8,8 0 1 0 10,18 A 8,8 0 1 0 10,2 M 2,10 A 8,3 0 1 0 18,10" Stroke="#9333EA" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Побудови: Перпендикуляр -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Perpendicular" ToolTip="Перпендикуляр (90°)"><Path Data="M 2,17 H 18 M 10,17 V 3 M 10,13 H 14 V 17" Stroke="#0284C7" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Побудови: Бісектриса -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Bisector" ToolTip="Бісектриса кута"><Path Data="M 3,17 L 17,17 M 3,17 L 15,5 M 3,17 L 17,9" Stroke="#0284C7" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Побудови: Висота -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Altitude" ToolTip="Висота трикутника"><Path Data="M 10,2 L 18,17 L 2,17 Z M 10,2 V 17 M 10,13 H 13 V 17" Stroke="#0284C7" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                            <!-- Побудови: Дотична -->
                                            <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="ShapeSelect_Click" Tag="Tangent" ToolTip="Дотична до кола"><Path Data="M 9,9 A 5,5 0 1 0 9,19 A 5,5 0 1 0 9,9 M 2,4 L 18,20" Stroke="#0284C7" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
                                        </WrapPanel>
                                    </ScrollViewer>

                                    <!-- Нижняя строка тумблеров (4 штуки) -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ShapeLabelsCheck" Grid.Column="0" Content="Підписи A, B, C" FontSize="11" Foreground="#334155" Cursor="Hand"/>
                                            <CheckBox x:Name="ShapeDashedCheck" Grid.Column="1" Content="Пунктир" FontSize="11" Foreground="#334155" Cursor="Hand"/>
                                            <CheckBox x:Name="ShapePinToolCheck" Grid.Column="2" Content="Закріпити" FontSize="11" Foreground="#334155" Cursor="Hand"/>
                                            <CheckBox x:Name="ShapeSnappingCheck" Grid.Column="3" Content="Прив'язки" FontSize="11" Foreground="#334155" IsChecked="True" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 9. ЗАЛИВКА -->
                    <Button x:Name="FillBucketBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="FillBucketBtn_Click"
                            ToolTip="Заливка фону або фігури">
                        <Path Data="M 19,11 L 12,4 L 4.5,11.5 A 3.5,3.5 0 0 0 9.5,16.5 L 15,11 M 22,20 A 2,2 0 1 1 18,20 C 18,18 20,16 20,16 C 20,16 22,18 22,20 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 10. КРУЖОК КОЛЬОРУ ( ШВИДКА ЗМІНА) -->
                    <Grid>
                        <Button x:Name="ColorDotBtn" Visibility="Collapsed"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Click="ColorDotBtn_Click"
                                ToolTip="Палітра кольорів">
                            <Ellipse x:Name="CurrentColorCircle" Width="16" Height="16" Fill="#1E293B" Stroke="#CBD5E1" StrokeThickness="1.5"/>
                        </Button>
                        <Popup x:Name="QuickColorPopup" PlacementTarget="{Binding ElementName=ColorDotBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <WrapPanel Width="150">
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#1E293B"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#1E293B"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#2563EB"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#2563EB"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#0D9488"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#0D9488"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#16A34A"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#16A34A"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#EAB308"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#EAB308"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#EA580C"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#EA580C"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#DC2626"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#DC2626"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#9333EA"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#9333EA"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#EC4899"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#EC4899"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="22" Height="22" Margin="3" Cursor="Hand" Click="PencilColor_Click" Tag="#FFFFFF"><Button.Template><ControlTemplate><Border CornerRadius="11" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5"/></ControlTemplate></Button.Template></Button>
                                </WrapPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 11. КРЕСЛЯРСЬКІ ІНСТРУМЕНТИ ( ЛІНІЙКА, ТРАНСПОРТИР, КОСИНЕЦЬ) -->
                    <Grid>
                        <ToggleButton x:Name="DraftingToolsBtn"
                                      Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                      Click="DraftingToolsBtn_Click"
                                      ToolTip="Креслярські інструменти (Лінійка, транспортир, косинець)">
                            <Path Data="M 2,18 L 18,18 L 2,2 Z M 5,15 L 12,15 L 5,8 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </ToggleButton>
                        <Popup x:Name="DraftingPopup" PlacementTarget="{Binding ElementName=DraftingToolsBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="SelectDraftingTool_Click" Tag="Ruler" ToolTip="Мірна лінійка (см/мм)">
                                        <Path Data="M 2,4 H 22 V 12 H 2 Z M 5,4 V 8 M 8,4 V 6 M 11,4 V 8 M 14,4 V 6 M 17,4 V 8" Stroke="#2563EB" StrokeThickness="1.5" Width="18" Height="11" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="SelectDraftingTool_Click" Tag="Protractor" ToolTip="Транспортир 180°">
                                        <Path Data="M 2,16 A 10,10 0 0 1 22,16 Z M 12,16 V 6 M 7,16 L 8.5,10 M 17,16 L 15.5,10" Stroke="#F59E0B" StrokeThickness="1.5" Width="17" Height="14" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaToolbarActionBtn}" Click="SelectDraftingTool_Click" Tag="SetSquare" ToolTip="Креслярський косинець 90°">
                                        <Path Data="M 2,18 L 18,18 L 2,2 Z M 5,15 L 12,15 L 5,8 Z" Stroke="#16A34A" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- 12. ШРИФТ / ФОРМАТ (A) -->
                    <Button x:Name="FontBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="FontBtn_Click"
                            ToolTip="Форматування тексту (A)">
                        <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 13. СТІКЕР / НОТАТКА -->
                    <Grid>
                        <Button x:Name="StickerToolBtn"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Click="StickerToolBtn_Click"
                                ToolTip="Стікер для нотаток">
                            <Path Data="M 15.5,3 H 5 A 2,2 0 0 0 3,5 V 19 A 2,2 0 0 0 5,21 H 19 A 2,2 0 0 0 21,19 V 8.5 L 15.5,3 Z M 14,3 V 8 H 19"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Popup x:Name="StickerColorPopup" PlacementTarget="{Binding ElementName=StickerToolBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="AddStickerColor_Click" Tag="#FEF08A" ToolTip="Жовтий стікер"><Button.Template><ControlTemplate><Border CornerRadius="6" Background="#FEF08A" BorderBrush="#FACC15" BorderThickness="1"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="AddStickerColor_Click" Tag="#BBF7D0" ToolTip="Зелений стікер"><Button.Template><ControlTemplate><Border CornerRadius="6" Background="#BBF7D0" BorderBrush="#4ADE80" BorderThickness="1"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="AddStickerColor_Click" Tag="#BFDBFE" ToolTip="Блакитний стікер"><Button.Template><ControlTemplate><Border CornerRadius="6" Background="#BFDBFE" BorderBrush="#60A5FA" BorderThickness="1"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="AddStickerColor_Click" Tag="#FBCFE8" ToolTip="Рожевий стікер"><Button.Template><ControlTemplate><Border CornerRadius="6" Background="#FBCFE8" BorderBrush="#F472B6" BorderThickness="1"/></ControlTemplate></Button.Template></Button>
                                    <Button Width="24" Height="24" Margin="2" Cursor="Hand" Click="AddStickerColor_Click" Tag="#FED7AA" ToolTip="Помаранчевий стікер"><Button.Template><ControlTemplate><Border CornerRadius="6" Background="#FED7AA" BorderBrush="#FB923C" BorderThickness="1"/></ControlTemplate></Button.Template></Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 14. РЕДАКТОР ФОРМУЛ (√x) -->
                    <Button x:Name="FormulaBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="FormulaBtn_Click"
                            ToolTip="Редактор формул (√x) — математика, фізика, хімія">
                        <Path Data="M 3,13 H 6 L 9,20 L 14,4 H 21 M 16,13 L 20,19 M 20,13 L 16,19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <!-- 15. МАТЕМАТИЧНИЙ ТРЕНАЖЕР (+14) -->
                    <Grid>
                        <Button x:Name="MathTrainerBtn"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Click="MathTrainerBtn_Click"
                                ToolTip="Математичний тренажер (+14) — дія в стовпчик та дроби">
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="4,1">
                                <TextBlock Text="+14" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                            </Border>
                        </Button>
                        <Popup x:Name="MathTrainerPopup" PlacementTarget="{Binding ElementName=MathTrainerBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Width="260" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Дія в стовпчик" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                                        <Button Content="+" Style="{StaticResource VseosvitaTopActionBtn}" Click="MathTrainerItem_Click" Tag="Add" FontSize="15" FontWeight="Bold" Foreground="#16A34A" ToolTip="Додавання в стовпчик"/>
                                        <Button Content="-" Style="{StaticResource VseosvitaTopActionBtn}" Click="MathTrainerItem_Click" Tag="Sub" FontSize="15" FontWeight="Bold" Foreground="#DC2626" ToolTip="Віднімання в стовпчик"/>
                                        <Button Content="×" Style="{StaticResource VseosvitaTopActionBtn}" Click="MathTrainerItem_Click" Tag="Mul" FontSize="15" FontWeight="Bold" Foreground="#2563EB" ToolTip="Множення в стовпчик"/>
                                        <Button Content="÷" Style="{StaticResource VseosvitaTopActionBtn}" Click="MathTrainerItem_Click" Tag="Div" FontSize="15" FontWeight="Bold" Foreground="#9333EA" ToolTip="Ділення куточком"/>
                                    </UniformGrid>

                                    <TextBlock Text="Звичайні дроби" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,6"/>
                                    <StackPanel Margin="0,0,0,4">
                                        <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MathTrainerItem_Click" Tag="FractionEquation" Margin="0,2">
                                            <TextBlock Text="Додавання дробів (½ + ¼)" FontSize="11.5" Foreground="#334155"/>
                                        </Button>
                                        <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MathTrainerItem_Click" Tag="FractionCircle" Margin="0,2">
                                            <TextBlock Text="Кругова модель дробу (Коло)" FontSize="11.5" Foreground="#334155"/>
                                        </Button>
                                        <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="MathTrainerItem_Click" Tag="FractionStrip" Margin="0,2">
                                            <TextBlock Text="Смугова модель дробу (Смуга)" FontSize="11.5" Foreground="#334155"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 16. ЗОБРАЖЕННЯ -->
                    <Button x:Name="InsertImageBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="InsertImageBtn_Click"
                            ToolTip="Додати зображення ( Ctrl+V)">
                        <Path Data="M 3,5 A 2,2 0 0 1 5,3 H 19 A 2,2 0 0 1 21,5 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 Z M 8.5,10 A 1.5,1.5 0 1 0 8.5,7 A 1.5,1.5 0 1 0 8.5,10 Z M 21,15 L 16,10 L 5,21"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- Чарівна паличка: прибрати фон зображення -->
                    <Button x:Name="MagicWandBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="MagicWandRemoveBackground_Click"
                            ToolTip="Чарівна паличка: прибрати фон зображення">
                        <Path Data="M 15,4 L 20,9 M 18,2 L 22,6 M 2,22 L 14,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Заливка фарбою (Paint Bucket) -->
                    <Button x:Name="PaintBucketBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="PaintBucketToolBtn_Click"
                            ToolTip="Заливка фарбою замкнених фігур">
                        <Path Data="M 19 11 L 12 4 L 4.5 11.5 C 3.5 12.5 3.5 14 4.5 15 L 8 18.5 C 9 19.5 10.5 19.5 11.5 18.5 L 19 11 Z M 5 2 V 6 M 22 20 A 2 2 0 1 1 18 20 C 18 18 20 16 20 16 C 20 16 22 18 22 20 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- Розмиття області (Приховування відповіді) -->
                    <Button x:Name="BlurAreaBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="BlurToolBtn_Click"
                            ToolTip="Приховати відповідь (розмиття з розкриттям при кліку)">
                        <Path Data="M 1 12 S 5 4 12 4 S 23 12 23 12 S 19 20 12 20 S 1 12 1 12 Z M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 0 0 12 15 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 17. ДОКУМЕНТИ / PDF -->
                    <Button x:Name="DocsBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="DocsBtn_Click"
                            ToolTip="Імпортувати документи або PDF">
                        <Path Data="M 14,2 H 6 A 2,2 0 0 0 4,4 V 20 A 2,2 0 0 0 6,22 H 18 A 2,2 0 0 0 20,20 V 8 Z M 14,2 V 8 H 20 M 16,13 H 8 M 16,17 H 8 M 10,9 H 8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 18. АУДІО / ГОЛОС -->
                    <Button x:Name="VoiceBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="VoiceBtn_Click"
                            ToolTip="Голосовий запис або диктовка">
                        <Path Data="M 12,2 A 3,3 0 0 0 9,5 V 11 A 3,3 0 0 0 15,11 V 5 A 3,3 0 0 0 12,2 Z M 19,10 V 11 A 7,7 0 0 1 5,11 V 10 M 12,18 V 22 M 8,22 H 16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- 19. ПОСИЛАННЯ -->
                    <Button x:Name="LinkBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="LinkBtn_Click"
                            ToolTip="Вставити посилання">
                        <Path Data="M 10,13 A 5,5 0 0 0 17.07,13 L 20.07,10 A 5,5 0 0 0 13,2.93 L 11.5,4.43 M 14,11 A 5,5 0 0 0 6.93,11 L 3.93,14 A 5,5 0 0 0 11,21.07 L 12.5,19.57"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 20. ВЕБ-СТОРІНКА / БРАУЗЕР -->
                    <Button x:Name="WebEmbedBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="WebEmbedBtn_Click"
                            ToolTip="Вставити веб-сторінку">
                        <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 H 22 M 12,2 A 15,15 0 0 1 16,12 A 15,15 0 0 1 12,22 A 15,15 0 0 1 8,12 A 15,15 0 0 1 12,2 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 21. ОБРІЗАТИ / ЗНІМОК -->
                    <Button x:Name="CropBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="CropBtn_Click"
                            ToolTip="Обрізати область або зробити знімок">
                        <Path Data="M 6,2 V 18 A 2,2 0 0 0 8,20 H 24 M 2,6 H 18 A 2,2 0 0 1 20,8 V 24"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 22. ЛАСО / ОБЛАСТЬ ВИДІЛЕННЯ (⬚) -->
                    <Button x:Name="SelectLassoBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="SelectLassoBtn_Click"
                            ToolTip="Прямокутне виділення або ласо (⬚)">
                        <Path Data="M 3,3 H 7 M 11,3 H 13 M 17,3 H 21 V 7 M 21,11 V 13 M 21,17 V 21 H 17 M 13,21 H 11 M 7,21 H 3 V 17 M 3,13 V 11 M 3,7 V 3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- 23. ТЕМА / ШАБЛОН АРКУША -->
                    <Button x:Name="ThemeBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="SheetSettingsBtn_Click"
                            ToolTip="Шаблон та колір аркуша">
                        <Path Data="M 12,2 A 10,10 0 0 0 2,12 C 2,16.5 5.5,20 10,20 C 10.8,20 11.5,19.3 11.5,18.5 C 11.5,18.1 11.3,17.7 11.1,17.4 C 10.9,17.1 10.7,16.6 10.7,16 C 10.7,14.9 11.6,14 12.7,14 H 14.5 C 17.5,14 20,11.5 20,8.5 C 20,4.9 16.4,2 12,2 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 24. МЕНЮ (≡) -->
                    <Grid>
                        <Button x:Name="MenuBtn"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Click="WhiteboardMenuBtn_Click"
                                ToolTip="Меню дій дошки (≡)">
                            <Path Data="M 3,12 H 21 M 3,6 H 21 M 3,18 H 21"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Popup x:Name="WhiteboardMenuPopup" PlacementTarget="{Binding ElementName=MenuBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,6" Width="200" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="AddBoardBtn_Click" Margin="0,2">
                                        <TextBlock Text="Новий аркуш" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="ExportBoardBtn_Click" Margin="0,2">
                                        <TextBlock Text="Зберегти як картинку" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="ClearBoardBtn_Click" Margin="0,2">
                                        <TextBlock Text="Очистити аркуш" FontSize="11.5" Foreground="#EF4444"/>
                                    </Button>
                                    <Rectangle Height="1" Fill="#E2E8F0" Margin="4,4"/>
                                    <Button Style="{StaticResource VseosvitaTopActionBtn}" HorizontalContentAlignment="Left" Click="SheetSettingsBtn_Click" Margin="0,2">
                                        <TextBlock Text="Налаштування" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 25. МАСШТАБ (100% ˅) -->
                    <Grid>
                        <Button x:Name="ZoomBtn"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Width="Auto"
                                Padding="6,0"
                                Click="ZoomBtn_Click"
                                ToolTip="Масштаб аркуша">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ZoomLevelText" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                <Path Data="M 6,9 L 12,15 L 18,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="ZoomPopup" PlacementTarget="{Binding ElementName=ZoomBtn}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,4" Width="100">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <Button Content="50%" Style="{StaticResource VseosvitaTopActionBtn}" Click="ZoomSelect_Click" Tag="0.5"/>
                                    <Button Content="75%" Style="{StaticResource VseosvitaTopActionBtn}" Click="ZoomSelect_Click" Tag="0.75"/>
                                    <Button Content="100%" Style="{StaticResource VseosvitaTopActionBtn}" Click="ZoomSelect_Click" Tag="1.0" FontWeight="Bold"/>
                                    <Button Content="125%" Style="{StaticResource VseosvitaTopActionBtn}" Click="ZoomSelect_Click" Tag="1.25"/>
                                    <Button Content="150%" Style="{StaticResource VseosvitaTopActionBtn}" Click="ZoomSelect_Click" Tag="1.5"/>
                                    <Button Content="200%" Style="{StaticResource VseosvitaTopActionBtn}" Click="ZoomSelect_Click" Tag="2.0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 26. ЗГОРНУТИ ПАНЕЛЬ (>>) -->
                    <Button x:Name="MoreBtn" Visibility="Collapsed"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="MoreBtn_Click"
                            ToolTip="Згорнути панель інструментів (>>)">
                        <Path Data="M 7,7 L 12,12 L 7,17 M 13,7 L 18,12 L 13,17"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- ================================================================= -->
                <!-- ПАНЕЛЬ 2: РЕЖИМ ФОРМАТИРОВАНИЯ ТЕКСТА (TextFormatPanel)           -->
                <!-- ================================================================= -->
                <StackPanel x:Name="TextFormatPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <!-- 1. ТЕКСТ (I) -> АКТИВНЫЙ/ЗЕЛЕНЫЙ -->
                    <ToggleButton x:Name="TextToggleTextMode"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  IsChecked="True"
                                  Click="TextToolBtn_Click"
                                  ToolTip="Текст (активний)">
                        <Path Data="M 4,7 V 4 H 20 V 7 M 9,20 H 15 M 12,4 V 20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </ToggleButton>

                    <!-- 2. ВКАЗІВНИК (↖) -> ПЕРЕКЛЮЧАЕТ В РЕЖИМ КУРСОРА -->
                    <ToggleButton x:Name="PointerBtnTextMode"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  Click="PointerBtn_Click"
                                  ToolTip="Вказівник (↖) — вийти з режиму тексту в малювання">
                        <Path Data="M 3,3 L 10,21 L 13,14 L 20,11 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </ToggleButton>

                    <!-- 3. УКАЗКА -->
                    <ToggleButton x:Name="LaserBtnTextMode"
                                  Style="{StaticResource VseosvitaToolbarToggleBtn}"
                                  Click="LaserBtn_Click"
                                  ToolTip="Указка">
                        <Path Data="M 18,11 V 6 A 2,2 0 0 0 14,6 V 11 M 14,7.5 V 4 A 2,2 0 0 0 10,4 V 11.5 M 10,9 V 2 A 2,2 0 0 0 6,2 V 14.5 C 6,19 9.5,22 14,22 H 15 A 7,7 0 0 0 22,15 V 10 A 2,2 0 0 0 18,10 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </ToggleButton>

                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- 4. ВИБІР ШРИФТУ (A ˅) -->
                    <Grid>
                        <Button x:Name="FontBtnTextMode"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Width="Auto"
                                Padding="8,0"
                                Click="FontBtnTextMode_Click"
                                ToolTip="Вибір шрифту та розміру (A)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                <Path Data="M 6,9 L 12,15 L 18,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="FontFormatPopup" PlacementTarget="{Binding ElementName=FontBtnTextMode}" Placement="Top" VerticalOffset="-12" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Width="220" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="18" ShadowDepth="3" Opacity="0.12"/></Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Шрифт тексту" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="FontFamilyCombo" SelectedIndex="0" Height="28" Margin="0,0,0,10" SelectionChanged="FontFamilyCombo_SelectionChanged">
                                        <ComboBoxItem Content="Шкільний пропис (Propysy)"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Arial"/>
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Consolas"/>
                                    </ComboBox>
                                    <TextBlock Text="Розмір шрифту" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <UniformGrid Rows="1" Columns="5" Margin="0,0,0,10">
                                        <Button Content="18" Style="{StaticResource VseosvitaTopActionBtn}" Click="FontSize_Click" Tag="18"/>
                                        <Button Content="24" Style="{StaticResource VseosvitaTopActionBtn}" Click="FontSize_Click" Tag="24"/>
                                        <Button Content="36" Style="{StaticResource VseosvitaTopActionBtn}" Click="FontSize_Click" Tag="36" FontWeight="Bold"/>
                                        <Button Content="48" Style="{StaticResource VseosvitaTopActionBtn}" Click="FontSize_Click" Tag="48"/>
                                        <Button Content="60" Style="{StaticResource VseosvitaTopActionBtn}" Click="FontSize_Click" Tag="60"/>
                                    </UniformGrid>
                                    <UniformGrid Rows="1" Columns="3">
                                        <ToggleButton x:Name="FontBoldToggle" Content="Ж" FontWeight="Bold" Style="{StaticResource VseosvitaToolbarToggleBtn}" Width="60" Height="30" Click="FontBoldToggle_Click"/>
                                        <ToggleButton x:Name="FontItalicToggle" Content="К" FontStyle="Italic" Style="{StaticResource VseosvitaToolbarToggleBtn}" Width="60" Height="30" Click="FontItalicToggle_Click"/>
                                        <ToggleButton x:Name="FontUnderlineToggle" Content="Ч" Style="{StaticResource VseosvitaToolbarToggleBtn}" Width="60" Height="30" Click="FontUnderlineToggle_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 5. ВИРІВНЮВАННЯ ЛІВОРУЧ -->
                    <Button x:Name="AlignLeftBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="AlignLeftBtn_Click"
                            ToolTip="Вирівнювання по лівому краю">
                        <Path Data="M 3,6 H 21 M 3,12 H 15 M 3,18 H 19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 6. ВИРІВНЮВАННЯ ПО ЦЕНТРУ -->
                    <Button x:Name="AlignCenterBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="AlignCenterBtn_Click"
                            ToolTip="Вирівнювання по центру">
                        <Path Data="M 3,6 H 21 M 6,12 H 18 M 4,18 H 20"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 7. ВИРІВНЮВАННЯ ПРАВОРУЧ -->
                    <Button x:Name="AlignRightBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="AlignRightBtn_Click"
                            ToolTip="Вирівнювання по правому краю">
                        <Path Data="M 3,6 H 21 M 9,12 H 21 M 5,18 H 21"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 8. МАРКОВАНИЙ СПИСОК (:=) -->
                    <Button x:Name="BulletListBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="BulletListBtn_Click"
                            ToolTip="Маркований список (:=)">
                        <Path Data="M 8,6 H 21 M 8,12 H 21 M 8,18 H 21 M 3,6 H 3.01 M 3,12 H 3.01 M 3,18 H 3.01"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 9. НУМЕРОВАНИЙ СПИСОК (1.) -->
                    <Button x:Name="NumberListBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="NumberListBtn_Click"
                            ToolTip="Нумерований список (1.)">
                        <Path Data="M 10,6 H 21 M 10,12 H 21 M 10,18 H 21 M 4,6 H 5.5 V 8 M 4,14 H 6 V 12 H 4 M 4,18 H 6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 10. ВІДСТУП АБЗАЦУ (↩) -->
                    <Button x:Name="IndentBtn"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="IndentBtn_Click"
                            ToolTip="Відступ абзацу (Червоний рядок)">
                        <Path Data="M 3,8 H 13 A 5,5 0 0 1 18,13 A 5,5 0 0 1 13,18 H 3 M 7,4 L 3,8 L 7,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 11. ШТАМП ДАТИ ( ˅) -->
                    <Grid>
                        <Button x:Name="DateStampBtn"
                                Style="{StaticResource VseosvitaToolbarActionBtn}"
                                Width="Auto"
                                Padding="8,0"
                                Click="DateStampBtn_Click"
