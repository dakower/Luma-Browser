                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 15. МЕНЮ (≡) -->
                    <Button x:Name="MenuBtnTextMode"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="WhiteboardMenuBtn_Click"
                            ToolTip="Меню дій дошки (≡)">
                        <Path Data="M 3,12 H 21 M 3,6 H 21 M 3,18 H 21"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>

                    <!-- 16. МАСШТАБ (100% ˅) -->
                    <Button x:Name="ZoomBtnTextMode"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Width="Auto"
                            Padding="6,0"
                            Click="ZoomBtn_Click"
                            ToolTip="Масштаб аркуша">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="100%" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                            <Path Data="M 6,9 L 12,15 L 18,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 17. ЗГОРНУТИ (>>) -->
                    <Button x:Name="MoreBtnTextMode"
                            Style="{StaticResource VseosvitaToolbarActionBtn}"
                            Click="MoreBtn_Click"
                            ToolTip="Згорнути панель (>>)">
                        <Path Data="M 7,7 L 12,12 L 7,17 M 13,7 L 18,12 L 13,17"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========================================================================= -->
        <!-- МОДАЛЬНЕ ВІКНО: РЕДАКТОР ФОРМУЛ (FORMULA EDITOR MODAL √x)                 -->
        <!-- ========================================================================= -->
        <Border x:Name="FormulaEditorModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="20,16"
                Width="660"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.14"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок модального вікна -->
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="√x" FontSize="13" FontWeight="Bold" Foreground="#4F46E5"/>
                        </Border>
                        <TextBlock Text="Редактор математичних формул" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="CloseFormulaModal_Click" ToolTip="Закрити">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Вкладки символів: ⭐ Готові | √x | 123 | x= | ∠Δ | πe | ∫∫ | αβ | Фізика | Хімія -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Preset" FontWeight="Bold" Foreground="#4F46E5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" Fill="#4F46E5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Готові" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="√x Дроби/Корені" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Roots"/>
                        <Button Content="123 Числа" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Numbers"/>
                        <Button Content="x= Змінні" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Variables"/>
                        <Button Content="∠Δ Геометрія" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Geometry"/>
                        <Button Content="πe Константи" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Constants"/>
                        <Button Content="∫∫ Інтеграли" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Calculus"/>
                        <Button Content="αβ Грецькі" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Greek"/>
                        <Button Content="Фізика" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Physics"/>
                        <Button Content="Хімія" Style="{StaticResource VseosvitaTopActionBtn}" Click="FormulaTab_Click" Tag="Chemistry"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Палітра символів обраної вкладки -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,12" Height="100">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FormulaSymbolsPalette"/>
                    </ScrollViewer>
                </Border>

                <!-- Поле вводу та живий попередній перегляд формули -->
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="FormulaInputBox"
                             Grid.Row="0"
                             Height="42"
                             FontSize="16"
                             FontFamily="Consolas, Cambria Math, Segoe UI"
                             Padding="10,8"
                             Background="#FFFFFF"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1.5"
                             VerticalContentAlignment="Center"
                             TextChanged="FormulaInputBox_TextChanged"/>

                    <!-- Попередній перегляд (Великий рендер) -->
                    <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,8,0,0" MinHeight="50">
                        <TextBlock x:Name="FormulaPreviewBlock"
                                   Text="y = ax² + bx + c"
                                   FontSize="20"
                                   FontFamily="Cambria Math, Segoe UI Semibold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Нижня панель дій: Кнопки скасувати / додати на дошку -->
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="FormulaNonItalicCheck" Content="Некурсив" FontSize="11.5" Foreground="#334155" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="Очистити" Style="{StaticResource VseosvitaTopActionBtn}" Click="ClearFormulaInput_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Height="34" Width="90" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand" Click="CloseFormulaModal_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                        </Button>
                        <Button x:Name="InsertFormulaToBoardBtn" Content="Вставити у дошку" Height="34" Padding="16,0" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" Click="InsertFormulaToCanvas_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

                <!-- ========================================================================= -->
        <!-- БЛОК 1.1: МОДАЛЬНЕ ВІКНО «СТВОРИТИ ЕЛЕКТРОННУ ДОШКУ» (CREATE BOARD MODAL)    -->
        <!-- ========================================================================= -->
        <Border x:Name="CreateBoardModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="28,24"
                Width="720"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="32" ShadowDepth="8" Opacity="0.16"/>
            </Border.Effect>
            <StackPanel>
                <!-- Заголовок -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                            <Path Data="M 3 3 H 21 V 17 H 3 Z M 8 21 L 10 17 M 16 21 L 14 17 M 7 21 H 17"
                                  Stroke="#16A34A" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Створити електронну дошку" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Click="CloseCreateBoard_Click" ToolTip="Закрити">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ГРУПА 1: ТЕТРАДНІ ТА НОТНІ ЛИСТИ (РЕЖИМ ТЕКСТУ З ШАПКОЮ) -->
                        <TextBlock Text="Група 1: Тетрадні та нотні листи (відкриваються в Текстовому режимі з готовою шапкою)"
                                   FontSize="12" FontWeight="Bold" Foreground="#2563EB" Margin="2,0,0,8"/>
                        <UniformGrid Rows="2" Columns="3" Margin="0,0,0,18">
                            <Border x:Name="NewTplRuled" Tag="Ruled" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="60" Height="36" Background="#FFFFFF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,9 L 60,9 M 0,18 L 60,18 M 0,27 L 60,27" Stroke="#93C5FD" StrokeThickness="0.8"/>
                                    </Border>
                                    <TextBlock Text="Лінійка" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Широка з червоним полем" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplGrid" Tag="Grid" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="60" Height="36" Background="#FFFFFF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,9 L 60,9 M 0,18 L 60,18 M 0,27 L 60,27 M 15,0 L 15,36 M 30,0 L 30,36 M 45,0 L 45,36" Stroke="#93C5FD" StrokeThickness="0.6"/>
                                    </Border>
                                    <TextBlock Text="Клітинка" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Стандартний зошит" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplSlanted" Tag="Slanted" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#F1F5F9" BorderBrush="#0F172A" BorderThickness="2" CornerRadius="10" Padding="12,10" Margin="4" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="60" Height="36" Background="#FFFFFF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,12 L 60,12 M 0,24 L 60,24 M 8,36 L 24,0 M 24,36 L 40,0 M 40,36 L 56,0" Stroke="#93C5FD" StrokeThickness="0.7"/>
                                    </Border>
                                    <TextBlock Text="Коса лінійка ⭐" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Для прописів 1–2 класів" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplNotebook" Tag="Notebook" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="60" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,9 L 60,9 M 0,18 L 60,18 M 0,27 L 60,27" Stroke="#CBD5E1" StrokeThickness="0.8"/>
                                    </Border>
                                    <TextBlock Text="Нотатник" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Без шкільних полів" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplMusic1" Tag="Music" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="60" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,8 H 60 M 0,13 H 60 M 0,18 H 60 M 0,23 H 60 M 0,28 H 60" Stroke="#64748B" StrokeThickness="0.7"/>
                                    </Border>
                                    <TextBlock Text="Нотний стан 1" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="5-лінійний класичний" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplMusic2" Tag="Music2" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="60" Height="36" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,6 H 60 M 0,10 H 60 M 0,14 H 60 M 0,22 H 60 M 0,26 H 60 M 0,30 H 60" Stroke="#64748B" StrokeThickness="0.6"/>
                                    </Border>
                                    <TextBlock Text="Нотний стан 2" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Парний для фортепіано" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ГРУПА 2: ПОЛОТНА ТА ГРАФІЧНІ ДОШКИ (РЕЖИМ МАЛЮВАННЯ) -->
                        <TextBlock Text="Група 2: Полотна та графічні дошки (відкриваються в Режимі малювання)"
                                   FontSize="12" FontWeight="Bold" Foreground="#16A34A" Margin="2,0,0,8"/>
                        <UniformGrid Rows="1" Columns="5" Margin="0,0,0,20">
                            <Border x:Name="NewTplBlank" Tag="Blank" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,10" Margin="3" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="50" Height="32" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Білий лист" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ватман" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplGreenBoard" Tag="GreenBoard" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,10" Margin="3" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="50" Height="32" Background="#163A2B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Зелена" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Шкільна" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplDarkBoard" Tag="DarkBoard" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,10" Margin="3" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="50" Height="32" Background="#18181B" BorderBrush="#52525B" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Темна" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Контрастна" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplDotGrid" Tag="DotGrid" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,10" Margin="3" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="50" Height="32" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Ellipse Width="3" Height="3" Fill="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Крапка" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Dot grid" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="NewTplMillimeter" Tag="Millimeter" MouseLeftButtonDown="CreateBoardTemplateCard_Click" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,10" Margin="3" Cursor="Hand">
                                <StackPanel>
                                    <Border Width="50" Height="32" Background="#EFF6FF" BorderBrush="#60A5FA" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="M 0,8 H 50 M 0,16 H 50 M 0,24 H 50 M 12,0 V 32 M 25,0 V 32 M 38,0 V 32" Stroke="#93C5FD" StrokeThickness="0.6"/>
                                    </Border>
                                    <TextBlock Text="Міліметрівка" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Координати" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- СЕЛЕКТОР ВИБОРУ ШРИФТУ З ПРЕВ'Ю -->
                        <TextBlock Text="Шрифт за замовчуванням (з візуальним накресленням):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="2,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CreateFontPropysyBtn" Grid.Column="0" Tag="Propysy" Click="CreateBoardFontBtn_Click" Height="48" Background="#0F172A" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Padding="12,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Абвгд" FontFamily="{StaticResource PropysyRegular}" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Рукописний (Прописи НУШ)" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="Каліграфічні з'єднання букв" FontSize="10" Opacity="0.8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="CreateFontPrintedBtn" Grid.Column="2" Tag="Printed" Click="CreateBoardFontBtn_Click" Height="48" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Padding="12,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Абвгд" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Друкований (Segoe UI)" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="Стандартний прямий шрифт" FontSize="10" Opacity="0.8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Нижні кнопки -->
                <Grid Margin="0,8,0,0">
                    <Button Content="Скасувати" Height="36" Width="95" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" HorizontalAlignment="Left" Cursor="Hand" Click="CloseCreateBoard_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button Content="Створити дошку" Height="36" Padding="20,0" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" Click="ConfirmCreateBoard_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 1.2: МОДАЛЬНЕ ВІКНО «ЗНІМОК ЕКРАНА» (SCREENSHOT MODAL)               -->
        <!-- ========================================================================= -->
        <Border x:Name="ScreenshotModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="28,24"
                Width="640"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="30" ShadowDepth="6" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                            <Path Data="M 23 19 A 2 2 0 0 1 21 21 H 3 A 2 2 0 0 1 1 19 V 8 A 2 2 0 0 1 3 6 H 7 L 9 3 H 15 L 17 6 H 21 A 2 2 0 0 1 23 8 Z M 12 17 A 4 4 0 1 0 12 9 A 4 4 0 1 0 12 17 Z"
                                  Stroke="#2563EB" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Знімок екрана (підкладка для дошки)" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Click="ScreenshotCloseBtn_Click" ToolTip="Закрити">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Панель 4 джерел знімка -->
                <StackPanel x:Name="ScreenshotSourcesPanel">
                    <TextBlock Text="Оберіть джерело захоплення:" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,12"/>
                    <UniformGrid Rows="2" Columns="2" Margin="0,0,0,16">
                        <Button Height="68" Margin="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Cursor="Hand" Click="ScreenshotSourceTab_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                                <Path Data="M 2,4 H 22 V 18 H 2 Z M 2,8 H 22" Stroke="#2563EB" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Знімок вкладки / вікна" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                <TextBlock Text="Захоплення відкритого вікна" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="68" Margin="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Cursor="Hand" Click="ScreenshotSourceScroll_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="8" Background="#F0FDF4" Margin="0,0,10,0">
                                                <Path Data="M 12,3 V 21 M 7,8 L 12,3 L 17,8 M 7,16 L 12,21 L 17,16" Stroke="#16A34A" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Вся сторінка (прокручування)" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                <TextBlock Text="Авто-склеювання сторінки" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="68" Margin="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Cursor="Hand" Click="ScreenshotSourceClipboard_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="8" Background="#FAF5FF" Margin="0,0,10,0">
                                                <Path Data="M 16,4 H 19 A 2,2 0 0 1 21,6 V 20 A 2,2 0 0 1 19,22 H 5 A 2,2 0 0 1 3,20 V 6 A 2,2 0 0 1 5,4 H 8 M 9,2 H 15 V 6 H 9 Z" Stroke="#9333EA" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="З буфера обміну" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                <TextBlock Text="Вставити скопійовану картинку" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="68" Margin="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Cursor="Hand" Click="ScreenshotSourceFile_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="8" Background="#FFF7ED" Margin="0,0,10,0">
                                                <Path Data="M 21,15 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 15 M 17,8 L 12,3 L 7,8 M 12,3 V 15" Stroke="#EA580C" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Завантажити файл" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                <TextBlock Text="PNG, JPG, BMP, WEBP, PDF" FontSize="10.5" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Панель попереднього перегляду захопленого кадру -->
                <StackPanel x:Name="ScreenshotPreviewPanel" Visibility="Collapsed">
                    <Border Background="#0F172A" CornerRadius="10" Height="260" Margin="0,0,0,14" ClipToBounds="True">
                        <Image x:Name="ScreenshotPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="⟲ Повернути на 90° вліво" Style="{StaticResource VseosvitaTopActionBtn}" Padding="10,0" Height="32" Click="ScreenshotRotateLeft_Click" Margin="0,0,8,0"/>
                            <Button Content="⟳ Повернути на 90° вправо" Style="{StaticResource VseosvitaTopActionBtn}" Padding="10,0" Height="32" Click="ScreenshotRotateRight_Click"/>
                        </StackPanel>
                        <Button Content="Створити дошку" Height="36" Padding="20,0" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" Click="ScreenshotCreateBoardBtn_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 2: ІНФО-МОДАЛЬНЕ ВІКНО З 3 ВКЛАДКАМИ (INFO MODAL: TOOLS, HOTKEYS, GESTURES)-->
        <!-- ========================================================================= -->
        <Border x:Name="InfoModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24,20"
                Width="580"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.15"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Довідка та інструкція дошки" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="InfoModalClose_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- 3 Вкладки -->
                <UniformGrid Rows="1" Columns="3" Margin="0,0,0,14">
                    <Button x:Name="InfoTabToolsBtn" Content="🛠️ Інструменти" Height="32" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,4,0" Cursor="Hand" Click="InfoTabToolsBtn_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button x:Name="InfoTabHotkeysBtn" Content="⌨️ Гарячі клавіші" Height="32" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,4,0" Cursor="Hand" Click="InfoTabHotkeysBtn_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button x:Name="InfoTabGesturesBtn" Content="👆 Сенсорні жести" Height="32" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Cursor="Hand" Click="InfoTabGesturesBtn_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                </UniformGrid>

                <!-- Вміст вкладки 1: Інструменти -->
                <Border x:Name="InfoTabToolsContent" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Height="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="• Режим зошита (I): Введення та розпізнавання тексту зі шкільними прописами НУШ." Margin="0,3" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Предметні інструменти: Будова слова (корінь, суфікс), синтаксис, фонетика, IPA транскрипція, стовпчик та дроби." Margin="0,3" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Вказівник (V): Масштабування, обертання та блокування об'єктів замком 🔒." Margin="0,3" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Лазерна указка (L): Шлейф згасання 1.5 с; подвійний клік створює хвилю уваги!" Margin="0,3" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Приховування відповіді (Блюр): Інтерактивний блок, що розкривається натисканням." Margin="0,3" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Чарівна паличка: Миттєве видалення білого фону з картинок." Margin="0,3" FontSize="12" Foreground="#334155"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Вміст вкладки 2: Гарячі клавіші -->
                <Border x:Name="InfoTabHotkeysContent" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Height="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Rows="7" Columns="2">
                            <TextBlock Text="I" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Режим тексту" Foreground="#334155" Margin="0,4"/>
                            <TextBlock Text="V або Esc" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Вказівник (виділення)" Foreground="#334155" Margin="0,4"/>
                            <TextBlock Text="P" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Олівець" Foreground="#334155" Margin="0,4"/>
                            <TextBlock Text="H" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Маркер-виділювач" Foreground="#334155" Margin="0,4"/>
                            <TextBlock Text="E" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Гумка" Foreground="#334155" Margin="0,4"/>
                            <TextBlock Text="Ctrl+Z / Ctrl+Y" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Скасувати / Повторити" Foreground="#334155" Margin="0,4"/>
                            <TextBlock Text="F11" FontWeight="Bold" Foreground="#16A34A" Margin="0,4"/>
                            <TextBlock Text="Повноекранний режим" Foreground="#334155" Margin="0,4"/>
                        </UniformGrid>
                    </ScrollViewer>
                </Border>

                <!-- Вміст вкладки 3: Сенсорні жести -->
                <Border x:Name="InfoTabGesturesContent" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Height="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="• Масштабування двома пальцями (Pinch to Zoom): Плавний зум від точки дотику." Margin="0,5" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Прокручування двома пальцями: Панорамування аркуша в будь-якому напрямку." Margin="0,5" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Дотик одним пальцем / стилусом: Малювання поточним вибраним інструментом." Margin="0,5" FontSize="12" Foreground="#334155"/>
                            <TextBlock Text="• Довге натискання (Long Press): Виклик контекстного міні-меню для об'єкта." Margin="0,5" FontSize="12" Foreground="#334155"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 2: МОДАЛЬНЕ ВІКНО «ВБУДУВАТИ СОБІ НА САЙТ» (EMBED MODAL)              -->
        <!-- ========================================================================= -->
        <Border x:Name="EmbedModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24,20"
                Width="520"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="26" ShadowDepth="5" Opacity="0.14"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Вбудувати дошку на сайт" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="EmbedCloseBtn_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ширина (px):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmbedWidthBox" Text="800" Height="34" VerticalContentAlignment="Center" TextChanged="EmbedDimension_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Висота (px):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmbedHeightBox" Text="600" Height="34" VerticalContentAlignment="Center" TextChanged="EmbedDimension_TextChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="HTML-код для вставки (iframe):" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                <TextBox x:Name="EmbedCodePreviewBox" Height="72" TextWrapping="Wrap" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" Background="#F8FAFC" BorderBrush="#E2E8F0" Padding="8" Margin="0,0,0,16"/>

                <Button Content="📋 Копіювати код" Height="36" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" Click="CopyEmbedCodeBtn_Click"/>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 2: МОДАЛЬНЕ ВІКНО «НАЛАШТУВАННЯ ТА ОПИС ДОШКИ» (METADATA SETTINGS)    -->
        <!-- ========================================================================= -->
        <Border x:Name="MetadataSettingsModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24,20"
                Width="480"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="26" ShadowDepth="5" Opacity="0.14"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Параметри та опис уроку" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="MetadataSettingsClose_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <TextBlock Text="Назва уроку / аркуша:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox x:Name="MetadataBoardTitleBox" Height="36" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="Тема та додаткові нотатки:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox x:Name="MetadataBoardDescBox" Height="76" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12.5" Margin="0,0,0,16"/>

                <Button Content="Зберегти налаштування" Height="36" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" Click="MetadataSettingsSave_Click"/>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 2: МОДАЛЬНЕ ВІКНО ПІДТВЕРДЖЕННЯ ЗАКРИТТЯ (CLOSE CONFIRMATION MODAL)   -->
        <!-- ========================================================================= -->
        <Border x:Name="CloseConfirmationModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24,20"
                Width="420"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.15"/></Border.Effect>
            <StackPanel>
                <TextBlock Text="Закрити електронну дошку?" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                <TextBlock Text="Бажаєте зберегти внесені зміни на аркушах перед виходом?" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,20"/>
                <Grid>
                    <Button Content="Скасувати" Height="34" Width="85" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" HorizontalAlignment="Left" Cursor="Hand" Click="CloseConfirmCancel_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Без збереження" Height="34" Padding="12,0" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand" Click="CloseConfirmWithoutSave_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                        </Button>
                        <Button Content="Зберегти та закрити" Height="34" Padding="14,0" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" Click="CloseConfirmSaveAndClose_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 2: БІЧНА ПАНЕЛЬ ОБГОВОРЕННЯ ТА НОТАТОК (DISCUSSION DRAWER)           -->
        <!-- ========================================================================= -->
        <Border x:Name="DiscussionDrawer"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="320"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1,0,0,0"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="-4" Opacity="0.10"/></Border.Effect>
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="💬 Обговорення та нотатки" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="CloseDiscussionDrawer_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <TextBox Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" Background="#F8FAFC" BorderBrush="#E2E8F0" Padding="10" FontSize="12.5" Text="Введіть навчальні завдання, домашню роботу або примітки до уроку..."/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- БЛОК 3: КОНСТРУКТОР ДРОБІВ (FRACTIONS CONSTRUCTOR MODAL)                  -->
        <!-- ========================================================================= -->
        <Border x:Name="FractionModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="22,18"
                Width="420"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="5" Opacity="0.14"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Конструктор дробів" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="CloseFractionModal_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ціла частина:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="FractionWholeBox" Height="36" FontSize="16" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="FractionInput_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Чисельник:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="FractionNumeratorBox" Text="1" Height="36" FontSize="16" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="FractionInput_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Знаменник:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="FractionDenominatorBox" Text="2" Height="36" FontSize="16" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" TextChanged="FractionInput_TextChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Попередній вигляд:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16" MinHeight="60">
                    <TextBlock x:Name="FractionPreviewBlock" Text="1 / 2" FontSize="22" FontWeight="Bold" FontFamily="Cambria Math, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Button Content="Вставити дріб на аркуш" Height="36" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" Click="InsertFractionBtn_Click"/>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- МОДАЛЬНЕ ВІКНО ОБЧИСЛЕННЯ В СТОВПЧИК (COLUMN ARITHMETIC MODAL)            -->
        <!-- ========================================================================= -->
        <Border x:Name="ColumnArithmeticModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24,20"
                Width="460"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.14"/>
            </Border.Effect>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="+14" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                        </Border>
                        <TextBlock Text="Дія в стовпчик" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="CloseColumnModal_Click" ToolTip="Закрити">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <TextBlock Text="Оберіть математичну дію:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                    <Button x:Name="ColOpAddBtn" Content="➕ Додати" Style="{StaticResource VseosvitaTopActionBtn}" Click="ColOpSelect_Click" Tag="Add" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,4,0"/>
                    <Button x:Name="ColOpSubBtn" Content="➖ Відняти" Style="{StaticResource VseosvitaTopActionBtn}" Click="ColOpSelect_Click" Tag="Sub" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,4,0"/>
                    <Button x:Name="ColOpMulBtn" Content="✖️ Помножити" Style="{StaticResource VseosvitaTopActionBtn}" Click="ColOpSelect_Click" Tag="Mul" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,4,0"/>
                    <Button x:Name="ColOpDivBtn" Content="➗ Поділити" Style="{StaticResource VseosvitaTopActionBtn}" Click="ColOpSelect_Click" Tag="Div" FontWeight="Bold" Foreground="#9333EA"/>
                </UniformGrid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Перше число:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox x:Name="ColumnNum1Box" Height="40" FontSize="18" FontWeight="Bold" FontFamily="Consolas, Segoe UI" TextAlignment="Right" Padding="10,6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalContentAlignment="Center" TextChanged="ColumnInput_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Друге число:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <TextBox x:Name="ColumnNum2Box" Height="40" FontSize="18" FontWeight="Bold" FontFamily="Consolas, Segoe UI" TextAlignment="Right" Padding="10,6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalContentAlignment="Center" TextChanged="ColumnInput_TextChanged"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ColumnIncludeAnswerCheck" Content="Обчислити та показати результат" IsChecked="True" FontSize="12" Foreground="#334155" Cursor="Hand" Margin="0,0,0,14" Checked="ColumnAnswerCheck_Changed" Unchecked="ColumnAnswerCheck_Changed"/>

                <TextBlock Text="Попередній вигляд у зошиті:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,18" MinHeight="90">
                    <TextBlock x:Name="ColumnPreviewBlock"
                               Text="  345&#x0a;+ 128&#x0a;—————&#x0a;  473"
                               FontSize="22"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Grid>
                    <Button Content="Очистити" Style="{StaticResource VseosvitaTopActionBtn}" HorizontalAlignment="Left" Click="ClearColumnInputs_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Height="36" Width="90" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand" Click="CloseColumnModal_Click">
                            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                        </Button>
                        <Button x:Name="InsertColumnModalBtn" Content="Вставити у зошит" Height="36" Padding="18,0" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand" Click="InsertColumnModalBtn_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- БОКОВАЯ ПАНЕЛЬ МЕНЕДЖЕРА АРКУШІВ (SHEETS MANAGER DRAWER)                  -->
        <!-- ========================================================================= -->
        <Border x:Name="SheetsManagerDrawer"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="280"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1,0,0,0"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="-4" Opacity="0.10"/></Border.Effect>
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Аркуші дошки" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="CloseSheetsDrawer_Click" ToolTip="Закрити">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Список аркушів -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SheetsListDrawerContainer"/>
                </ScrollViewer>

                <!-- Кнопка додати новий аркуш -->
                <Button Grid.Row="2" Height="36" Background="#F0FDF4" BorderBrush="#4F46E5" BorderThickness="1.5" Cursor="Hand" Click="AddBoardBtn_Click" Margin="0,10,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 12,4 V 20 M 4,12 H 20" Stroke="#4F46E5" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Новий аркуш" FontSize="12" FontWeight="Bold" Foreground="#4F46E5"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ФЛАЙАУТ: СПІЛЬНИЙ ДОСТУП / УЧАСНИКИ УРОКУ                                 -->
        <!-- ========================================================================= -->
        <Border x:Name="ParticipantsFlyout"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,54,60,0"
                Background="#FFFFFF"
                CornerRadius="14"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="16,14"
                Width="280"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Учасники онлайн" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="CloseParticipantsFlyout_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <Border Background="#F0FDF4" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#4F46E5" Margin="0,0,8,0"/>
                        <TextBlock Text="Ви (Вчитель — Організатор)" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Учні онлайн: 0" FontSize="11.5" Foreground="#64748B" Margin="2,0,0,12"/>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ФЛАЙАУТ: ПРОФІЛЬ / КАБІНЕТ ВЧИТЕЛЯ                                        -->
        <!-- ========================================================================= -->
        <Border x:Name="ProfileFlyout"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,94,60,0"
                Background="#FFFFFF"
                CornerRadius="14"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="16,14"
                Width="260"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Кабінет викладача" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="CloseProfileFlyout_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M 19,21 V 19 A 4,4 0 0 0 15,15 H 9 A 4,4 0 0 0 5,19 V 21 M 12,11 A 4,4 0 1 0 12,3 A 4,4 0 1 0 12,11 Z" Stroke="#475569" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Вчитель" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Електронна дошка" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <TextBlock Text="Хмарна автосинхронізація активна" FontSize="11" Foreground="#16A34A" FontWeight="Medium"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- МОДАЛЬНЕ ВІКНО: ДОВІДКА ТА ГАРЯЧІ КЛАВІШІ                                 -->
        <!-- ========================================================================= -->
        <Border x:Name="HelpModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="22,18"
                Width="420"
                SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="6" Opacity="0.14"/></Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Гарячі клавіші та довідка" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="CloseHelpModal_Click">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <UniformGrid Rows="6" Columns="2" Margin="0,0,0,14">
                    <TextBlock Text="I" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3"/>
                    <TextBlock Text="Режим тексту" Foreground="#334155" Margin="0,3"/>
                    <TextBlock Text="V або Esc" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3"/>
                    <TextBlock Text="Вказівник (виділення)" Foreground="#334155" Margin="0,3"/>
                    <TextBlock Text="P" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3"/>
                    <TextBlock Text="Олівець" Foreground="#334155" Margin="0,3"/>
                    <TextBlock Text="H" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3"/>
                    <TextBlock Text="Маркер" Foreground="#334155" Margin="0,3"/>
                    <TextBlock Text="E" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3"/>
                    <TextBlock Text="Гумка" Foreground="#334155" Margin="0,3"/>
                    <TextBlock Text="Ctrl+Z / Ctrl+Y" FontWeight="Bold" Foreground="#4F46E5" Margin="0,3"/>
                    <TextBlock Text="Скасувати / Повторити" Foreground="#334155" Margin="0,3"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- МОДАЛЬНЕ ВІКНО: НАЛАШТУВАННЯ АРКУША ТА ШАБЛОНІВ                           -->
        <!-- ========================================================================= -->
        <Border x:Name="SheetSettingsModal"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="22,18"
                Width="460"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="26" ShadowDepth="6" Opacity="0.14"/>
            </Border.Effect>

            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 12,2 A 10,10 0 0 0 2,12 C 2,16.5 5.5,20 10,20 C 10.8,20 11.5,19.3 11.5,18.5 C 11.5,18.1 11.3,17.7 11.1,17.4 C 10.9,17.1 10.7,16.6 10.7,16 C 10.7,14.9 11.6,14 12.7,14 H 14.5 C 17.5,14 20,11.5 20,8.5 C 20,4.9 16.4,2 12,2 Z"
                              Stroke="#0F172A" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Налаштування аркуша" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="CloseSettingsModal_Click" ToolTip="Закрити">
                        <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="#64748B" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- РАЗДЕЛ 1: ШАБЛОН АРКУША -->
                <TextBlock Text="Шаблон аркуша" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <UniformGrid Rows="1" Columns="5" Margin="0,0,0,16">
                    <Border x:Name="TemplateBlankCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="6" Margin="3" Cursor="Hand" MouseLeftButtonDown="TemplateCard_Click" Tag="Blank">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48" Height="36" Background="#FFFFFF" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            <TextBlock Text="Чистий" FontSize="10.5" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TemplateGridCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="6" Margin="3" Cursor="Hand" MouseLeftButtonDown="TemplateCard_Click" Tag="Grid">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48" Height="36" Background="#FFFFFF" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Path Data="M 0,9 L 48,9 M 0,18 L 48,18 M 0,27 L 48,27 M 12,0 L 12,36 M 24,0 L 24,36 M 36,0 L 36,36" Stroke="#CBD5E1" StrokeThickness="0.6"/>
                            </Border>
                            <TextBlock Text="Клітинка" FontSize="10.5" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TemplateRuledCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="6" Margin="3" Cursor="Hand" MouseLeftButtonDown="TemplateCard_Click" Tag="Ruled">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48" Height="36" Background="#FFFFFF" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Path Data="M 0,9 L 48,9 M 0,18 L 48,18 M 0,27 L 48,27" Stroke="#93C5FD" StrokeThickness="0.8"/>
                            </Border>
                            <TextBlock Text="В лінійку" FontSize="10.5" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TemplateSlantedCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="6" Margin="3" Cursor="Hand" MouseLeftButtonDown="TemplateCard_Click" Tag="Slanted">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48" Height="36" Background="#FFFFFF" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Path Data="M 0,12 L 48,12 M 0,24 L 48,24 M 6,36 L 22,0 M 20,36 L 36,0 M 34,36 L 50,0" Stroke="#93C5FD" StrokeThickness="0.7"/>
                            </Border>
                            <TextBlock Text="Коса лінія" FontSize="10.5" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TemplateMusicCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8" Padding="6" Margin="3" Cursor="Hand" MouseLeftButtonDown="TemplateCard_Click" Tag="Music">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48" Height="36" Background="#FFFFFF" CornerRadius="4" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Path Data="M 0,8 L 48,8 M 0,13 L 48,13 M 0,18 L 48,18 M 0,23 L 48,23 M 0,28 L 48,28" Stroke="#94A3B8" StrokeThickness="0.7"/>
                            </Border>
                            <TextBlock Text="Нотний стан" FontSize="10.5" FontWeight="Medium" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- РАЗДЕЛ 2: КОЛІР АРКУША -->
                <TextBlock Text="Колір аркуша" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border x:Name="ColorWhiteChip" Width="85" Height="34" CornerRadius="8" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="SheetColorChip_Click" Tag="#FFFFFF">
                        <TextBlock Text="Білий" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ColorCreamChip" Width="95" Height="34" CornerRadius="8" Background="#FAF7F0" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="SheetColorChip_Click" Tag="#FAF7F0">
                        <TextBlock Text="Кремовий" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ColorGreenBoardChip" Width="95" Height="34" CornerRadius="8" Background="#163A2B" BorderBrush="#22C55E" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="SheetColorChip_Click" Tag="#163A2B">
                    </Border>
                    <Border x:Name="ColorDarkGraphiteChip" Width="95" Height="34" CornerRadius="8" Background="#18181B" BorderBrush="#52525B" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="SheetColorChip_Click" Tag="#18181B">
                    </Border>
                </StackPanel>

                <!-- РАЗДЕЛ 3: ШКІЛЬНИЙ ЗАГОЛОВОК -->
                <TextBlock Text="Шкільний заголовок" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="HeaderToggleCheckBox" Content="Показати дату та тему роботи на аркуші" FontSize="12" FontWeight="Medium" Foreground="#0F172A" Cursor="Hand" Click="HeaderToggleCheckBox_Click"/>
                        <TextBlock Text="Відображає каліграфічний напис «27 жовтня» та «Класна робота» у центрі аркуша" FontSize="11" Foreground="#64748B" Margin="20,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- РАЗДЕЛ 4: ПОЛЯ ТА ГЕОМЕТРІЯ АРКУША -->
                <TextBlock Text="Геометрія та поля аркуша" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
                    <Button Content="Зліва" Style="{StaticResource VseosvitaTopActionBtn}" Click="SheetMarginLeftBtn_Click" ToolTip="Червоне поле зліва (НУШ)"/>
                    <Button Content="Справа" Style="{StaticResource VseosvitaTopActionBtn}" Click="SheetMarginRightBtn_Click" ToolTip="Поле справа"/>
                    <Button Content="Без полів" Style="{StaticResource VseosvitaTopActionBtn}" Click="SheetMarginNoneBtn_Click" ToolTip="Без полів (формат А4)"/>
                    <Button Content="Безмежна" Style="{StaticResource VseosvitaTopActionBtn}" Click="SheetMarginLargeBtn_Click" ToolTip="Велика розширена дошка"/>
                </UniformGrid>

                <!-- РАЗДЕЛ 5: МОВА ДОШКИ -->
                <TextBlock Text="Мова навчального матеріалу" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <UniformGrid Rows="1" Columns="2">
                    <Button Content="🇺🇦 Українська (НУШ)" Style="{StaticResource VseosvitaTopActionBtn}" FontWeight="Bold" Click="BoardLangUkBtn_Click"/>
                    <Button Content="🇬🇧 English (IPA)" Style="{StaticResource VseosvitaTopActionBtn}" FontWeight="Bold" Click="BoardLangEnBtn_Click"/>
                </UniformGrid>
            </StackPanel>
        </Border>



        <!-- Скрытые элементы для совместимости с кодом C# -->
                <Button x:Name="ExportBoardBtn" Visibility="Collapsed" Click="ExportBoardBtn_Click"/>
                <Button x:Name="MathSymbolsTopBtn" Visibility="Collapsed" Click="MathSymbolsTopBtn_Click"/>
        <Popup x:Name="MathSymbolsPopup" Visibility="Collapsed"><WrapPanel x:Name="MathSymbolsGrid"/></Popup>
        <Button x:Name="TimerTopBtn" Visibility="Collapsed" Click="TimerTopBtn_Click"/>
        <TextBlock x:Name="TimerTopLabel" Visibility="Collapsed"/>
        
        <!-- ПЛАВАЮЧИЙ ТАЙМЕР УРОКУ (FLOATING LESSON TIMER) -->
        <!-- ІНТЕРАКТИВНИЙ ТАЙМЕР УРОКУ (LESSON TIMER WIDGET) -->
        <Border x:Name="LessonTimerWidget"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,55,20,0"
                Width="240"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed"
                PreviewMouseLeftButtonDown="LessonTimerWidget_PreviewMouseLeftButtonDown"
                PreviewMouseMove="LessonTimerWidget_PreviewMouseMove"
                PreviewMouseLeftButtonUp="LessonTimerWidget_PreviewMouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TimerTranslateTransform"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таймера -->
                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="11,11,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Cursor="SizeAll">
                    <Grid Margin="12,0">
                        <TextBlock Text="⏱️ Таймер уроку" FontWeight="SemiBold" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                Cursor="Hand" Click="CloseTimerWidget_Click" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Цифрове табло -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,10">
                    <TextBlock x:Name="TimerDisplayBlock"
                               Text="05:00"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопки швидкого додавання хвилин -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button Content="+1 хв" Tag="1" Height="26" Padding="8,0" Margin="2,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="TimerPreset_Click"/>
                    <Button Content="+5 хв" Tag="5" Height="26" Padding="8,0" Margin="2,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="TimerPreset_Click"/>
                    <Button Content="+10 хв" Tag="10" Height="26" Padding="8,0" Margin="2,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="TimerPreset_Click"/>
                </StackPanel>

                <!-- Кнопки керування -->
                <Grid Grid.Row="3" Margin="12,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TimerStartPauseBtn" Grid.Column="0" Content="▶ Старт"
                            Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Height="30" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0"
                            Click="TimerStartPause_Click"/>
                    <Button Grid.Column="1" Content="Скинути"
                            Background="#F1F5F9" Foreground="#475569" FontWeight="Medium"
                            Height="30" Margin="4,0,0,0" Cursor="Hand" BorderThickness="0"
                            Click="TimerReset_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="PresentationOverlayGrid"
              Background="#0B0F19"
              Visibility="Collapsed"
              Focusable="True"
              KeyDown="PresentationOverlayGrid_KeyDown"
              PreviewMouseWheel="PresentationOverlayGrid_MouseWheel">

            <!-- Центральне поле: Зображення слайда з ідеальним Aspect Ratio та помітки -->
            <Grid Margin="40,68,40,78" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="SlideOuterCard"
                        CornerRadius="12"
                        Background="#FFFFFF"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="8" Opacity="0.45"/>
                    </Border.Effect>
                    <Viewbox x:Name="SlideViewbox" Stretch="Uniform">
                        <Grid x:Name="SlideCanvasContainer" Background="#FFFFFF">
                            <Image x:Name="SlideDisplayImage" Stretch="Fill"/>
                            <InkCanvas x:Name="SlideInkCanvas" Background="Transparent"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- Бокові круглі стрілки для тач-скринів та дошок -->
                <Button Style="{StaticResource VseosvitaTopActionBtn}"
                        Width="44" Height="44" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="-22,0,0,0" Background="#FFFFFF"
                        Click="SlideshowPrevBtn_Click" ToolTip="Попередній слайд">
                    <Button.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25"/></Button.Effect>
                    <Path Data="M 15,18 L 9,12 L 15,6" Stroke="#334155" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                </Button>

                <Button Style="{StaticResource VseosvitaTopActionBtn}"
                        Width="44" Height="44" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,-22,0" Background="#FFFFFF"
                        Click="SlideshowNextBtn_Click" ToolTip="Наступний слайд">
                    <Button.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.25"/></Button.Effect>
                    <Path Data="M 9,18 L 15,12 L 9,6" Stroke="#334155" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- Верхня навігаційна панель слайд-шоу (Floating Capsule) -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="6,4"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.22"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Назва презентації -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="9,4" Margin="2,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 14,2 H 6 C 4.9,2 4,2.9 4,4 V 20 C 4,21.1 4.9,22 6,22 H 18 C 19.1,22 20,21.1 20,20 V 8 Z M 13,3.5 L 18.5,9 H 13 Z M 8,13 H 16 M 8,17 H 13"
                                  Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PresentationTitleText" Text="Презентація" MaxWidth="280"
                                       TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Border>

                    <!-- Стрілка назад [ ◀ ] -->
                    <Button x:Name="SlideshowPrevBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="32" Height="30" Padding="0" Click="SlideshowPrevBtn_Click" ToolTip="Попередній слайд (← / Коліщатко)">
                        <Path Data="M 15,18 L 9,12 L 15,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>

                    <!-- Лічильник слайдів -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12,0" Height="30" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SlideCounterText" Text="Слайд 1 з 1" Foreground="#0F172A" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Стрілка вперед [ ▶ ] -->
                    <Button x:Name="SlideshowNextBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="32" Height="30" Padding="0" Click="SlideshowNextBtn_Click" ToolTip="Наступний слайд (→ / Коліщатко)">
                        <Path Data="M 9,18 L 15,12 L 9,6" Stroke="#334155" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Кнопка: Сітка всіх слайдів (▦) -->
                    <Button Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="30" Padding="8,0" Click="SlidesGridBtn_Click" ToolTip="Огляд усіх слайдів (G)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z"
                                  Stroke="#475569" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Всі слайди" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Пауза уваги / Затемнення (B) -->
                    <Button x:Name="SlideBlackoutBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="30" Padding="8,0" Click="SlideBlackoutBtn_Click" ToolTip="Пауза уваги / Затемнити екран (B)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 2,12 C 4,7 8,4 12,4 C 16,4 20,7 22,12 C 20,17 16,20 12,20 C 8,20 4,17 2,12 Z M 12,15 A 3,3 0 1 0 12,9 A 3,3 0 0 0 12,15 Z"
                                  Stroke="#475569" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Пауза" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Кнопка: Таймер на слайді (⏱️) -->
                    <Button Style="{StaticResource VseosvitaTopActionBtn}"
                            Width="30" Height="30" Padding="0" Click="SlideTimerToggleBtn_Click" ToolTip="Таймер вправи на слайді">
                        <Path Data="M 12,22 A 9,9 0 1 0 12,4 A 9,9 0 0 0 12,22 Z M 12,6 V 12 L 16,14 M 9,1 H 15"
                              Stroke="#475569" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="#E2E8F0" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Кнопка виходу з повноекранного режиму -->
                    <Button x:Name="SlideshowExitBtn" Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="30" Padding="10,0" Margin="2,0" Click="SlideshowExitBtn_Click" ToolTip="Вийти з повноекранного режиму (Esc)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Вийти (Esc)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Нижня панель інструментів презентатора (Luma Floating Bottom Capsule) -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Background="#FFFFFF"
                    CornerRadius="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="8,4"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Перо -->
                    <RadioButton x:Name="SlideToolPen"
                                 Style="{StaticResource SlideshowToolbarRadioBtn}"
                                 IsChecked="True"
                                 GroupName="SlideTools"
                                 Checked="SlideToolPen_Checked"
                                 ToolTip="Перо">
                        <Path Data="M 17,3 A 2.828,2.828 0 1 1 21,7 L 7.5,20.5 L 2,22 L 3.5,16.5 L 17,3 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <!-- 2. Виділювач -->
                    <RadioButton x:Name="SlideToolHighlighter"
                                 Style="{StaticResource SlideshowToolbarRadioBtn}"
                                 GroupName="SlideTools"
                                 Checked="SlideToolHighlighter_Checked"
                                 ToolTip="Виділювач / Маркер">
                        <Path Data="M 16.5,3.5 L 20.5,7.5 L 8.5,19.5 L 4.5,19.5 L 4.5,15.5 Z M 2,22 L 7,22"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <!-- 3. Лазер -->
                    <RadioButton x:Name="SlideToolLaser"
                                 Style="{StaticResource SlideshowToolbarRadioBtn}"
                                 GroupName="SlideTools"
                                 Checked="SlideToolLaser_Checked"
                                 ToolTip="Лазерна указка">
                        <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 0 0 12,2 Z M 12,6 A 6,6 0 1 1 12,18 A 6,6 0 0 1 12,6 Z M 12,10 A 2,2 0 1 0 12,14 A 2,2 0 0 0 12,10 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <!-- 4. Гумка -->
                    <RadioButton x:Name="SlideToolEraser"
                                 Style="{StaticResource SlideshowToolbarRadioBtn}"
                                 GroupName="SlideTools"
                                 Checked="SlideToolEraser_Checked"
                                 ToolTip="Гумка (ластик)">
                        <Path Data="M 18,14 L 11,21 L 2,12 L 9,5 Z M 18,14 L 14,10 M 7,17 L 18,17"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>

                    <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="6,0" VerticalAlignment="Center"/>

                    <!-- Кольори (круглі фішки як у Luma) -->
                    <Button Style="{StaticResource SlideshowColorChipBtn}" Background="#1E293B" Click="SlideColorDark_Click" ToolTip="Темний графіт"/>
                    <Button Style="{StaticResource SlideshowColorChipBtn}" Background="#4F46E5" Click="SlideColorIndigo_Click" ToolTip="Індиго"/>
                    <Button Style="{StaticResource SlideshowColorChipBtn}" Background="#EF4444" Click="SlideColorRed_Click" ToolTip="Червоний"/>
                    <Button Style="{StaticResource SlideshowColorChipBtn}" Background="#16A34A" Click="SlideColorGreen_Click" ToolTip="Зелений"/>
                    <Button Style="{StaticResource SlideshowColorChipBtn}" Background="#EAB308" Click="SlideColorYellow_Click" ToolTip="Жовтий"/>
                    <Button Style="{StaticResource SlideshowColorChipBtn}" Background="#FFFFFF" Click="SlideColorWhite_Click" ToolTip="Білий"/>

                    <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="6,0" VerticalAlignment="Center"/>

                    <!-- Масштабування слайда (Zoom) -->
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="28" Height="30" Padding="0" Click="SlideZoomOut_Click" ToolTip="Зменшити масштаб (Ctrl + -)">
                        <Path Data="M 5,12 H 19" Stroke="#475569" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="SlideZoomReset_Click" ToolTip="Скинути до 100%">
                        <TextBlock x:Name="SlideZoomText" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="28" Height="30" Padding="0" Click="SlideZoomIn_Click" ToolTip="Збільшити масштаб (Ctrl + +)">
                        <Path Data="M 12,5 V 19 M 5,12 H 19" Stroke="#475569" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="6,0" VerticalAlignment="Center"/>

                    <!-- Очистити помітки -->
                    <Button Style="{StaticResource VseosvitaTopActionBtn}"
                            Height="32" Padding="10,0" Margin="2,0"
                            Click="SlideClearAnnotationsBtn_Click"
                            ToolTip="Очистити помітки поточного слайда">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,6 H 21 M 8,6 V 4 A 1,1 0 0 1 9,3 H 15 A 1,1 0 0 1 16,4 V 6 M 19,6 V 19 A 2,2 0 0 1 17,21 H 7 A 2,2 0 0 1 5,19 V 6"
                                  Stroke="#64748B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Очистити" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        
            <!-- ПАУЗА УВАГИ (BLACKOUT OVERLAY) -->
            <Border x:Name="SlideBlackoutOverlay"
                    Background="#000000"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    MouseLeftButtonDown="SlideBlackoutOverlay_Click">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 0 0 12,2 Z M 12,6 A 6,6 0 1 1 12,18 A 6,6 0 0 1 12,6 Z"
                          Fill="#475569" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Увага на викладача ✨" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Натисніть у будь-якому місці екрана або клавішу B, щоб продовжити" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- МІНІ-ТАЙМЕР НА СЛАЙДІ (FLOATING EXERCISE TIMER) -->
            <Border x:Name="SlideMiniTimerCard"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,78,28,0"
                    Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="14,10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel Width="170">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock x:Name="SlideMiniTimerText" Text="03:00" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="SlideMiniTimerStartBtn" Style="{StaticResource VseosvitaTopActionBtn}" Width="30" Height="28" Padding="0" Click="SlideMiniTimerStart_Click" ToolTip="Старт / Пауза">
                            <Path x:Name="SlideMiniTimerStartIcon" Data="M 8,5 V 19 L 19,12 Z" Fill="#16A34A" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource VseosvitaTopActionBtn}" Height="28" Padding="6,0" Click="SlideMiniTimerAddMinute_Click" ToolTip="+1 хвилина">
                            <TextBlock Text="+1 хв" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                        </Button>
                        <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="28" Height="28" Padding="0" Click="SlideMiniTimerReset_Click" ToolTip="Скинути">
                            <Path Data="M 1,4 V 10 H 7 M 23,20 V 14 H 17 M 20.49,9 A 9,9 0 0 0 5.64,5.64 L 1,10 M 23,14 L 18.36,18.36 A 9,9 0 0 1 3.51,15"
                                  Stroke="#64748B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="26" Height="28" Padding="0" Click="SlideMiniTimerClose_Click" ToolTip="Сховати таймер">
                            <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Stroke="#94A3B8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- МОДАЛЬНЕ ВІКНО: СІТКА ВСІХ СЛАЙДІВ (THUMBNAIL OVERVIEW MODAL) -->
            <Border x:Name="SlidesOverviewModal"
                    Visibility="Collapsed"
                    Background="#CC0B0F19"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MouseLeftButtonDown="SlidesOverviewModal_BackdropClick">
                <Border Background="#FFFFFF"
                        CornerRadius="16"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Width="920"
                        MaxHeight="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,20"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonDown="SlidesOverviewCard_Click">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.30"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок сетки -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EEF2FF" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                    <Path Data="M 3,3 H 9 V 9 H 3 Z M 15,3 H 21 V 9 H 15 Z M 3,15 H 9 V 21 H 3 Z M 15,15 H 21 V 21 H 15 Z"
                                          Stroke="#4F46E5" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Огляд усіх слайдів презентації" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SlidesOverviewCountText" Text=" (16 слайдів)" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Style="{StaticResource VseosvitaTopActionBtn}" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" Click="SlidesOverviewClose_Click" ToolTip="Закрити огляд (Esc)">
                                <Path Data="M 4,4 L 14,14 M 14,4 L 4,14" Stroke="#64748B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Скролл з плитками слайдів -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="SlidesOverviewGridContainer" HorizontalAlignment="Center"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>

        </Grid>

        <ToggleButton x:Name="AiRecognitionToggle" Visibility="Collapsed" Click="AiRecognitionToggle_Click"/>
        <Button x:Name="RecognizeNowBtn" Visibility="Collapsed" Click="RecognizeNowBtn_Click"/>

    </Grid>
</UserControl>