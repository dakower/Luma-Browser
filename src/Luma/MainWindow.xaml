      <Style x:Key="LumaMenuItem" TargetType="MenuItem">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="#EEE9F2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#8B8691" FontSize="11" VerticalAlignment="Center" Margin="18,0,2,0"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#1FFFFFFF"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value=".38"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LumaSeparator" TargetType="Separator">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="#1FFFFFFF" Margin="7,5"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="RootShell" Background="#0B0912" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============ TITLEBAR ============ -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TopBrush}" BorderBrush="#1C1828" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
      <Grid>

        <!-- navigation cluster -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="TopMenuButton" Style="{StaticResource TopMenuGlowButton}" Width="26" Height="26" Margin="0,0,8,0" Click="MainMenu_Click" ToolTip="Меню Luma">
            <Image Source="Assets/luma-mark.png" Width="18" Height="18" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,6,0" Click="ToggleSidebar_Click" ToolTip="Боковая панель">
            <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconSidebar}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round"/>
          </Button>
          <Button x:Name="BackButton" Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,6,0" Click="Back_Click" ToolTip="Назад">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconChevronLeft}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="ForwardButton" Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,6,0" Click="Forward_Click" ToolTip="Вперёд">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconChevronRight}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="26" Height="26" Click="Reload_Click" ToolTip="Обновить">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconReload}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>

        <!-- address pill -->
        <Border Height="34" CornerRadius="17" MaxWidth="480" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="7,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Left: Copy URL button -->
            <Button x:Name="CopyUrlButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="1,0,8,0" Click="CopyUrl_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Скопировать адрес">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconCopy}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>

            <!-- Center: Domain/Title Pill -->
            <Border x:Name="DomainPill" Background="Transparent" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="DomainPill_Click" VerticalAlignment="Center">
              <TextBlock x:Name="DomainText" Text="Новая вкладка" Foreground="{DynamicResource ChromeText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" FontWeight="SemiBold" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>

            <!-- Right: Action tools cluster -->
            <Button x:Name="TranslateButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="0,0,4,0" Click="TranslateButton_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Перевести страницу">
              <Path x:Name="TranslateIcon" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconGlobe}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="SplitButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="0,0,4,0" Click="SplitButton_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Split View">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconSplit}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Button>
            <Button x:Name="SiteSettingsButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="0,0,1,0" Click="SiteSettings_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Параметры сайта">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconSlidersHorizontal}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- window controls -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
          <Border x:Name="NowPlayingWidget" Visibility="Collapsed" Height="34" MinWidth="190" MaxWidth="260" Padding="5,0,6,0" Margin="0,0,10,0" CornerRadius="17" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NowPlayingWidget_Click" ToolTip="Открыть медиаплеер">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="26"/>
              </Grid.ColumnDefinitions>
              <Grid Width="24" Height="24">
                <Border CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                <Path x:Name="NowPlayingPillFallbackIcon" Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconMusicNote}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="NowPlayingPillArt" Visibility="Collapsed" Stretch="UniformToFill">
                  <Image.Clip>
                    <RectangleGeometry Rect="0,0,24,24" RadiusX="12" RadiusY="12"/>
                  </Image.Clip>
                </Image>
              </Grid>
              <StackPanel Grid.Column="1" Margin="8,0,7,0" VerticalAlignment="Center">
                <TextBlock x:Name="NowPlayingPillTitle" Foreground="#F6F2FA" FontSize="11.5" FontWeight="Bold" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NowPlayingPillArtist" Foreground="#948AA1" FontSize="9" FontWeight="SemiBold" MaxWidth="150" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
              <Grid Grid.Column="2" Width="24" Height="24">
                <Border CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                <Path x:Name="NowPlayingToggleIcon" Width="9" Height="9" Stretch="Uniform" Data="{StaticResource IconPause}" Fill="Transparent" Stroke="#F7F3FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Style="{StaticResource BareIconButton}" Width="24" Height="24" Background="Transparent" Click="NowPlayingToggle_Click" ToolTip="Воспроизведение / пауза"/>
              </Grid>
            </Grid>
          </Border>
          <Button x:Name="DownloadButton" Style="{StaticResource BareIconButton}" Width="28" Height="28" Margin="0,0,8,0" Click="Downloads_Click" ToolTip="Загрузки">
            <Grid Width="28" Height="28">
              <Path x:Name="DownloadIdleIcon" Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconDownload}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Grid x:Name="DownloadActivityIndicator" Width="22" Height="22" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Margin="1" Stroke="{DynamicResource AccentSoftBrush}" StrokeThickness="2" Opacity=".75"/>
                <Grid Width="22" Height="22" RenderTransformOrigin=".5,.5">
                  <Grid.RenderTransform>
                    <RotateTransform x:Name="DownloadActivityRotate"/>
                  </Grid.RenderTransform>
                  <Path Data="M 11 1 A 10 10 0 0 1 21 11" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
              </Grid>
              <Border x:Name="DownloadBadge" Visibility="Collapsed" MinWidth="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource TopBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                <TextBlock x:Name="DownloadBadgeText" Text="1" Foreground="White" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2.5,0"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="AssistantButton" Style="{StaticResource AssistantPill}" Margin="0,0,10,0" Click="Assistant_Click" ToolTip="Открыть LumaAI (Ctrl+J)">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,7,0">
                <Image Source="Assets/luma-assistant.png" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="LumaAI" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="2,0,8,0" VerticalAlignment="Center"/>
          <Button Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,5,0" Click="MinimizeWindow_Click" ToolTip="Свернуть">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconMinus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,5,0" Click="MaximizeWindow_Click" ToolTip="Развернуть">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconSquare}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round"/>
          </Button>
          <Button Style="{StaticResource WindowCloseButton}" Width="26" Height="26" Click="CloseWindow_Click" ToolTip="Закрыть">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconX}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="NowPlayingTray" Grid.Row="1" Height="0" Visibility="Collapsed" Opacity="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18131F"/><GradientStop Color="#100D15" Offset=".72"/><GradientStop Color="#171523" Offset="1"/></LinearGradientBrush></Border.Background>
      <Border.RenderTransform><TranslateTransform x:Name="NowPlayingTrayTranslate" Y="-16"/></Border.RenderTransform>
      <Grid MaxWidth="1220" Margin="30,18" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <Grid Width="92" Height="92" HorizontalAlignment="Left" VerticalAlignment="Center"><Border CornerRadius="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity=".28"/></Border.Effect></Border><Path x:Name="NowPlayingPopupFallbackIcon" Width="34" Height="34" Stretch="Uniform" Data="{StaticResource IconMusicNote}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="NowPlayingArt" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,92,92" RadiusX="23" RadiusY="23"/></Image.Clip></Image></Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,28,0"><TextBlock Text="Сейчас играет" Foreground="#A79CAF" FontSize="10.5" FontWeight="SemiBold"/><TextBlock x:Name="NowPlayingPopupTitle" Foreground="#FAF7FC" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock x:Name="NowPlayingPopupArtist" Foreground="#AAA0B3" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="NowPlayingPos" Text="0:00" Foreground="#918798" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid x:Name="SeekTrack" Grid.Column="1" Height="20" Margin="8,0" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="SeekTrack_MouseDown" MouseMove="SeekTrack_MouseMove" MouseLeftButtonUp="SeekTrack_MouseUp"><Border Height="5" CornerRadius="3" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center"/><Border x:Name="SeekFill" Height="5" CornerRadius="3" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"/><Ellipse x:Name="SeekThumb" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity=".45"/></Ellipse.Effect></Ellipse></Grid><TextBlock x:Name="NowPlayingDur" Grid.Column="2" Text="0:00" Foreground="#918798" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/></Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,10"><Button Style="{StaticResource BareIconButton}" Width="42" Height="42" Margin="0,0,18,0" Click="NowPlayingPrev_Click"><Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconSkipBack}" Fill="Transparent" Stroke="#B8AEC1" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button><Grid Width="52" Height="52"><Border CornerRadius="26" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity=".28"/></Border.Effect></Border><Path x:Name="NowPlayingToggleIconPopup" Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconPause}" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource BareIconButton}" Width="52" Height="52" Background="Transparent" Click="NowPlayingToggle_Click" ToolTip="Воспроизведение / пауза"/></Grid><Button Style="{StaticResource BareIconButton}" Width="42" Height="42" Margin="18,0,0,0" Click="NowPlayingNext_Click"><Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconSkipNext}" Fill="Transparent" Stroke="#B8AEC1" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button></StackPanel>
          <Grid Grid.Row="2" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconVolume}" Stroke="#9E94A8" StrokeThickness="1.8" VerticalAlignment="Center"/><Grid x:Name="VolumeTrack" Grid.Column="1" Width="150" Height="18" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="VolumeTrack_MouseDown" MouseMove="VolumeTrack_MouseMove" MouseLeftButtonUp="VolumeTrack_MouseUp"><Border Height="5" CornerRadius="3" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center"/><Border x:Name="VolumeFill" Height="5" CornerRadius="3" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"/><Ellipse x:Name="VolumeThumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Grid>
        </Grid>
        <Button Grid.Column="3" Style="{StaticResource BareIconButton}" Width="34" Height="34" VerticalAlignment="Top" Click="NowPlayingTrayClose_Click" ToolTip="Свернуть"><Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconChevronUp}" Stroke="#A79DAF" StrokeThickness="2"/></Button>
      </Grid>
    </Border>

    <!-- ============ BODY ============ -->
    <Grid x:Name="BodyGrid" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="270"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="AssistantColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="Sidebar" Grid.Column="0" Panel.ZIndex="20" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" MouseLeave="Sidebar_MouseLeave" MouseEnter="Sidebar_MouseEnterOverlay" ClipToBounds="True">
        <Grid>
          <!-- Subtle one-pixel theme rail from the approved minimal reference. -->
          <Rectangle x:Name="SidebarNeon" Width="1" Opacity="0" HorizontalAlignment="Left" Panel.ZIndex="4" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000"/><GradientStop Color="#00000000" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Grid Margin="12,12,10,11">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="3,2,3,8" Background="Transparent">
              <StackPanel x:Name="SpaceContentRoot" MinWidth="226" RenderTransformOrigin=".5,.5"><StackPanel.RenderTransform><TranslateTransform x:Name="SpaceContentTranslate"/></StackPanel.RenderTransform>
                <!-- real Luma brand card -->
                <Border CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,9">
                  <Grid Height="32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Image Source="Assets/luma-mark.png" Width="24" Height="24" Stretch="Uniform"/></Border>
                    <TextBlock Grid.Column="1" Text="Luma" FontSize="14.5" FontWeight="Bold" Foreground="#FAF7FF" VerticalAlignment="Center" Margin="9,1,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource BareIconButton}" Width="28" Height="28" Click="History_Click" ToolTip="История"><Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconHistory}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                    <Button Grid.Column="3" Style="{StaticResource BareIconButton}" Width="28" Height="28" Click="Settings_Click" ToolTip="Настройки"><Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconGear}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/></Button>
                  </Grid>
                </Border>

                <!-- compact command/search row; it opens the existing deterministic launcher -->
                <Button Style="{StaticResource SidebarButton}" Height="38" Padding="0" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="TabSearch_Click" ToolTip="Поиск по открытым вкладкам (Ctrl+K)">
                  <Border HorizontalAlignment="Stretch" CornerRadius="8" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                      <Path Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconSearch}" Stroke="{DynamicResource ChromeMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <TextBlock Grid.Column="1" Text="Поиск по вкладкам" Foreground="{DynamicResource ChromeMuted}" FontSize="12" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl K" Foreground="{DynamicResource ChromeMuted}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                  </Border>
                </Button>

                <!-- spaces -->
                <Border Margin="1,15,1,0" Padding="7,5" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"><Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                  <ItemsControl x:Name="ProfileAvatars" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="34" Height="34" Margin="0,0,5,0" Background="Transparent" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Name}" AllowDrop="True" Drop="SpaceDot_Drop" PreviewMouseLeftButtonDown="ProfileAvatar_MouseDown" MouseLeftButtonUp="ProfileAvatar_Click" MouseRightButtonUp="ProfileAvatar_MouseRightButtonUp">
                          <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="1.5"/>
                          <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Brush}"><TextBlock Text="{Binding Letter}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid x:Name="AvatarAddButton" Grid.Column="1" Width="28" Height="28" Background="Transparent" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="Добавить пространство" PreviewMouseLeftButtonDown="AvatarAdd_MouseDown" MouseLeftButtonUp="AvatarAdd_Click">
                    <Path Stretch="Uniform" Width="12" Height="12" Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                  </Grid>
                </Grid></Border>

                <!-- pinned -->
                <StackPanel Margin="1,20,1,0">
                  <Grid Height="20"><TextBlock Text="ЗАКРЕПЛЁННЫЕ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ChromeMuted}" VerticalAlignment="Center"/></Grid>
                  <Border x:Name="PinnedContainer" ClipToBounds="True" Margin="0,7,0,0"><StackPanel x:Name="LooseItemsHost"/></Border>
                </StackPanel>

                <!-- animated folders -->
                <StackPanel Margin="1,13,1,0"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
                  <Grid Height="24" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="FoldersHeader_Click">
                    <Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Image x:Name="FoldersHeaderIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="ПАПКИ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ChromeMuted}" VerticalAlignment="Center" Margin="25,0,0,0"/>
                    <Button Style="{StaticResource BareIconButton}" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,6,0" Click="NewFolder_Click" ToolTip="Новая папка">
                      <Image x:Name="AddFolderIcon" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                  </Grid>
                  <Border x:Name="FoldersContainer" ClipToBounds="True" Margin="0,6,0,0"><StackPanel x:Name="FoldersHost"/></Border>
                </StackPanel>

                <!-- tabs -->
                <StackPanel Margin="1,13,1,9"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
                  <Grid Height="24" Background="Transparent">
                    <TextBlock Text="ВКЛАДКИ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ChromeMuted}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BareIconButton}" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,6,0" Click="NewTab_Click" ToolTip="Новая вкладка"><Path Stretch="Uniform" Width="12" Height="12" Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                  </Grid>
                  <Border x:Name="TabsListContainer" ClipToBounds="True" Margin="0,6,0,0">
                    <ListBox x:Name="TabsList" ItemsSource="{Binding Tabs}" SelectionChanged="TabsList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" MouseMove="Tab_MouseMove" MouseRightButtonUp="Tab_MouseRightButtonUp" MouseUp="Tab_MouseUp" Background="Transparent">
                            <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsAsleep}" Value="True"><Setter Property="Opacity" Value="0.62"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Left" ClipToBounds="True"><Image Source="{Binding FaviconUrl}" Width="14" Height="14"/></Border>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Foreground}" FontWeight="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=FontWeight}"/>
                            <Button Grid.Column="2" Tag="{Binding}" Click="CloseTab_Click" Style="{StaticResource TabCloseButton}" Width="18" Height="18" ToolTip="Закрыть"><Path Width="9" Height="9" Stretch="Uniform" Data="{StaticResource IconX}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- account card remains fixed at the bottom of the rail -->
            <Button Grid.Row="1" Style="{StaticResource SidebarButton}" Height="58" Padding="0" Margin="3,8,3,0" Click="Account_Click" HorizontalContentAlignment="Stretch" ToolTip="Профиль Luma">
              <Border CornerRadius="11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="9,7">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                  <Grid Width="34" Height="34">
                    <Border CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"/>
                    <TextBlock x:Name="SidebarProfileFallback" Text="L" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="SidebarProfileAvatarImage" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="11" RadiusY="11"/></Image.Clip></Image>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="9,0,5,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SidebarProfileName" Text="Аккаунт Luma" Foreground="{DynamicResource ChromeSecondary}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SidebarProfileStatus" Text="Войти или зарегистрироваться" Foreground="{DynamicResource ChromeMuted}" FontSize="9.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Path Stretch="Uniform" Grid.Column="2" Width="11" Height="11" Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource ChromeMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
              </Border>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <Grid x:Name="SiteShell" Grid.Column="1" Background="#F7F5F4" ClipToBounds="True">
        <Grid x:Name="PaneHost" Background="Transparent" ClipToBounds="True"/>
        <Grid x:Name="EmptyBackground" Background="#0D0B12" ClipToBounds="True">
          <Grid.Resources>
            <Style x:Key="AccountInnerText" TargetType="TextBox">
              <Setter Property="Height" Value="54"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FAF8FC"/><Setter Property="CaretBrush" Value="{DynamicResource AccentMutedBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14.5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AccountInnerPassword" TargetType="PasswordBox">
              <Setter Property="Height" Value="54"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FAF8FC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14.5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AccountPrimary" TargetType="Button">
              <Setter Property="Height" Value="54"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBorder" Property="Opacity" Value=".92"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryBorder" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryBorder" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="AccountTab" TargetType="Button"><Setter Property="Height" Value="42"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8F8899"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value=".88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="AccountLink" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AccentMutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="8"/></Style>
            <Style x:Key="AccountGhost" TargetType="Button"><Setter Property="Height" Value="48"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="Foreground" Value="#E8E2EE"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="GhostBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter TargetName="GhostBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="LumaToggleSwitch" TargetType="CheckBox">
              <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
              <Setter Property="FontSize" Value="12.5"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="4,6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                          <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource ChromeMuted}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".9"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="HomeOptionCard" TargetType="Button">
              <Setter Property="Height" Value="52"/>
              <Setter Property="Margin" Value="0,0,0,6"/>
              <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="12,0">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardBorder" Property="Opacity" Value=".75"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="HomeSegmentButton" TargetType="Button">
              <Setter Property="Height" Value="36"/>
              <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="SegBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="8,0">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="SegBorder" Property="Opacity" Value=".75"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>

          <!-- Custom Wallpaper Layer -->
          <Image x:Name="HomeCustomWallpaper" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Rectangle x:Name="HomeWallpaperDimOverlay" Fill="#000000" Opacity="0.35" Visibility="Collapsed" IsHitTestVisible="False"/>

          <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-270,-310,0,0" Opacity=".10" Fill="{DynamicResource HomeGlowBrush}" IsHitTestVisible="False" CacheMode="BitmapCache"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyOrb1Transform"/></Ellipse.RenderTransform></Ellipse>
          <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-230,-280" Opacity=".075" Fill="{DynamicResource HomeGlowBrush}" IsHitTestVisible="False" CacheMode="BitmapCache"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyOrb2Transform"/></Ellipse.RenderTransform></Ellipse>
          <Ellipse Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".055" Fill="{DynamicResource HomeGlowSoftBrush}" IsHitTestVisible="False" CacheMode="BitmapCache"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyOrb3Transform"/></Ellipse.RenderTransform></Ellipse>
          <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0CFFFFFF"/><GradientStop Color="#00000000" Offset=".42"/><GradientStop Color="#12000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
          <Image Source="Assets/noise.png" Stretch="UniformToFill" Opacity=".032" IsHitTestVisible="False"/>

          <Grid x:Name="HomeSurfaceContent" MaxWidth="820" Margin="40,20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel MaxWidth="660" HorizontalAlignment="Center">
              <!-- Minimalist Logo & Brand -->
              <StackPanel x:Name="HomeBrandPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <Border.Effect>
                    <DropShadowEffect Color="#7468C7" BlurRadius="20" ShadowDepth="0" Opacity=".22"/>
                  </Border.Effect>
                  <Image Source="Assets/luma-mark.png" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Luma" Foreground="#FAF8FC" FontSize="26" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Swiss Digital Clock & Date -->
              <StackPanel x:Name="HomeClockPanel" HorizontalAlignment="Center" Margin="0,0,0,18">
                <TextBlock x:Name="HomeClockText" Text="12:00" Foreground="{DynamicResource ChromeText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="66" FontWeight="ExtraLight" HorizontalAlignment="Center"/>
                <TextBlock x:Name="HomeDateText" Text="Сегодня" Foreground="{DynamicResource ChromeMuted}" FontSize="14.5" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>

              <!-- Elegant Minimalist Headline -->
              <TextBlock x:Name="HomeHeadlineText" Text="Куда отправимся?" Foreground="{DynamicResource ChromeText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="35" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity=".3"/>
                </TextBlock.Effect>
              </TextBlock>

              <!-- Minimalist Search Capsule -->
              <Border x:Name="HomeSearchShell" Height="54" Width="640" CornerRadius="27" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="18,0,9,0">
                <Border.Effect>
                  <DropShadowEffect x:Name="HomeSearchShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity=".3"/>
                </Border.Effect>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>
                  <Path Stretch="Uniform" Width="16" Height="16" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="2" VerticalAlignment="Center"/>
                  <Grid Grid.Column="1" Margin="8,0,10,0">
                    <TextBlock x:Name="HomeSearchPlaceholder" Text="Поиск в интернете или адрес сайта..." Foreground="{DynamicResource ChromeMuted}" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="HomeSearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ChromeText}" CaretBrush="{DynamicResource AccentMutedBrush}" FontSize="15" FontWeight="Normal" VerticalContentAlignment="Center" TextChanged="HomeSearchBox_TextChanged" KeyDown="HomeSearchBox_KeyDown"/>
                  </Grid>
                  <Button Grid.Column="2" Width="36" Height="36" Background="{DynamicResource AccentBrush}" BorderThickness="0" FocusVisualStyle="{x:Null}" OverridesDefaultStyle="True" Cursor="Hand" Click="HomeSearchSubmit_Click" ToolTip="Искать">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="HomeSearchSubmitBorder" Background="{TemplateBinding Background}" CornerRadius="18">
                          <Path Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconArrowRight}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HomeSearchSubmitBorder" Property="Opacity" Value=".88"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HomeSearchSubmitBorder" Property="Opacity" Value=".68"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Border>

              <!-- Quick Action Pills Row -->
              <Grid x:Name="HomeQuickPillsGrid" Width="640">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource HomeQuickPill}" Click="Assistant_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconSpark}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                    <TextBlock Text="LumaAI" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HomeQuickPill}" Click="History_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconHistory}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                    <TextBlock Text="История" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource HomeQuickPill}" Click="Settings_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconGear}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                    <TextBlock Text="Настройки" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource HomeQuickPill}" Click="Account_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconUserRound}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                    <TextBlock Text="Аккаунт" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Live Media Glance Card -->
              <Border x:Name="HomeMediaCard" Width="640" Height="70" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,16,0,0" Padding="14,8" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="HomeMediaCard_Click" ToolTip="Перейти к вкладке с медиа">
                <Border.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity=".24"/>
                </Border.Effect>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="46"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="50" Height="50">
                    <Border CornerRadius="10" Background="{DynamicResource SurfaceInsetBrush}" ClipToBounds="True"/>
                    <Path x:Name="HomeMediaFallbackIcon" Stretch="Uniform" Width="20" Height="20" Data="{StaticResource IconMusicNote}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="HomeMediaArt" Visibility="Collapsed" Stretch="UniformToFill">
                      <Image.Clip>
                        <RectangleGeometry Rect="0,0,50,50" RadiusX="10" RadiusY="10"/>
                      </Image.Clip>
                    </Image>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HomeMediaTitle" Text="Воспроизведение" Foreground="{DynamicResource ChromeText}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomeMediaArtist" Text="Медиа" Foreground="{DynamicResource ChromeMuted}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <!-- Audio visualizer wave bars -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,14,0">
                    <Border Width="3" Height="14" CornerRadius="1.5" Background="{DynamicResource AccentMutedBrush}" Margin="1.5,0"/>
                    <Border Width="3" Height="22" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0"/>
                    <Border Width="3" Height="10" CornerRadius="1.5" Background="{DynamicResource AccentMutedBrush}" Margin="1.5,0"/>
                    <Border Width="3" Height="19" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1.5,0"/>
                    <Border Width="3" Height="13" CornerRadius="1.5" Background="{DynamicResource AccentMutedBrush}" Margin="1.5,0"/>
                  </StackPanel>
                  <!-- Toggle Play/Pause -->
                  <Button Grid.Column="3" Width="38" Height="38" Style="{StaticResource BareIconButton}" Click="HomeMediaToggle_Click" ToolTip="Воспроизведение / пауза">
                    <Grid Width="38" Height="38">
                      <Border CornerRadius="19" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Path x:Name="HomeMediaToggleIcon" Stretch="Uniform" Width="13" Height="13" Data="{StaticResource IconPause}" Fill="Transparent" Stroke="{DynamicResource ChromeText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </Grid>
              </Border>

              <!-- Recent Sites Modern Grid -->
              <Grid x:Name="HomeRecentSitesGrid" Width="640" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="HomeRecentButton1" Grid.Column="0" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon1" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle1" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain1" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
                <Button x:Name="HomeRecentButton2" Grid.Column="2" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon2" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle2" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain2" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
                <Button x:Name="HomeRecentButton3" Grid.Column="4" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon3" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle3" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain3" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
                <Button x:Name="HomeRecentButton4" Grid.Column="6" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon4" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle4" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain4" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Live Support Trigger Button -->
          <Button x:Name="HomeSupportButton" Click="HomeSupport_Click" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,70,22" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Чат с поддержкой" Cursor="Hand" Style="{StaticResource BareIconButton}" Panel.ZIndex="5">
            <Grid Width="38" Height="38">
              <Border CornerRadius="19" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
              <Path x:Name="HomeSupportIconPath" Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconChevronUp}" Stroke="{DynamicResource ChromeSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform x:Name="HomeSupportIconRotate" Angle="0"/>
                </Path.RenderTransform>
              </Path>
              <Border x:Name="HomeSupportBadge" Width="9" Height="9" CornerRadius="4.5" Background="#7468C7" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Live Support Chat Popup Card -->
          <Border x:Name="HomeSupportChatCard" Visibility="Collapsed" Width="360" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,68" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Panel.ZIndex="12" MouseLeftButtonDown="HomeSupportChatCard_MouseDown">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity=".45"/>
            </Border.Effect>
            <Border.RenderTransform>
              <TranslateTransform x:Name="HomeSupportChatTranslate" Y="20"/>
            </Border.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Header -->
              <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="15,15,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- Support Avatar -->
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#7468C7" Margin="0,0,10,0">
                    <Path Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconMessageSquarePlus}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <!-- Titles -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Поддержка Luma" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                      <Border Width="6" Height="6" CornerRadius="3" Background="#79D9A5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="dakower онлайн · чат с разработчиком" FontSize="10.5" Foreground="{DynamicResource ChromeMuted}"/>
                    </StackPanel>
                  </StackPanel>
                  <!-- Close / Minimize Button -->
                  <Button Grid.Column="2" Click="HomeSupportClose_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Свернуть чат" Style="{StaticResource BareIconButton}">
                    <Path Stretch="Uniform" Width="12" Height="12" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource ChromeMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </Border>

              <!-- Messages Area (Row 1) -->
              <Grid Grid.Row="1">
                <!-- Signed-out state prompt -->
                <StackPanel x:Name="HomeSupportAuthPrompt" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0" MaxWidth="280">
                  <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Stretch="Uniform" Width="18" Height="18" Data="{StaticResource IconUserRound}" Stroke="{DynamicResource ChromeSecondary}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Вход в аккаунт" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                  <TextBlock Text="Войдите в аккаунт Luma, чтобы писать в поддержку и получать ответы напрямую от разработчика в реальном времени." FontSize="11.5" Foreground="{DynamicResource ChromeMuted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16" Margin="0,0,0,16"/>
                  <Button Click="HomeSupportOpenAccount_Click" Content="Войти в аккаунт" Height="32" Padding="14,0" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Resources>
                      <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                  </Button>
                </StackPanel>

                <!-- Chat content when authenticated -->
                <Grid x:Name="HomeSupportChatPanel" Visibility="Visible">
                  <ScrollViewer x:Name="HomeSupportScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                    <StackPanel>
                      <!-- Welcome message card -->
                      <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="👋 Прямой чат с разработчиком" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,3"/>
                          <TextBlock Text="Задайте любой вопрос, идею или опишите проблему. Ответ придёт прямо сюда из Telegram разработчика в реальном времени!" FontSize="11" Foreground="{DynamicResource ChromeMuted}" TextWrapping="Wrap" LineHeight="15"/>
                        </StackPanel>
                      </Border>

                      <!-- Messages ListBox -->
                      <ListBox x:Name="HomeSupportMessagesList" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                  <ContentPresenter/>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,2">
                              <!-- Admin message (dakower) -->
                              <StackPanel HorizontalAlignment="Left" MaxWidth="270" Visibility="{Binding AdminVisibility}">
                                <TextBlock Text="{Binding Author}" FontSize="10.5" Foreground="#A29BFE" FontWeight="SemiBold" Margin="4,0,0,2"/>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4,12,12,12" Padding="10,8">
                                  <TextBlock Text="{Binding Body}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                </Border>
                                <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource ChromeMuted}" Margin="4,2,0,0"/>
                              </StackPanel>
                              <!-- Tester / User message -->
                              <StackPanel HorizontalAlignment="Right" MaxWidth="270" Visibility="{Binding UserVisibility}">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="12,12,4,12" Padding="10,8">
                                  <TextBlock Text="{Binding Body}" Foreground="White" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                </Border>
                                <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource ChromeMuted}" HorizontalAlignment="Right" Margin="0,2,4,0"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- Empty conversation prompt -->
                      <TextBlock x:Name="HomeSupportEmptyPrompt" Visibility="Collapsed" Text="Сообщений пока нет. Напишите первое сообщение ниже!" FontSize="11" Foreground="{DynamicResource ChromeMuted}" TextAlignment="Center" Margin="0,20,0,0"/>

                      <!-- Sending indicator -->
                      <TextBlock x:Name="HomeSupportSendingStatus" Visibility="Collapsed" Text="Отправка в Telegram..." FontSize="10" Foreground="{DynamicResource ChromeMuted}" FontStyle="Italic" HorizontalAlignment="Right" Margin="0,4,4,0"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>

              <!-- Input composer (Row 2) -->
              <Border x:Name="HomeSupportComposer" Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="0,0,15,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <TextBox x:Name="HomeSupportInputBox" PreviewKeyDown="HomeSupportInput_PreviewKeyDown" TextChanged="HomeSupportInput_TextChanged" MaxHeight="80" MinHeight="34" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource ChromeText}" CaretBrush="{DynamicResource ChromeText}" BorderThickness="0" Padding="6,6" FontSize="12.5" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="HomeSupportPlaceholder" IsHitTestVisible="False" Text="Напишите сообщение..." FontSize="12.5" Foreground="{DynamicResource ChromeMuted}" Margin="6,7,0,0" VerticalAlignment="Top"/>
                  </Grid>
                  <Button Grid.Column="1" x:Name="HomeSupportSendButton" Click="HomeSupportSend_Click" Width="32" Height="32" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="Отправить (Enter)">
                    <Button.Resources>
                      <Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style>
                    </Button.Resources>
                    <Path Stretch="Uniform" Width="13" Height="13" Data="{StaticResource IconArrowUp}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Dashboard Customize Trigger Button -->
          <Button x:Name="HomeCustomizeButton" Click="HomeCustomize_Click" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Настроить стартовый экран" Cursor="Hand" Style="{StaticResource BareIconButton}" Panel.ZIndex="5">
            <Grid Width="38" Height="38">
              <Border CornerRadius="19" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
              <Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconSlidersHorizontal}" Stroke="{DynamicResource ChromeSecondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>

          <!-- Dashboard Customization Drawer / Studio -->
          <Grid x:Name="HomeCustomizeDrawerOverlay" Visibility="Collapsed" Background="#55000000" MouseLeftButtonDown="HomeCustomizeClose_Click" Panel.ZIndex="10">
            <Border x:Name="HomeCustomizeDrawer" Width="400" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" MouseLeftButtonDown="HomeCustomizeDrawer_MouseDown">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity=".55"/>
              </Border.Effect>
              <Grid Margin="22,18,22,20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Drawer Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconSlidersHorizontal}" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Настройка стартовой" Foreground="{DynamicResource ChromeText}" FontSize="15" FontWeight="Bold"/>
                      <TextBlock Text="Персонализация и стиль экрана" Foreground="{DynamicResource ChromeMuted}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <Button Width="32" Height="32" HorizontalAlignment="Right" Style="{StaticResource BareIconButton}" Click="HomeCustomizeClose_Click" ToolTip="Закрыть">
                    <Path Stretch="Uniform" Width="13" Height="13" Data="{StaticResource IconX}" Stroke="{DynamicResource ChromeMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Button>
                </Grid>

                <!-- Drawer Content Scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,0,6,10">

                    <!-- Section: Typography -->
                    <TextBlock Text="ШРИФТ ЭКРАНА И ЧАСОВ" Foreground="{DynamicResource ChromeMuted}" FontSize="10" FontWeight="Bold" Margin="2,4,0,8"/>
                    <Button x:Name="HomeFontSegoe" Style="{StaticResource HomeOptionCard}" Tag="Segoe UI Variable Display, Segoe UI" Click="HomeFontOption_Click">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Segoe UI Variable" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="12:45 · Куда отправимся?" Foreground="{DynamicResource ChromeMuted}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button x:Name="HomeFontInter" Style="{StaticResource HomeOptionCard}" Tag="Inter, Segoe UI" Click="HomeFontOption_Click">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Inter (Швейцарский)" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="12:45 · Куда отправимся?" Foreground="{DynamicResource ChromeMuted}" FontFamily="Inter, Segoe UI" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button x:Name="HomeFontCascadia" Style="{StaticResource HomeOptionCard}" Tag="Cascadia Code, Consolas" Click="HomeFontOption_Click">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Cascadia Code (Киберпанк)" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="12:45 · Куда отправимся?" Foreground="{DynamicResource ChromeMuted}" FontFamily="Cascadia Code, Consolas" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button x:Name="HomeFontGeorgia" Style="{StaticResource HomeOptionCard}" Tag="Georgia" Click="HomeFontOption_Click">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Georgia (Антиква с засечками)" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="12:45 · Куда отправимся?" Foreground="{DynamicResource ChromeMuted}" FontFamily="Georgia" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button x:Name="HomeFontBahnschrift" Style="{StaticResource HomeOptionCard}" Tag="Bahnschrift" Click="HomeFontOption_Click">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Bahnschrift (DIN-гротеск)" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="12:45 · Куда отправимся?" Foreground="{DynamicResource ChromeMuted}" FontFamily="Bahnschrift" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button x:Name="HomeFontTrebuchet" Style="{StaticResource HomeOptionCard}" Tag="Trebuchet MS" Click="HomeFontOption_Click">
                      <Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Trebuchet MS (Динамичный)" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="12:45 · Куда отправимся?" Foreground="{DynamicResource ChromeMuted}" FontFamily="Trebuchet MS" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Button>

                    <!-- Section: Search Shape -->
                    <TextBlock Text="ФОРМА ПОИСКОВОЙ СТРОКИ" Foreground="{DynamicResource ChromeMuted}" FontSize="10" FontWeight="Bold" Margin="2,16,0,8"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                      </Grid.ColumnDefinitions>
                      <Button x:Name="HomeShapePill" Grid.Column="0" Style="{StaticResource HomeSegmentButton}" Tag="pill" Content="Капсула" Click="HomeSearchShape_Click"/>
                      <Button x:Name="HomeShapeRounded" Grid.Column="2" Style="{StaticResource HomeSegmentButton}" Tag="rounded" Content="Мягкая" Click="HomeSearchShape_Click"/>
                      <Button x:Name="HomeShapeSquare" Grid.Column="4" Style="{StaticResource HomeSegmentButton}" Tag="square" Content="Квадрат" Click="HomeSearchShape_Click"/>
                    </Grid>

                    <!-- Section: Search Style -->
                    <TextBlock Text="СТИЛЬ ПОИСКОВОЙ СТРОКИ" Foreground="{DynamicResource ChromeMuted}" FontSize="10" FontWeight="Bold" Margin="2,16,0,8"/>
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Button x:Name="HomeStyleSolid" Grid.Row="0" Grid.Column="0" Style="{StaticResource HomeSegmentButton}" Tag="solid" Content="Классика" Click="HomeSearchStyle_Click"/>
                      <Button x:Name="HomeStyleGlass" Grid.Row="0" Grid.Column="2" Style="{StaticResource HomeSegmentButton}" Tag="glass" Content="Стекло (Glass)" Click="HomeSearchStyle_Click"/>
                      <Button x:Name="HomeStyleOutline" Grid.Row="2" Grid.Column="0" Style="{StaticResource HomeSegmentButton}" Tag="outline" Content="Контур" Click="HomeSearchStyle_Click"/>
                      <Button x:Name="HomeStyleGlow" Grid.Row="2" Grid.Column="2" Style="{StaticResource HomeSegmentButton}" Tag="glow" Content="Неон (Glow)" Click="HomeSearchStyle_Click"/>
                    </Grid>

                    <!-- Section: Wallpaper -->
                    <TextBlock Text="ОБОИ И ФОН" Foreground="{DynamicResource ChromeMuted}" FontSize="10" FontWeight="Bold" Margin="2,18,0,8"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Style="{StaticResource HomeSegmentButton}" Content="Выбрать обои..." Click="HomeChooseWallpaper_Click"/>
                      <Button Grid.Column="2" Style="{StaticResource HomeSegmentButton}" Content="Сбросить" Click="HomeResetWallpaper_Click" ToolTip="Вернуть стандартный фон Luma"/>
                    </Grid>
                    <Grid Margin="2,12,2,4">
                      <TextBlock Text="Затемнение обоев" Foreground="{DynamicResource ChromeSecondary}" FontSize="12"/>
                      <TextBlock x:Name="HomeDimPercentText" Text="35%" Foreground="{DynamicResource AccentMutedBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="HomeDimSlider" Minimum="0" Maximum="0.8" SmallChange="0.05" LargeChange="0.1" Value="0.35" ValueChanged="HomeDimSlider_ValueChanged" Margin="2,2,2,0"/>

                    <!-- Section: Element Toggles -->
                    <TextBlock Text="ВИДИМОСТЬ ЭЛЕМЕНТОВ" Foreground="{DynamicResource ChromeMuted}" FontSize="10" FontWeight="Bold" Margin="2,18,0,8"/>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6">
                      <StackPanel>
                        <CheckBox x:Name="HomeToggleLogo" Style="{StaticResource LumaToggleSwitch}" Tag="logo" Content="Логотип и бренд Luma" Click="HomeToggle_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                        <CheckBox x:Name="HomeToggleClock" Style="{StaticResource LumaToggleSwitch}" Tag="clock" Content="Часы и дата" Click="HomeToggle_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                        <CheckBox x:Name="HomeToggleHeadline" Style="{StaticResource LumaToggleSwitch}" Tag="headline" Content="Заголовок «Куда отправимся?»" Click="HomeToggle_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                        <CheckBox x:Name="HomeToggleSearch" Style="{StaticResource LumaToggleSwitch}" Tag="search" Content="Поисковая строка" Click="HomeToggle_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                        <CheckBox x:Name="HomeTogglePills" Style="{StaticResource LumaToggleSwitch}" Tag="pills" Content="Быстрые действия (LumaAI, История...)" Click="HomeToggle_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                        <CheckBox x:Name="HomeToggleMedia" Style="{StaticResource LumaToggleSwitch}" Tag="media" Content="Живой медиа-виджет треков" Click="HomeToggle_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>
                        <CheckBox x:Name="HomeToggleRecent" Style="{StaticResource LumaToggleSwitch}" Tag="recent" Content="Недавние сайты (Speed Dial)" Click="HomeToggle_Click"/>
                      </StackPanel>
                    </Border>

                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

