<?xml version="1.0"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Luma" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="Luma.MainWindow" Title="Luma" Width="1280" Height="800" MinWidth="420" MinHeight="360" WindowStyle="None" AllowsTransparency="False" Background="#0B0912" WindowStartupLocation="CenterScreen" FontFamily="Inter, Segoe UI" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml"/>
        <ResourceDictionary Source="UI/Sidebar/Styles/SidebarResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- ===== Zen / Arc design tokens (overwritten per theme in ApplyTheme) ===== -->
      <FontFamily x:Key="LumaFont">Segoe UI Variable Text, Inter, Segoe UI</FontFamily>
      <FontFamily x:Key="LumaDisplayFont">Segoe UI Variable Display, Inter, Segoe UI</FontFamily>
      <SolidColorBrush x:Key="ChromeText" Color="#F5F5F7"/>
      <SolidColorBrush x:Key="ChromeMuted" Color="#7C7E87"/>
      <SolidColorBrush x:Key="ChromeIconMuted" Color="#9A9CA5"/>
      <SolidColorBrush x:Key="ChromeSecondary" Color="#D4D5DB"/>
      <SolidColorBrush x:Key="HomeGlowBrush" Color="#565B64"/>
      <SolidColorBrush x:Key="HomeGlowSoftBrush" Color="#343840"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#141519"/>
      <SolidColorBrush x:Key="TopBrush" Color="#00000000"/>
      <SolidColorBrush x:Key="ShellBrush" Color="#0E0F12"/>
      <!-- Window frame: everything except the page card sits on this tinted gradient. -->
      <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141518"/>
        <GradientStop Color="#0E0F12" Offset="1"/>
      </LinearGradientBrush>
      <!-- Glass: translucent white tints so chrome blends into the frame instead of being black slabs. -->
      <SolidColorBrush x:Key="GlassBrush" Color="#0EFFFFFF"/>
      <SolidColorBrush x:Key="GlassHoverBrush" Color="#18FFFFFF"/>
      <SolidColorBrush x:Key="GlassBorderBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="ActiveTabBrush" Color="#22FFFFFF"/>
      <SolidColorBrush x:Key="ActiveTabText" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#8E93A0"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2C32"/>
      <SolidColorBrush x:Key="AccentMutedBrush" Color="#C3C6CE"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1F23"/>
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#26272C"/>
      <SolidColorBrush x:Key="SurfaceInsetBrush" Color="#16171A"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#2C2D33"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3D3E46"/>
      <Style x:Key="LumaComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#F4F0F6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBody" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="LumaComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#F4F0F6"/><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,0"/><Setter Property="ItemContainerStyle" Value="{StaticResource LumaComboItem}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropToggle" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" CornerRadius="8" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"><Grid><ContentPresenter Margin="11,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"/><Path Width="12" Height="7" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 1 1 L 6 6 L 11 1" Stroke="{DynamicResource ChromeSecondary}" StrokeThickness="1.7" Fill="Transparent"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,5,0,0" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Padding="5"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource LumaComboBox}"/>
      <!-- One Luma scrollbar language for every native ScrollViewer/ListBox/Popup. -->
      <Style x:Key="LumaVerticalThumb" TargetType="{x:Type Thumb}">
        <Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="2,1"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Thumb}"><Border x:Name="ThumbBody" CornerRadius="4" Background="{DynamicResource BorderStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ThumbBody" Property="BorderBrush" Value="{DynamicResource ChromeSecondary}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="LumaHorizontalThumb" TargetType="{x:Type Thumb}">
        <Setter Property="MinWidth" Value="34"/><Setter Property="Margin" Value="1,2"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Thumb}"><Border x:Name="ThumbBody" CornerRadius="4" Background="{DynamicResource BorderStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ThumbBody" Property="BorderBrush" Value="{DynamicResource ChromeSecondary}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <ControlTemplate x:Key="LumaVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Border Width="10" CornerRadius="5" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Focusable="False"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource LumaVerticalThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Border>
      </ControlTemplate>
      <ControlTemplate x:Key="LumaHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Border Height="10" CornerRadius="5" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False" Focusable="False"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource LumaHorizontalThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Border>
      </ControlTemplate>
      <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template" Value="{StaticResource LumaVerticalScrollBar}"/>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template" Value="{StaticResource LumaHorizontalScrollBar}"/></Trigger></Style.Triggers>
      </Style>
      <Style x:Key="AssistantPill" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Glow" Height="28" CornerRadius="8" Padding="6,0,10,0" Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Glow" Property="Background" Value="{DynamicResource Zen_4B4B50}"/>
                  <Setter TargetName="Glow" Property="BorderBrush" Value="{DynamicResource Zen_5E5E64}"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Glow" Property="Background" Value="{DynamicResource Zen_56565A}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopMenuGlowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ChromeMuted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MenuGlow" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuGlow" Property="Background" Value="{DynamicResource GlassHoverBrush}"/><Setter TargetName="MenuGlow" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="BareIconButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="Transparent" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Opacity" Value=".62"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value=".32"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource BareIconButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="Transparent" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#D83B01"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#A80000"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HomeQuickPill" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                  <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="PillBorder" Property="Opacity" Value=".75"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HomeRecentTile" TargetType="Button">
        <Setter Property="Height" Value="92"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="TileBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                  <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="TileBorder" Property="Opacity" Value=".75"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource GlassBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Opacity" Value=".68"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ListBoxItem">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeSecondary}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource GlassBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="B" Property="Background" Value="{DynamicResource ActiveTabBrush}"/>
                  <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource ActiveTabText}"/>
                  <Setter Property="FontWeight" Value="Medium"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource BareIconButton}">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ChromeSecondary}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- Same pill toggle as the settings page: 43x24 track, 18 px knob, accent when on. -->
      <Style x:Key="LumaSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="43"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Track" CornerRadius="12" Background="#20FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#EEEEEE" HorizontalAlignment="Left" Margin="2.5,0,0,0">
                  <Border.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Border.RenderTransform>
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                  <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                  <Setter TargetName="Knob" Property="Background" Value="White"/>
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="19" Duration="0:0:0.22">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.22">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Knob" Property="Background" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Universal toggle switch for CheckBox (used across EmptyBackground and Popups) -->
      <Style x:Key="LumaToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ChromeText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Border Background="Transparent" Padding="4,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                  <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource ChromeMuted}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                  <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".9"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="62"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid Margin="0,2">
                <Border x:Name="Chrome" CornerRadius="14" Background="#09000000" BorderBrush="#12FFFFFF" BorderThickness="1"/>
                <Border x:Name="AccentRail" Width="3" Height="28" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="5,0,0,0" Opacity="0"/>
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="{TemplateBinding Padding}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/><Setter TargetName="AccentRail" Property="Opacity" Value="1"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    <Style x:Key="PopupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity=".4"/>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="11,0"/><Setter Property="Foreground" Value="{DynamicResource ChromeSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MenuRow" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="MenuRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="LumaContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="#202123"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
              <Border Background="#202123" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="11" Padding="6" MinWidth="230">
                <Border.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity=".45"/>
                </Border.Effect>
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LumaMenuItem" TargetType="MenuItem">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="#EEE9F2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#8B8691" FontSize="11" VerticalAlignment="Center" Margin="18,0,2,0"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#1FFFFFFF"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value=".38"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LumaSeparator" TargetType="Separator">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Separator">
              <Border Height="1" Background="#1FFFFFFF" Margin="7,5"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="RootShell" Background="{DynamicResource ShellBrush}" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="0"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============ TITLEBAR (Preserved & Hidden in Single Toolbar Mode) ============ -->
    <Border x:Name="TitleBar" Grid.Row="0" Height="0" Visibility="Collapsed" Background="{DynamicResource ShellBrush}" BorderThickness="0" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- navigation cluster -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button x:Name="TopMenuButton" Style="{StaticResource TopMenuGlowButton}" Width="28" Height="28" Margin="0,0,6,0" Click="MainMenu_Click" ToolTip="Меню Luma">
            <Image Source="Assets/luma-mark.png" Width="18" Height="18" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="28" Height="28" Margin="0,0,4,0" Click="ToggleSidebar_Click" ToolTip="Боковая панель">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconSidebar}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
          </Button>
          <Button x:Name="BackButton" Style="{StaticResource BareIconButton}" Width="28" Height="28" Margin="0,0,4,0" Click="Back_Click" ToolTip="Назад">
            <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconChevronLeft}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="ForwardButton" Style="{StaticResource BareIconButton}" Width="28" Height="28" Margin="0,0,4,0" Click="Forward_Click" ToolTip="Вперёд">
            <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconChevronRight}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="28" Height="28" Click="Reload_Click" ToolTip="Обновить">
            <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconReload}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>

        <!-- address pill -->
        <Border Grid.Column="1" Height="30" CornerRadius="15" MaxWidth="500" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="6,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Left: Copy URL button -->
            <Button x:Name="CopyUrlButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="1,0,8,0" Click="CopyUrl_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Скопировать адрес">
              <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconCopy}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>

            <!-- Center: Domain/Title Pill -->
            <Border x:Name="DomainPill" Background="Transparent" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="DomainPill_Click" VerticalAlignment="Center">
              <TextBlock x:Name="DomainText" Text="Новая вкладка" Foreground="{DynamicResource ChromeText}" FontFamily="{StaticResource LumaDisplayFont}" FontSize="12.5" FontWeight="Normal" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>

            <!-- Right: Action tools cluster -->
            <Button x:Name="TranslateButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="0,0,4,0" Click="TranslateButton_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Перевести страницу">
              <Path x:Name="TranslateIcon" Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconGlobe}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="SplitButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="0,0,4,0" Click="SplitButton_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Split View">
              <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconSplit}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Button>
            <Button x:Name="SiteSettingsButton" Style="{StaticResource BareIconButton}" Width="22" Height="22" Margin="0,0,1,0" Click="SiteSettings_Click" Foreground="{DynamicResource ChromeIconMuted}" ToolTip="Параметры сайта">
              <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconSlidersHorizontal}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- right column: window controls docked right, the player sits next to the address pill -->
        <DockPanel Grid.Column="2" LastChildFill="True" VerticalAlignment="Center" Margin="0,0,12,0">
        <StackPanel x:Name="TitleBarRightCluster" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ExtensionsButton" Style="{StaticResource BareIconButton}" Width="28" Height="28" Margin="0,0,3,0" Click="Extensions_Click" ToolTip="Расширения">
            <Path x:Name="ExtensionsButtonIcon" Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconPuzzle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
              <Path.RenderTransform><RotateTransform x:Name="ExtensionsButtonRotate" Angle="0"/></Path.RenderTransform>
            </Path>
          </Button>
          <Button x:Name="DownloadButton" Style="{StaticResource BareIconButton}" Width="28" Height="28" Margin="0,0,6,0" Click="Downloads_Click" ToolTip="Загрузки">
            <Grid Width="28" Height="28">
              <Path x:Name="DownloadIdleIcon" Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconDownload}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Grid x:Name="DownloadActivityIndicator" Width="22" Height="22" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Margin="1" Stroke="{DynamicResource AccentSoftBrush}" StrokeThickness="2" Opacity=".75"/>
                <Grid Width="22" Height="22" RenderTransformOrigin=".5,.5">
                  <Grid.RenderTransform>
                    <RotateTransform x:Name="DownloadActivityRotate"/>
                  </Grid.RenderTransform>
                  <Path Data="M 11 1 A 10 10 0 0 1 21 11" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
              </Grid>
              <Border x:Name="DownloadBadge" Visibility="Collapsed" MinWidth="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                <TextBlock x:Name="DownloadBadgeText" Text="1" Foreground="White" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2.5,0"/>
              </Border>
            </Grid>
          </Button>
          <Button x:Name="AssistantButton" Style="{StaticResource AssistantPill}" Margin="0,0,8,0" Click="Assistant_Click" ToolTip="LumaAI (Ctrl+J)">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="Assets/luma-assistant.png" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="LumaAI" FontFamily="{StaticResource LumaDisplayFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="14" Background="{DynamicResource GlassBorderBrush}" Margin="2,0,6,0" VerticalAlignment="Center"/>
          <Button Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,3,0" Click="MinimizeWindow_Click" ToolTip="Свернуть">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconMinus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="26" Height="26" Margin="0,0,3,0" Click="MaximizeWindow_Click" ToolTip="Развернуть">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconSquare}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
          </Button>
          <Button Style="{StaticResource WindowCloseButton}" Width="26" Height="26" Click="CloseWindow_Click" ToolTip="Закрыть">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconX}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>

        <!-- now playing pill: sits right after the address pill with a small gap -->
        <Border x:Name="NowPlayingWidget" Visibility="Collapsed" Height="30" MaxWidth="250" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0" Margin="10,0,10,0" CornerRadius="15" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="NowPlayingWidget_Click" ToolTip="Открыть медиаплеер" RenderTransformOrigin="0,.5">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border.RenderTransform><TranslateTransform x:Name="NowPlayingWidgetShift"/></Border.RenderTransform>
          <Grid x:Name="NowPlayingPillGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="26"/>
            </Grid.ColumnDefinitions>
            <Grid Width="24" Height="24">
              <Border CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
              <Path x:Name="NowPlayingPillFallbackIcon" Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconMusicNote}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image x:Name="NowPlayingPillArt" Visibility="Collapsed" Stretch="UniformToFill">
                <Image.Clip>
                  <RectangleGeometry Rect="0,0,24,24" RadiusX="12" RadiusY="12"/>
                </Image.Clip>
              </Image>
            </Grid>
            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
              <TextBlock x:Name="NowPlayingPillTitle" Foreground="{DynamicResource ChromeText}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11.5" FontWeight="SemiBold" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NowPlayingPillArtist" Foreground="{DynamicResource ChromeMuted}" FontSize="9.5" MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
            </StackPanel>
            <StackPanel x:Name="NowPlayingEqualizer" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="11" Margin="0,0,8,0" IsHitTestVisible="False">
              <Rectangle Width="2.4" Height="11" RadiusX="1.2" RadiusY="1.2" Margin="0,0,1.6,0" Fill="{DynamicResource AccentMutedBrush}" VerticalAlignment="Bottom" RenderTransformOrigin=".5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="EqBar1" ScaleY=".35"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="2.4" Height="11" RadiusX="1.2" RadiusY="1.2" Margin="0,0,1.6,0" Fill="{DynamicResource AccentMutedBrush}" VerticalAlignment="Bottom" RenderTransformOrigin=".5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="EqBar2" ScaleY=".35"/></Rectangle.RenderTransform></Rectangle>
              <Rectangle Width="2.4" Height="11" RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentMutedBrush}" VerticalAlignment="Bottom" RenderTransformOrigin=".5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="EqBar3" ScaleY=".35"/></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
            <Grid Grid.Column="3" Width="24" Height="24">
              <Ellipse Fill="{DynamicResource AccentBrush}"/>
              <Path x:Name="NowPlayingToggleIcon" Width="9" Height="9" Stretch="Uniform" Data="{StaticResource IconPause}" Fill="Transparent" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Button Style="{StaticResource BareIconButton}" Width="24" Height="24" Background="Transparent" Click="NowPlayingToggle_Click" ToolTip="Воспроизведение / пауза"/>
            </Grid>
            <!-- thin progress line along the bottom edge -->
            <Border x:Name="NowPlayingPillProgress" Grid.ColumnSpan="5" Height="2" Width="0" CornerRadius="1" Background="{DynamicResource AccentBrush}" Opacity=".9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,0" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        </DockPanel>
      </Grid>
    </Border>

    <Border x:Name="NowPlayingTray" Grid.Row="1" Height="0" Visibility="Collapsed" Opacity="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18131F"/><GradientStop Color="#100D15" Offset=".72"/><GradientStop Color="#171523" Offset="1"/></LinearGradientBrush></Border.Background>
      <Border.RenderTransform><TranslateTransform x:Name="NowPlayingTrayTranslate" Y="-16"/></Border.RenderTransform>
      <Grid MaxWidth="1220" Margin="30,18" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <Grid Width="92" Height="92" HorizontalAlignment="Left" VerticalAlignment="Center"><Border CornerRadius="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity=".28"/></Border.Effect></Border><Path x:Name="NowPlayingPopupFallbackIcon" Width="34" Height="34" Stretch="Uniform" Data="{StaticResource IconMusicNote}" Fill="Transparent" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="NowPlayingArt" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,92,92" RadiusX="23" RadiusY="23"/></Image.Clip></Image></Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,28,0"><TextBlock Text="Сейчас играет" Foreground="#A79CAF" FontSize="10.5" FontWeight="SemiBold"/><TextBlock x:Name="NowPlayingPopupTitle" Foreground="#FAF7FC" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock x:Name="NowPlayingPopupArtist" Foreground="#AAA0B3" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="NowPlayingPos" Text="0:00" Foreground="#918798" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/><Grid x:Name="SeekTrack" Grid.Column="1" Height="20" Margin="8,0" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="SeekTrack_MouseDown" MouseMove="SeekTrack_MouseMove" MouseLeftButtonUp="SeekTrack_MouseUp"><Border Height="5" CornerRadius="3" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center"/><Border x:Name="SeekFill" Height="5" CornerRadius="3" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"/><Ellipse x:Name="SeekThumb" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity=".45"/></Ellipse.Effect></Ellipse></Grid><TextBlock x:Name="NowPlayingDur" Grid.Column="2" Text="0:00" Foreground="#918798" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/></Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,10"><Button Style="{StaticResource BareIconButton}" Width="42" Height="42" Margin="0,0,18,0" Click="NowPlayingPrev_Click"><Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconSkipBack}" Fill="Transparent" Stroke="#B8AEC1" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button><Grid Width="52" Height="52"><Border CornerRadius="26" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity=".28"/></Border.Effect></Border><Path x:Name="NowPlayingToggleIconPopup" Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconPause}" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Style="{StaticResource BareIconButton}" Width="52" Height="52" Background="Transparent" Click="NowPlayingToggle_Click" ToolTip="Воспроизведение / пауза"/></Grid><Button Style="{StaticResource BareIconButton}" Width="42" Height="42" Margin="18,0,0,0" Click="NowPlayingNext_Click"><Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconSkipNext}" Fill="Transparent" Stroke="#B8AEC1" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button></StackPanel>
          <Grid Grid.Row="2" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconVolume}" Stroke="#9E94A8" StrokeThickness="1.8" VerticalAlignment="Center"/><Grid x:Name="VolumeTrack" Grid.Column="1" Width="150" Height="18" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="VolumeTrack_MouseDown" MouseMove="VolumeTrack_MouseMove" MouseLeftButtonUp="VolumeTrack_MouseUp"><Border Height="5" CornerRadius="3" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Center"/><Border x:Name="VolumeFill" Height="5" CornerRadius="3" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"/><Ellipse x:Name="VolumeThumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Grid>
        </Grid>
        <Button Grid.Column="3" Style="{StaticResource BareIconButton}" Width="34" Height="34" VerticalAlignment="Top" Click="NowPlayingTrayClose_Click" ToolTip="Свернуть"><Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconChevronUp}" Stroke="#A79DAF" StrokeThickness="2"/></Button>
      </Grid>
    </Border>

    <!-- ============ BODY ============ -->
    <Grid x:Name="BodyGrid" Grid.Row="2" Background="{DynamicResource Zen_3D3D42}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="206"/>
        <ColumnDefinition x:Name="ToolsDrawerColumn" Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="AssistantColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- Edge trigger for Compact Mode hover reveal -->
      <Border x:Name="SidebarEdgeTrigger" Grid.Column="0" Width="48" HorizontalAlignment="Left" Panel.ZIndex="100" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False"/>

      <!-- ============ ZEN BROWSER SIDEBAR (#navigator-toolbox — 1:1 Official Source & Screenshot 1) ============ -->
      <Border x:Name="Sidebar" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="206" Panel.ZIndex="25" Background="{DynamicResource Zen_3D3D42}" BorderThickness="0" MouseEnter="ZenSidebar_MouseEnter" MouseLeave="ZenSidebar_MouseLeave" ClipToBounds="True">
        <Border.RenderTransform>
          <TranslateTransform x:Name="SidebarTranslate" X="0" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect x:Name="SidebarShadow" Color="#000000" BlurRadius="18" ShadowDepth="4" Direction="0" Opacity="0"/>
        </Border.Effect>
        <Grid>
          <!-- Workspace Theme Gradient Tint Overlay (Opacity=0 by default for pure flat #3D3D42 Zen look) -->
          <Border x:Name="ZenSidebarGradientOverlay" Opacity="0" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush x:Name="ZenWorkspaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="ZenGradientStop0" Color="#3D3D42" Offset="0.0"/>
                <GradientStop x:Name="ZenGradientStop1" Color="#3D3D42" Offset="0.85"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <Rectangle x:Name="SidebarNeon" Width="1" Opacity="0" HorizontalAlignment="Left" Panel.ZIndex="4" IsHitTestVisible="False">
            <Rectangle.Fill><SolidColorBrush Color="Transparent"/></Rectangle.Fill>
          </Rectangle>

          <Grid x:Name="ZenSidebarInnerGrid" Margin="6,6,6,6" Width="194" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
              <!-- 0: #zen-sidebar-top-buttons -->
              <RowDefinition Height="Auto"/>
              <!-- 1: #urlbar -->
              <RowDefinition Height="Auto"/>
              <!-- 2: #zen-essentials-container -->
              <RowDefinition Height="Auto"/>
              <!-- 3: .zen-current-workspace-indicator -->
              <RowDefinition Height="Auto"/>
              <!-- 4: #vertical-pinned-tabs-container + .pinned-tabs-container-separator -->
              <RowDefinition Height="Auto"/>
              <!-- 5: #tabs-newtab-button -->
              <RowDefinition Height="Auto"/>
              <!-- 6: #zen-tabs-wrapper / #tabbrowser-tabs -->
              <RowDefinition Height="*"/>
              <!-- 7: #zen-sidebar-foot-buttons -->
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. #zen-sidebar-top-buttons (Left: Menu + Sidebar toggle | Right: Back, Forward, Reload) -->
            <Grid x:Name="ZenTopButtonsGrid" Grid.Row="0" Margin="0,0,0,8" Height="34" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ZenTopCol0" Width="34"/>
                <ColumnDefinition x:Name="ZenTopCol1" Width="2"/>
                <ColumnDefinition x:Name="ZenTopCol2" Width="34"/>
                <ColumnDefinition x:Name="ZenTopCol3" Width="*"/>
                <ColumnDefinition x:Name="ZenTopCol4" Width="34"/>
                <ColumnDefinition x:Name="ZenTopCol5" Width="2"/>
                <ColumnDefinition x:Name="ZenTopCol6" Width="34"/>
                <ColumnDefinition x:Name="ZenTopCol7" Width="2"/>
                <ColumnDefinition x:Name="ZenTopCol8" Width="34"/>
              </Grid.ColumnDefinitions>

              <!-- 1. #PanelUI-menu-button (nucleo/menu.svg) -->
              <Button x:Name="ZenTopMenuButton" Grid.Column="0" Width="34" Height="34" Style="{StaticResource ZenTopActionButtonStyle}" Click="MainMenu_Click" ToolTip="Меню Luma">
                <Path Data="{StaticResource ZenIconMenu}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>

              <!-- 2. #zen-expand-sidebar-button (nucleo/sidebar.svg) -->
              <Button x:Name="ZenExpandSidebarBtn" Grid.Column="2" Width="34" Height="34" Style="{StaticResource ZenTopActionButtonStyle}" Click="ToggleSidebarExpand_Click" ToolTip="Закрепить боковую панель (Ctrl+Alt+C)">
                <Path x:Name="ExpandSidebarIcon" Data="{StaticResource ZenIconSidebar}" Width="17" Height="17" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>

              <!-- 3. back-button (nucleo/back.svg) -->
              <Button x:Name="ZenBackButton" Grid.Column="4" Width="34" Height="34" Style="{StaticResource ZenTopActionButtonStyle}" Click="Back_Click" ToolTip="Назад (Alt+Left)">
                <Path Data="{StaticResource ZenIconBack}" Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>

              <!-- 4. forward-button (nucleo/forward.svg) -->
              <Button x:Name="ZenForwardButton" Grid.Column="6" Width="34" Height="34" Style="{StaticResource ZenTopActionButtonStyle}" Click="Forward_Click" ToolTip="Вперёд (Alt+Right)">
                <Path Data="{StaticResource ZenIconForward}" Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>

              <!-- 5. #reload-button (nucleo/reload.svg) -->
              <Button x:Name="ZenReloadButton" Grid.Column="8" Width="34" Height="34" Style="{StaticResource ZenTopActionButtonStyle}" Click="Reload_Click" ToolTip="Обновить (Ctrl+R)">
                <Path Data="{StaticResource ZenIconReload}" Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>
            </Grid>

            <!-- 1. #urlbar (Clean #56565A capsule: domain text on left + Copy Link, Site Permissions, Translate on right) -->
            <Border x:Name="SidebarAddressBar" Grid.Row="1" Height="32" CornerRadius="8" Background="{DynamicResource Zen_56565A}" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="SidebarAddress_Click" ToolTip="Search or enter address (Ctrl+L)">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Zen_606065}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid Margin="10,0,5,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Domain / URL Text -->
                <TextBlock x:Name="SidebarDomainText" Grid.Column="0" Text="google.com" FontSize="12.5" Foreground="#F2F2F5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <!-- Editable Address Input Box -->
                <TextBox x:Name="SidebarAddressInput" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12.5" VerticalAlignment="Center" KeyDown="SidebarAddressInput_KeyDown" LostFocus="SidebarAddressInput_LostFocus"/>

                                <!-- Right icon 1: Luma Shield (IconShieldCheck) -->
                <Button x:Name="SidebarShieldBtn" Grid.Column="1" Width="22" Height="22" Style="{StaticResource ZenTopActionButtonStyle}" Click="SidebarShieldBtn_Click" ToolTip="Luma Shield">
                  <Path x:Name="SidebarShieldIcon" Data="{StaticResource IconShieldCheck}" Width="12" Height="12" Fill="#A78BFA" Stretch="Uniform"/>
                </Button>

                <!-- Right icon 1: Copy Link (nucleo/link.svg) -->
                <Button x:Name="UrlBarCopyLinkBtn" Grid.Column="2" Width="22" Height="22" Style="{StaticResource ZenTopActionButtonStyle}" Click="CopyUrl_Click" ToolTip="Copy Current URL">
                  <Path Data="{StaticResource ZenIconLink}" Width="12" Height="12" Fill="#D4D4D8" Stretch="Uniform"/>
                </Button>

                <!-- Right icon 2: Site Settings / Permissions (nucleo/sliders.svg) -->
                <Button x:Name="UrlBarPermissionsBtn" Grid.Column="3" Width="22" Height="22" Style="{StaticResource ZenTopActionButtonStyle}" Click="SiteSettings_Click" ToolTip="Site Permissions &amp; Protection">
                  <Path Data="{StaticResource ZenIconSliders}" Width="12" Height="12" Fill="#D4D4D8" Stretch="Uniform"/>
                </Button>

                <!-- Right icon 3: Translate Page (nucleo/translations.svg) -->
                <Button x:Name="UrlBarTranslateBtn" Grid.Column="4" Width="22" Height="22" Style="{StaticResource ZenTopActionButtonStyle}" Click="TranslateButton_Click" ToolTip="Translate Page">
                  <Path Data="{StaticResource ZenIconTranslations}" Width="12" Height="12" Fill="#D4D4D8" Stretch="Uniform"/>
                </Button>

                <!-- Right icon 4: Media Sniffer & Downloader -->
                <Button x:Name="UrlBarMediaSnifferBtn" Grid.Column="5" Width="22" Height="22" Visibility="Collapsed" Style="{StaticResource ZenTopActionButtonStyle}" Click="UrlBarMediaSnifferBtn_Click" ToolTip="Скачать медиа (видео/аудио)">
                  <Path Data="M 12 3 L 12 15 M 7 11 L 12 16 L 17 11 M 4 20 L 20 20" Stroke="#A78BFA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                </Button>


              </Grid>
            </Border>
            <!-- Luma Shield Glassmorphism Popup (Unified Sidebar Style) -->
            <Popup x:Name="ShieldPopup" PlacementTarget="{Binding ElementName=SidebarShieldBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
              <Border Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" CornerRadius="14" Padding="14,12" Width="260">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                  <!-- Header: Shield Icon + Title + Domain -->
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Zen_2C2C32}" BorderBrush="{DynamicResource Zen_4B4B50}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="{StaticResource IconShieldCheck}" Width="14" Height="14" Fill="#A78BFA" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Luma Shield" FontFamily="{StaticResource LumaFont}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ZenTextBrush}"/>
                      <TextBlock x:Name="ShieldDomainText" Text="Защита от рекламы" FontFamily="{StaticResource LumaFont}" FontSize="11" Foreground="{DynamicResource ZenMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>

                  <!-- Status card with toggle switch (Sidebar Theme) -->
                  <Border Background="{DynamicResource Zen_2C2C32}" BorderBrush="{DynamicResource Zen_4B4B50}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ShieldStatusText" Text="Защита активна" FontFamily="{StaticResource LumaFont}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource ZenTextBrush}"/>
                        <TextBlock x:Name="ShieldBlockedCountText" Text="Заблокировано: 0" FontFamily="{StaticResource LumaFont}" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,2,0,0"/>
                      </StackPanel>
                      <CheckBox x:Name="ShieldToggleCheckBox" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" Click="ShieldToggle_Click" Style="{StaticResource LumaToggleSwitch}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </Popup>

            <!-- 2. #zen-essentials-container -->
            <Border x:Name="ZenEssentialsWrapper" Grid.Row="2" Margin="0,0,0,8" AllowDrop="True" DragOver="ZenEssentials_DragOver" Drop="ZenEssentials_Drop" Background="Transparent" HorizontalAlignment="Left" Width="194">
              <UniformGrid x:Name="ZenEssentialsHost" Columns="4" HorizontalAlignment="Left" Width="194"/>
            </Border>

            <!-- 3. .zen-current-workspace-indicator (Monochrome briefcase.svg + Workspace Name) -->
            <Grid x:Name="ZenWorkspaceIndicatorRow" Grid.Row="3" Height="28" Margin="0,2,0,2" Background="#01000000" Cursor="Hand" MouseLeftButtonUp="ZenWorkspaceHeader_Click" ToolTip="Switch or edit workspace (Ctrl+Shift+E)">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ZenWorkspaceCol0" Width="36"/>
                <ColumnDefinition x:Name="ZenWorkspaceCol1" Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" Width="36" HorizontalAlignment="Center">
                <Path x:Name="ZenWorkspaceIconPath" Data="{StaticResource ZenIconBriefcase}" Width="14" Height="14" Fill="#D0D0D5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="ZenWorkspaceDotIcon" Width="8" Height="8" Fill="#D0D0D5" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZenWorkspaceEmojiBlock" Text="" FontSize="13" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="ZenWorkspaceNameBlock" Grid.Column="1" Text="Работа работенка" FontSize="12.5" FontWeight="SemiBold" Foreground="#DCDCE0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </Grid>

            <!-- 4. #vertical-pinned-tabs-container + .pinned-tabs-container-separator (1px line + ↓ Очистить) -->
            <StackPanel Grid.Row="4" Margin="0,0,0,2" AllowDrop="True" DragOver="ZenPinned_DragOver" Drop="ZenPinned_Drop" Background="Transparent">
              <Border x:Name="ZenPinnedWrapper" Visibility="Collapsed">
                <StackPanel x:Name="ZenPinnedTabsHost" Orientation="Vertical" Margin="0,0,0,4"/>
              </Border>

              <!-- .pinned-tabs-container-separator (always visible line + hover/visible ↓ Очистить on right, Screenshot 1) -->
              <Grid Height="18" Margin="2,0,2,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="ZenPinnedSeparator" Grid.Column="0" Height="1" Fill="{DynamicResource Zen_505056}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="ZenClearTabsBtn" Grid.Column="1" Click="ClearUnpinnedTabs_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Close all unpinned tabs">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource ZenIconArrowDown}" Width="8" Height="8" Fill="#A8A8B0" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,4,0"/>
                    <TextBlock Text="Очистить" FontSize="10.5" Foreground="#A8A8B0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="OverridesDefaultStyle" Value="True"/>
                      <Setter Property="Opacity" Value="0.85"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Opacity" Value="1.0"/>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </StackPanel>

            <!-- 5. #tabs-newtab-button (+ New Tab) -->
            <Button x:Name="ZenNewTabBtn" Grid.Row="5" Style="{StaticResource NewTabButtonStyle}" Click="NewTab_Click" Margin="0,0,0,2" ToolTip="Open a new tab (Ctrl+T)" HorizontalAlignment="Left" Width="194">
              <Grid x:Name="ZenNewTabInnerGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="ZenNewTabCol0" Width="36"/>
                  <ColumnDefinition x:Name="ZenNewTabCol1" Width="*"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="ZenNewTabPlusIcon" Grid.Column="0" Data="{StaticResource ZenIconPlus}" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="ZenNewTabLabel" Grid.Column="1" Text="New tab" FontSize="12.5" FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="4,0,0,0"/>
              </Grid>
            </Button>

            <!-- 6. #zen-tabs-wrapper / #tabbrowser-tabs -->
            <Border x:Name="TabsListContainer" Grid.Row="6" ClipToBounds="True" AllowDrop="True" DragOver="TabsList_DragOver" Drop="TabsList_Drop">
              <ListBox x:Name="TabsList" ItemsSource="{Binding Tabs}" SelectionChanged="TabsList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="0" AllowDrop="True" DragOver="TabsList_DragOver" Drop="TabsList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="MinHeight" Value="36"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="AllowDrop" Value="True"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                          <Border x:Name="TabBody" CornerRadius="8" Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True" AllowDrop="True" DragOver="TabItem_DragOver" Drop="TabItem_Drop" Height="36" HorizontalAlignment="Stretch">
                            <Grid ClipToBounds="True" PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="Tab_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="Tab_MouseRightButtonUp" MouseMove="Tab_MouseMove" MouseRightButtonUp="Tab_MouseRightButtonUp" MouseUp="Tab_MouseUp">

                              <!-- Single unified tab row: Stationary Favicon centered in 36px on left, text fades in smoothly -->
                              <Grid x:Name="SingleTabRow" Height="36" Margin="0" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="36"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>

                                <!-- Favicon: centered in the 36px left slot, stays in the exact same place whether 48px or 206px! -->
                                <Image x:Name="TabFaviconImage" Grid.Column="0" Source="{Binding FaviconUrl}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Title: smoothly clipped and faded -->
                                <TextBlock x:Name="TabTitleText" Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12.5" Foreground="#DCDCE0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,4,0"/>

                                <!-- Container Cookie Jar Color Stripe -->
                                <Border x:Name="ContainerStripe" Grid.Column="2" Width="2.5" Height="14" CornerRadius="1.2" Background="{Binding ContainerColor}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{Binding ContainerName}"/>

                                <!-- Interactive Audio Playing / Mute Button -->
                                <Button x:Name="TabAudioBtn" Grid.Column="3" Tag="{Binding}" Click="TabAudioMute_Click" Width="18" Height="18" Margin="0,0,2,0" Visibility="Collapsed" Cursor="Hand" VerticalAlignment="Center" ToolTip="Mute / Unmute tab">
                                  <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                      <Border x:Name="AudioBd" CornerRadius="4" Background="Transparent">
                                        <Path x:Name="AudioIconPath" Data="{StaticResource ZenIconAudio}" Width="11" Height="11" Fill="#E4E4E8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter TargetName="AudioBd" Property="Background" Value="{DynamicResource Zen_5E5E64}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                          <Setter TargetName="AudioIconPath" Property="Data" Value="{StaticResource ZenIconAudioMuted}"/>
                                          <Setter TargetName="AudioIconPath" Property="Fill" Value="#B0B0B6"/>
                                        </DataTrigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Button.Template>
                                </Button>

                                <!-- Close Button -->
                                <Button x:Name="TabCloseBtn" Grid.Column="4" Tag="{Binding}" Click="CloseTab_Click" Style="{StaticResource CloseTabButtonStyle}" Width="18" Height="18" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Close tab (Ctrl+W)"/>
                              </Grid>

                              <!-- ======== ZEN SPLIT VIEW UNIFIED GROUP CONTAINER ======== -->
                              <Border x:Name="SplitTabGroupRow" Visibility="Collapsed" MinHeight="36" Padding="3,2" CornerRadius="8" Background="{DynamicResource Zen_48484D}" BorderThickness="0">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>

                                  <!-- Left Split Sub-Tab -->
                                  <Border x:Name="SplitPrimaryPaneBd" Grid.Column="0" CornerRadius="6" Padding="5,4" Background="{DynamicResource Zen_56565A}" Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="SplitSubTabPrimary_Click" ToolTip="{Binding Title}">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>
                                      <Image Grid.Column="0" Source="{Binding PrimaryFaviconUrl}" Width="13" Height="13" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" Foreground="#F2F2F5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                      <Button Grid.Column="2" Tag="{Binding}" Click="SplitSubTabClosePrimary_Click" Style="{StaticResource CloseTabButtonStyle}" Width="16" Height="16" VerticalAlignment="Center" ToolTip="Close left pane"/>
                                    </Grid>
                                  </Border>

                                  <!-- Split Divider Bar -->
                                  <Border Grid.Column="1" Width="1" Height="16" Background="{DynamicResource Zen_636368}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                  <!-- Right Split Sub-Tab -->
                                  <Border x:Name="SplitSecondaryPaneBd" Grid.Column="2" CornerRadius="6" Padding="5,4" Background="Transparent" Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="SplitSubTabSecondary_Click" ToolTip="{Binding SecondaryTitle}">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>
                                      <Image Grid.Column="0" Source="{Binding SecondaryFaviconUrl}" Width="13" Height="13" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                      <TextBlock Grid.Column="1" Text="{Binding SecondaryTitle}" FontSize="11" Foreground="#F2F2F5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                      <Button Grid.Column="2" Tag="{Binding}" Click="SplitSubTabCloseSecondary_Click" Style="{StaticResource CloseTabButtonStyle}" Width="16" Height="16" VerticalAlignment="Center" ToolTip="Close right pane"/>
                                    </Grid>
                                  </Border>

                                  <!-- Unsplit Action Button -->
                                  <Button Grid.Column="3" Tag="{Binding}" Click="UnsplitTab_Click" Style="{StaticResource ZenTopActionButtonStyle}" Width="20" Height="22" Margin="3,0,0,0" ToolTip="Unsplit (Ctrl+Alt+V)">
                                    <Path Data="{StaticResource ZenIconSplit}" Width="11" Height="11" Stroke="#D0D0D5" StrokeThickness="1.5" Stretch="Uniform"/>
                                  </Button>
                                </Grid>
                              </Border>
                            </Grid>
                          </Border>

                          <ControlTemplate.Triggers>
                            <!-- In Collapsed mode: fade text out and hide close/audio buttons cleanly with zero layout shift -->
                            <DataTrigger Binding="{Binding IsSidebarVisualExpanded, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="False">
                              <Setter TargetName="TabTitleText" Property="Opacity" Value="0"/>
                              <Setter TargetName="TabCloseBtn" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="TabAudioBtn" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="ContainerStripe" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="SplitTabGroupRow" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSidebarVisualExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                              <Setter TargetName="TabTitleText" Property="Opacity" Value="0"/>
                              <Setter TargetName="TabCloseBtn" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="TabAudioBtn" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="ContainerStripe" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="SplitTabGroupRow" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowAudioButton}" Value="True"/>
                                <Condition Binding="{Binding IsSidebarVisualExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter TargetName="TabAudioBtn" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasContainer}" Value="True"/>
                                <Condition Binding="{Binding IsSidebarVisualExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter TargetName="ContainerStripe" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSplit}" Value="True"/>
                                <Condition Binding="{Binding IsSidebarVisualExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter TargetName="SingleTabRow" Property="Visibility" Value="Collapsed"/>
                              <Setter TargetName="SplitTabGroupRow" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSecondaryPaneActive}" Value="True">
                              <Setter TargetName="SplitPrimaryPaneBd" Property="Background" Value="Transparent"/>
                              <Setter TargetName="SplitSecondaryPaneBd" Property="Background" Value="{DynamicResource Zen_56565A}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="TabBody" Property="Background" Value="{DynamicResource Zen_48484D}"/>
                              <Setter TargetName="TabTitleText" Property="Foreground" Value="#FFFFFF"/>
                              <Setter TargetName="TabCloseBtn" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="TabBody" Property="Background" Value="{DynamicResource Zen_56565A}"/>
                              <Setter TargetName="TabTitleText" Property="Foreground" Value="#FFFFFF"/>
                              <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold"/>
                              <Setter TargetName="TabCloseBtn" Property="Opacity" Value="1"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Border>

            <!-- 7. #zen-sidebar-foot-buttons (Exact 3-element Zen footer: Left = #zen-library-button | Center = #zen-workspaces-button | Right = #zen-create-new-button) -->
            <Grid Grid.Row="7" Height="32" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <!-- Left: #zen-library-button (library.svg) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Center: #zen-workspaces-button (centered monochrome icons & dots) -->
                <ColumnDefinition Width="*"/>
                <!-- Right: #zen-create-new-button (plus.svg) -->
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Left: #zen-library-button -->
              <Button x:Name="ZenToolsDrawerFooterBtn" Grid.Column="0" Style="{StaticResource ZenTopActionButtonStyle}" Click="ToggleToolsDrawer_Click" ToolTip="Open Library (Ctrl+H)">
                <Path Data="{StaticResource ZenIconLibrary}" Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>

              <!-- Center: #zen-workspaces-button (<zen-workspace-icons>) -->
              <ScrollViewer x:Name="ZenWorkspaceStripScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="ZenWorkspaceStripHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </ScrollViewer>

              <!-- Right: #zen-create-new-button -->
              <Button x:Name="ZenCreateNewBtn" Grid.Column="2" Style="{StaticResource ZenTopActionButtonStyle}" Click="CreateNewButton_Click" ToolTip="Create New Space or Folder (Ctrl+Shift+E)">
                <Path Data="{StaticResource ZenIconPlus}" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
              </Button>
            </Grid>

            <!-- Hidden backing elements for full compatibility with code-behind references -->
            <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
              <Button x:Name="ZenCompactModeBtn"/>
              <Border x:Name="SidebarContainerBadge"><StackPanel><Ellipse x:Name="SidebarContainerDot"/><TextBlock x:Name="SidebarContainerText"/></StackPanel></Border>
              <Border x:Name="ZenWorkspaceContainerPill"><TextBlock x:Name="ZenWorkspaceContainerLabel"/></Border>
              <Button x:Name="ZenBottomWorkspaceBtn"><TextBlock x:Name="ZenBottomWorkspaceIconText"/></Button>
              <Button x:Name="ZenSplitViewFooterBtn"/>
              <Button x:Name="ZenSettingsFooterBtn"/>
              <Button x:Name="DiscordEssentialBtn"/><Button x:Name="GoogleEssentialBtn"/>
              <Button x:Name="ZenSpacePill0"/><Button x:Name="ZenSpacePill1"/><Button x:Name="ZenSpacePill2"/><Button x:Name="ZenSpacePill3"/>
              <Grid x:Name="ZenEssentialsGrid"/><StackPanel x:Name="ZenEssentialsCollapsed"/>
              <StackPanel x:Name="SpaceContentRoot"><StackPanel.RenderTransform><TranslateTransform x:Name="SpaceContentTranslate"/></StackPanel.RenderTransform></StackPanel>
              <ItemsControl x:Name="ProfileAvatars"/>
              <Grid x:Name="AvatarAddButton"/>
              <Border x:Name="PinnedContainer"><StackPanel x:Name="LooseItemsHost"/></Border>
              <Border x:Name="FoldersContainer"><StackPanel x:Name="FoldersHost"/></Border>
              <Image x:Name="FoldersHeaderIcon"/><Image x:Name="AddFolderIcon"/>
              <TextBlock x:Name="SidebarProfileFallback"/><Image x:Name="SidebarProfileAvatarImage"/>
              <TextBlock x:Name="SidebarProfileName"/><TextBlock x:Name="SidebarProfileStatus"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- ============ ZEN LIBRARY (<zen-library> — 1:1 Official ZenLibrary.mjs, zen-library.css & Screenshot 2) ============ -->
      <Border x:Name="ToolsDrawerBorder" Grid.Column="1" Width="0" Visibility="Collapsed"
              Background="{DynamicResource Zen_3D3D42}"
              BorderThickness="0"
              ClipToBounds="True" Panel.ZIndex="25">
        <Grid x:Name="ToolsDrawerInnerGrid" Width="418">
          <Grid.RenderTransform>
            <TranslateTransform x:Name="ToolsDrawerTranslate" X="0" Y="0"/>
          </Grid.RenderTransform>
          <Grid.ColumnDefinitions>
            <!-- #zen-library-side (106px left rail with linear-gradient(to right, transparent, rgba(255,255,255,0.08))) -->
            <ColumnDefinition Width="106"/>
            <!-- #zen-library-content (312px right content, seamless #3D3D42) -->
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- #zen-library-side (zen-library.css lines 36-44: no hard border, horizontal gradient from #3D3D42 to #4B4B50) -->
          <Border Grid.Column="0" BorderThickness="0" Padding="0,12,0,8">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#3D3D42" Offset="0.0"/>
                <GradientStop Color="#4B4B50" Offset="1.0"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- #zen-library-sidebar-tabs (Vertically centered 5 tabs: Media, Downloads, Boosts, Spaces, History) -->
              <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <!-- 1. Media (library-media-sprite.svg) -->
                <Button x:Name="DrawerNavMediaBtn" Style="{StaticResource DrawerNavRailButtonStyle}" Tag="Media" Click="DrawerNav_Click" MouseRightButtonUp="DrawerNavTab_RightClick" ToolTip="Media">
                  <Grid Width="86" Height="66">
                    <Rectangle x:Name="CustomizeOutlineMedia" RadiusX="10" RadiusY="10" Stroke="#88FFFFFF" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                        <Canvas Width="128" Height="128">
                          <Rectangle x:Name="LibMediaBackCard" Width="85.4" Height="65.8" Canvas.Left="6" Canvas.Top="8" RadiusX="9.26" RadiusY="9.26" Fill="{DynamicResource Zen_444449}" Stroke="#D0D0D5" StrokeThickness="7.1" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="-7"/></Rectangle.RenderTransform>
                          </Rectangle>
                          <Canvas Canvas.Left="32.56" Canvas.Top="41.29">
                            <Rectangle x:Name="LibMediaFrontCard" Width="85.44" Height="65.79" Canvas.Left="3.55" Canvas.Top="3.55" RadiusX="9.26" RadiusY="9.26" Fill="{DynamicResource Zen_444449}" Stroke="#D0D0D5" StrokeThickness="7.1"/>
                            <Path x:Name="LibMediaMountain" Data="{StaticResource ZenLibMediaMountain}" Fill="#D0D0D5"/>
                          </Canvas>
                          <Ellipse x:Name="LibMediaSun" Width="19.83" Height="19.83" Canvas.Left="54.85" Canvas.Top="57.9" Fill="#D0D0D5"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock x:Name="LibMediaLabel" Text="Media" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 2. Downloads (library-downloads-sprite.svg) -->
                <Button x:Name="DrawerNavDownloadsBtn" Style="{StaticResource DrawerNavRailButtonStyle}" Tag="Downloads" Click="DrawerNav_Click" MouseRightButtonUp="DrawerNavTab_RightClick" ToolTip="Downloads">
                  <Grid Width="86" Height="66">
                    <Rectangle x:Name="CustomizeOutlineDownloads" RadiusX="10" RadiusY="10" Stroke="#88FFFFFF" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                        <Canvas Width="128" Height="128">
                          <Ellipse x:Name="LibDownloadsCircle" Width="95" Height="95" Canvas.Left="16.5" Canvas.Top="16.5" Fill="Transparent" Stroke="#D0D0D5" StrokeThickness="7.1"/>
                          <Path x:Name="LibDownloadsArrow" Data="{StaticResource ZenLibDownloadsArrow}" Stroke="#D0D0D5" StrokeThickness="7.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock x:Name="LibDownloadsLabel" Text="Downloads" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 3. Boosts (library-boosts-sprite.svg) -->
                <Button x:Name="DrawerNavBoostsBtn" Style="{StaticResource DrawerNavRailButtonStyle}" Tag="Boosts" Click="DrawerNav_Click" MouseRightButtonUp="DrawerNavTab_RightClick" ToolTip="Boosts">
                  <Grid Width="86" Height="66">
                    <Rectangle x:Name="CustomizeOutlineBoosts" RadiusX="10" RadiusY="10" Stroke="#88FFFFFF" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                        <Canvas Width="128" Height="128">
                          <Rectangle x:Name="LibBoostsCard" Width="76" Height="76" Canvas.Left="38" Canvas.Top="12" RadiusX="14" RadiusY="14" Fill="Transparent" Stroke="#D0D0D5" StrokeThickness="7.1" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="-15"/></Rectangle.RenderTransform>
                          </Rectangle>
                          <Path x:Name="LibBoostsBrush" Data="{StaticResource ZenLibBoostsBrush}" Fill="#D0D0D5"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock x:Name="LibBoostsLabel" Text="Boosts" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 4. Spaces (library-spaces-sprite.svg) -->
                <Button x:Name="DrawerNavSpacesBtn" Style="{StaticResource DrawerNavRailButtonStyle}" Tag="Spaces" Click="DrawerNav_Click" MouseRightButtonUp="DrawerNavTab_RightClick" ToolTip="Spaces">
                  <Grid Width="86" Height="66">
                    <Rectangle x:Name="CustomizeOutlineSpaces" RadiusX="10" RadiusY="10" Stroke="#88FFFFFF" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                        <Canvas Width="128" Height="128">
                          <Rectangle x:Name="LibSpacesBackCard" Width="62.94" Height="82.26" Canvas.Left="18" Canvas.Top="20" RadiusX="10.45" RadiusY="10.45" Fill="{DynamicResource Zen_444449}" Stroke="#D0D0D5" StrokeThickness="7.1" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="-17.5"/></Rectangle.RenderTransform>
                          </Rectangle>
                          <Rectangle x:Name="LibSpacesFrontCard" Width="62.94" Height="82.26" Canvas.Left="45.55" Canvas.Top="34.8" RadiusX="10.45" RadiusY="10.45" Fill="{DynamicResource Zen_444449}" Stroke="#D0D0D5" StrokeThickness="7.1"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock x:Name="LibSpacesLabel" Text="Spaces" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 5. History (library-history-sprite.svg — Active by default, Screenshot 2) -->
                <Button x:Name="DrawerNavHistoryBtn" Style="{StaticResource DrawerNavRailButtonStyle}" Background="{DynamicResource Zen_55555A}" Tag="History" Click="DrawerNav_Click" MouseRightButtonUp="DrawerNavTab_RightClick" ToolTip="History">
                  <Grid Width="86" Height="66">
                    <Rectangle x:Name="CustomizeOutlineHistory" RadiusX="10" RadiusY="10" Stroke="#88FFFFFF" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                        <Canvas Width="128" Height="128">
                          <Path x:Name="LibHistoryBody" Data="{StaticResource ZenLibHistoryBody}" Fill="#75777E" Stroke="#F2F2F5" StrokeThickness="7.1" StrokeLineJoin="Round"/>
                          <Rectangle x:Name="LibHistoryLid" Width="86.6" Height="18.54" Canvas.Left="20.68" Canvas.Top="27.88" RadiusX="6.05" RadiusY="6.05" Fill="#75777E" Stroke="#F2F2F5" StrokeThickness="7.1"/>
                          <Path x:Name="LibHistoryDash" Data="{StaticResource ZenLibHistoryDash}" Stroke="#F2F2F5" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock x:Name="LibHistoryLabel" Text="History" FontSize="11.5" FontWeight="SemiBold" Foreground="#F2F2F5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 6. Whiteboard (Интерактивная доска со шрифтом Propysy - БЛОК 1) -->
                <RadioButton x:Name="DrawerNavWhiteboardBtn"
                             Style="{StaticResource WhiteboardNavButtonStyle}"
                             GroupName="ZenLibraryTabsGroup"
                             Tag="Whiteboard"
                             Click="DrawerNav_Click"
                             Checked="DrawerNav_Click"
                             ToolTip="Интерактивная доска (Каллиграфия Propysy)"/>

                <!-- Hidden compat buttons -->
                <Button x:Name="DrawerNavTimeMachineBtn" Visibility="Collapsed" Tag="TimeMachine" Click="DrawerNav_Click"/>
                <Button x:Name="DrawerNavScrapbookBtn" Visibility="Collapsed" Tag="Scrapbook" Click="DrawerNav_Click"/>
              </StackPanel>

              <!-- #zen-library-footer (ZenLibrary.mjs lines 1022-1059: back.svg, paintbrush-fill.svg, heart-circle-fill.svg) -->
              <Grid Grid.Row="1" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="28" Height="28" Style="{StaticResource ZenTopActionButtonStyle}" Click="ToggleToolsDrawer_Click" ToolTip="Close library">
                  <Path Data="{StaticResource ZenIconBack}" Width="14" Height="14" Fill="#D0D0D5" Stretch="Uniform"/>
                </Button>
                <Button x:Name="ZenLibraryCustomizeBtn" Grid.Column="1" Width="28" Height="28" Style="{StaticResource ZenTopActionButtonStyle}" Click="ZenLibraryCustomize_Click" ToolTip="Choose tabs">
                  <Path Data="{StaticResource ZenIconPaintbrush}" Width="14" Height="14" Fill="#D0D0D5" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="2" Width="28" Height="28" Style="{StaticResource ZenTopActionButtonStyle}" Click="AboutMenu_Click" ToolTip="О программе Luma">
                  <Path Data="{StaticResource ZenIconHeartCircle}" Width="14" Height="14" Fill="#D0D0D5" Stretch="Uniform"/>
                </Button>
              </Grid>
            </Grid>
          </Border>

          <!-- #zen-library-content -->
          <Grid x:Name="ZenLibraryContentGrid" Grid.Column="1" Background="{DynamicResource Zen_3D3D42}">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="ZenLibraryContentTranslate" X="0" Y="0"/>
            </Grid.RenderTransform>
            
            <!-- ================= VIEW 1: HISTORY (ZenLibraryHistorySection.mjs & Screenshot 2) ================= -->
            <Grid x:Name="DrawerHistoryView" Visibility="Visible" Margin="14,12,12,10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- .zen-library-search-top (Search History... + Filter button with circle-bars-filter.svg) -->
              <Grid x:Name="HistorySearchTopGrid" Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="36" CornerRadius="12" Background="{DynamicResource Zen_4B4B50}" Margin="0,0,8,0">
                  <Grid Margin="12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource ZenIconSearchGlass}" Width="15" Height="15" Fill="#A8A8B0" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="DrawerHistorySearchBox" Grid.Column="1" TextChanged="DrawerHistorySearchBox_TextChanged"
                             Background="Transparent" BorderThickness="0" Foreground="#F2F2F5"
                             CaretBrush="#F2F2F5" FontSize="13.5" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DrawerSearchPlaceholder" Grid.Column="1" Text="Search History..." FontSize="13.5" Foreground="#A8A8B0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  </Grid>
                </Border>

                <Button x:Name="HistoryFilterToggleBtn" Grid.Column="1" Height="36" Padding="12,0" Background="{DynamicResource Zen_49494E}" Cursor="Hand" Click="HistoryFilterToggle_Click" ToolTip="Filter History">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="FilterBd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Path Data="{StaticResource ZenIconCircleBarsFilter}" Width="15" Height="15" Fill="#DCDCE0" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                          <TextBlock Text="Filter" FontSize="13.5" FontWeight="Medium" Foreground="#F0F0F4" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="FilterBd" Property="Background" Value="{DynamicResource Zen_55555A}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>

              <!-- .zen-library-filter-panel (ZenLibrarySearchSection.mjs & ZenLibraryHistorySection.mjs lines 288-318) -->
              <Border x:Name="HistoryFilterPanel" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Zen_3D3D42}" Padding="2,4,2,12" Margin="0,0,0,8" BorderBrush="{DynamicResource Zen_525258}" BorderThickness="0,0,0,1">
                <StackPanel>
                  <Grid Margin="0,0,0,12">
                    <TextBlock Text="Filter History…" FontSize="14" FontWeight="Bold" Foreground="#F2F2F5" VerticalAlignment="Center"/>
                    <Button Content="Done" HorizontalAlignment="Right" Click="HistoryFilterToggle_Click" Cursor="Hand" Padding="14,7" Background="{DynamicResource Zen_4B4B50}" Foreground="#F2F2F5" FontWeight="SemiBold" FontSize="13">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="DoneBd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="DoneBd" Property="Background" Value="{DynamicResource Zen_58585E}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>

                  <TextBlock Text="When was it visited?" FontSize="12.5" FontWeight="SemiBold" Foreground="#DCDCE0" Margin="0,4,0,8"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="HistFilterWhenTodayBtn" Content="Today" Tag="when:today" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_4B4B50}" Foreground="#F2F2F5" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button x:Name="HistFilterWhenWeekBtn" Content="This Week" Tag="when:week" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_4B4B50}" Foreground="#F2F2F5" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button x:Name="HistFilterWhenMonthBtn" Content="This Month" Tag="when:month" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_4B4B50}" Foreground="#F2F2F5" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                  </WrapPanel>

                  <TextBlock Text="Sort by" FontSize="12.5" FontWeight="SemiBold" Foreground="#DCDCE0" Margin="0,4,0,8"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="HistFilterSortDateBtn" Content="By Date" Tag="sort:date" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_63636A}" Foreground="#FFFFFF" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button x:Name="HistFilterSortSiteBtn" Content="By Site" Tag="sort:site" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_4B4B50}" Foreground="#F2F2F5" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                  </WrapPanel>

                  <TextBlock Text="What to look through" FontSize="12.5" FontWeight="SemiBold" Foreground="#DCDCE0" Margin="0,4,0,8"/>
                  <WrapPanel>
                    <Button x:Name="HistFilterSourceHistoryBtn" Content="History" Tag="source:history" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_63636A}" Foreground="#FFFFFF" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button x:Name="HistFilterSourceClosedBtn" Content="Closed tabs" Tag="source:closed" Click="HistoryFilterChip_Click" Margin="0,0,6,6" Padding="12,7" Background="{DynamicResource Zen_4B4B50}" Foreground="#F2F2F5" FontSize="12.5" Cursor="Hand">
                      <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- .zen-library-search-results (Grouped History List: Сегодня, Вчера, 4 дня назад) -->
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="DrawerHistoryGroupsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding GroupName}" FontSize="12" FontWeight="Bold" Foreground="#ADADB4" Margin="8,8,8,5"/>
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border CornerRadius="14" Background="Transparent" Padding="10,8" Margin="0,1" Cursor="Hand"
                                      PreviewMouseLeftButtonUp="DrawerHistoryItem_Click"
                                      MouseRightButtonUp="DrawerHistoryItem_RightClick">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Style.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Zen_4B4B50}"/>
                                      </Trigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
