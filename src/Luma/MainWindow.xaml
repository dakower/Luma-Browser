    <Popup x:Name="NewSpacePopup" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center" PlacementTarget="{Binding ElementName=SiteShell}" StaysOpen="True" Focusable="True" Opened="NewSpacePopup_Opened" Closed="NewSpacePopup_Closed">
      <Border Width="360" Style="{StaticResource PopupCard}" Padding="22,20,22,18">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="Assets/luma-mark.png" Width="34" Height="34" Margin="0,0,12,0" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="NewSpaceTitle" Text="&#x41D;&#x43E;&#x432;&#x43E;&#x435; &#x43F;&#x440;&#x43E;&#x441;&#x442;&#x440;&#x430;&#x43D;&#x441;&#x442;&#x432;&#x43E;" Foreground="White" FontSize="15.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="NewSpaceHint" Text="&#x41E;&#x442;&#x434;&#x435;&#x43B;&#x44C;&#x43D;&#x44B;&#x439; &#x43D;&#x430;&#x431;&#x43E;&#x440; &#x432;&#x43A;&#x43B;&#x430;&#x434;&#x43E;&#x43A; &#x438; &#x43F;&#x430;&#x43F;&#x43E;&#x43A;" Foreground="{DynamicResource ChromeMuted}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>

          <Border x:Name="NewSpaceField" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.4" Padding="13,10">
            <Grid>
              <TextBlock x:Name="NewSpacePlaceholder" Text="&#x41D;&#x430;&#x437;&#x432;&#x430;&#x43D;&#x438;&#x435; &#x43F;&#x440;&#x43E;&#x441;&#x442;&#x440;&#x430;&#x43D;&#x441;&#x442;&#x432;&#x430;" Foreground="{DynamicResource ChromeMuted}" FontSize="14.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="NewSpaceNameBox" Background="Transparent" Foreground="White" CaretBrush="{DynamicResource AccentMutedBrush}" SelectionBrush="{DynamicResource AccentBrush}" BorderThickness="0" Padding="0" FontSize="14.5" FontWeight="Medium" MaxLength="48" VerticalContentAlignment="Center" KeyDown="NewSpaceNameBox_KeyDown" TextChanged="NewSpaceNameBox_TextChanged" GotKeyboardFocus="NewSpaceNameBox_FocusChanged" LostKeyboardFocus="NewSpaceNameBox_FocusChanged"/>
            </Grid>
          </Border>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource MenuButton}" Click="CancelSpace_Click" Height="38" Background="{DynamicResource SurfaceRaisedBrush}" HorizontalContentAlignment="Center">
              <TextBlock Text="&#x41E;&#x442;&#x43C;&#x435;&#x43D;&#x430;" Foreground="#C8C3D4" FontSize="13.5" FontWeight="Medium"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource MenuButton}" Click="CreateSpace_Click" Height="38" Background="{DynamicResource AccentBrush}" HorizontalContentAlignment="Center">
              <TextBlock Text="&#x421;&#x43E;&#x437;&#x434;&#x430;&#x442;&#x44C;" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="NewFolderPopup" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center" PlacementTarget="{Binding ElementName=SiteShell}" StaysOpen="True" Focusable="True" Opened="NewFolderPopup_Opened" Closed="NewFolderPopup_Closed">
      <Border Width="360" Style="{StaticResource PopupCard}" Padding="22,20,22,18">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0">
              <Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconFolder}" Stroke="#F0B84E" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="NewFolderTitle" Text="&#x41D;&#x43E;&#x432;&#x430;&#x44F; &#x43F;&#x430;&#x43F;&#x43A;&#x430;" Foreground="White" FontSize="15.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="NewFolderHint" Text="&#x414;&#x430;&#x439;&#x442;&#x435; &#x435;&#x439; &#x43A;&#x43E;&#x440;&#x43E;&#x442;&#x43A;&#x43E;&#x435; &#x43F;&#x43E;&#x43D;&#x44F;&#x442;&#x43D;&#x43E;&#x435; &#x438;&#x43C;&#x44F;" Foreground="{DynamicResource ChromeMuted}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>

          <Border x:Name="NewFolderField" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.4" Padding="13,10">
            <Grid>
              <TextBlock x:Name="NewFolderPlaceholder" Text="&#x41D;&#x430;&#x437;&#x432;&#x430;&#x43D;&#x438;&#x435; &#x43F;&#x430;&#x43F;&#x43A;&#x438;" Foreground="{DynamicResource ChromeMuted}" FontSize="14.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="NewFolderNameBox" Background="Transparent" Foreground="White" CaretBrush="{DynamicResource AccentMutedBrush}" SelectionBrush="{DynamicResource AccentBrush}" BorderThickness="0" Padding="0" FontSize="14.5" FontWeight="Medium" MaxLength="48" VerticalContentAlignment="Center" KeyDown="NewFolderNameBox_KeyDown" TextChanged="NewFolderNameBox_TextChanged" GotKeyboardFocus="NewFolderNameBox_FocusChanged" LostKeyboardFocus="NewFolderNameBox_FocusChanged"/>
            </Grid>
          </Border>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource MenuButton}" Click="CancelFolder_Click" Height="38" Background="{DynamicResource SurfaceRaisedBrush}" HorizontalContentAlignment="Center">
              <TextBlock Text="&#x41E;&#x442;&#x43C;&#x435;&#x43D;&#x430;" Foreground="#C8C3D4" FontSize="13.5" FontWeight="Medium"/>
            </Button>
            <Button x:Name="NewFolderConfirm" Grid.Column="2" Style="{StaticResource MenuButton}" Click="CreateFolder_Click" Height="38" Background="{DynamicResource AccentBrush}" HorizontalContentAlignment="Center">
              <TextBlock x:Name="NewFolderConfirmText" Text="&#x421;&#x43E;&#x437;&#x434;&#x430;&#x442;&#x44C;" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="ToastPopup" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" PlacementTarget="{Binding ElementName=SiteShell}" StaysOpen="True">
      <Border Width="300" MinHeight="63" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}" Padding="16,12">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity=".4"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="ToastIconBg" Width="24" Height="24" CornerRadius="12" Background="#1F3D2B" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path x:Name="ToastIcon" Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconCheck}" Stroke="#22C55E" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ToastTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ToastSubtitle" Foreground="#9A96A6" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
