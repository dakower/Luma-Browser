    <!-- Modern Zen Auto-Update Banner Notification Popup -->
    <Popup x:Name="UpdateNotificationPopup" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" PlacementTarget="{Binding ElementName=SiteShell}" StaysOpen="True">
      <Border x:Name="UpdateNotificationCard" Width="360" CornerRadius="14" Background="{DynamicResource Zen_202022}" BorderBrush="{DynamicResource Zen_3D3D42}" BorderThickness="1" Padding="14,12">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity=".5"/>
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Icon Badge -->
          <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Zen_2C2C32}" BorderBrush="{DynamicResource Zen_3D3D42}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,12,0">
            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 12 3 A 9 9 0 0 1 21 12 L 18 12 M 12 21 A 9 9 0 0 1 3 12 L 6 12" Stroke="#A78BFA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>

          <!-- Text Details -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
              <TextBlock x:Name="UpdateNotificationTitle" Text="Доступно автообновление" Foreground="{DynamicResource ZenTextBrush}" FontSize="12.5" FontWeight="SemiBold"/>
              <Border Background="#35353E" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="UpdateNotificationTag" Text="v2.4.0" Foreground="#A78BFA" FontSize="9.5" FontWeight="Bold"/>
              </Border>
            </StackPanel>
            <TextBlock x:Name="UpdateNotificationSubtitle" Text="Новая версия готова к установке в один клик." Foreground="{DynamicResource ZenMutedBrush}" FontSize="11.5" LineHeight="16" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal">
              <Button x:Name="UpdateNotificationActionBtn" Height="28" Padding="12,0" Click="UpdateNotificationAction_Click" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#7468C7" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#8679D6"/></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Обновить сейчас" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
              </Button>
              <Button Height="28" Padding="10,0" Margin="6,0,0,0" Click="UpdateNotificationDismiss_Click" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Zen_2C2C32}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Позже" Foreground="{DynamicResource ZenMutedBrush}" FontSize="11"/>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- Close Icon -->
          <Button Grid.Column="2" VerticalAlignment="Top" Margin="4,-2,-2,0" Width="24" Height="24" Click="UpdateNotificationDismiss_Click" ToolTip="Закрыть" Cursor="Hand">
            <Button.Template>
              <ControlTemplate TargetType="Button">
