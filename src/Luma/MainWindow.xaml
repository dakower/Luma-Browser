                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Отмена" FontSize="12" FontWeight="SemiBold"/>
              </Button>

              <Button x:Name="ExtensionPromptInstallBtn" Grid.Column="3" Height="36" Padding="18,0" Background="{DynamicResource AccentBrush}" BorderBrush="Transparent" Foreground="White" Cursor="Hand" Click="ExtensionPromptInstall_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Opacity" Value=".9"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value=".6"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="ExtensionPromptInstallBtnText" Text="Добавить расширение" FontSize="12" FontWeight="SemiBold"/>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Popup>

