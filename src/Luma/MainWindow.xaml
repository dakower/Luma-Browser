              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconLogOut}" Stroke="#E08A93" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
