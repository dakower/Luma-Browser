              </ScrollViewer>
            </Grid>

            <!-- ================= VIEW 4: OFFLINE TIME MACHINE ================= -->
            <Grid x:Name="DrawerTimeMachineView" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="OFFLINE TIME MACHINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,2"/>
                <TextBlock Text="GZip DOM snapshots &amp; delta history" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="Snapshot Now" Click="TimeMachineSnapshotNow_Click" Height="30" Margin="0,0,4,0" Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                  <Button Grid.Column="1" Content="Compare Live Diff" Click="TimeMachineCompareLive_Click" Height="30" Margin="4,0,0,0" Background="{DynamicResource Zen_2C2C2E}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium" FontSize="11" Cursor="Hand"/>
                </Grid>
                <TextBlock x:Name="TimeMachineStatusText" Text="Select a snapshot below" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0"/>
              </StackPanel>

              <!-- Snapshots list -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="TimeMachineSnapshotsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTime}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DisplaySize}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Diff" Click="TimeMachineItemDiff_Click" Tag="{Binding}" Height="24" Padding="8,0" Margin="0,0,4,0" Background="#262629" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10.5" Cursor="Hand"/>
                            <Button Content="Replay" Click="TimeMachineItemReplay_Click" Tag="{Binding}" Height="24" Padding="8,0" Background="#1E3A8A" Foreground="#FFFFFF" FontSize="10.5" Cursor="Hand"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Live / Snapshot Diff Viewer -->
              <Border x:Name="TimeMachineDiffContainer" Grid.Row="2" Background="#141416" CornerRadius="7" Height="140" Margin="0,10,0,0" Padding="8" Visibility="Collapsed">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="TimeMachineDiffSummary" Grid.Row="0" Text="Diff Summary" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TimeMachineDiffLinesControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Text}" FontFamily="Consolas, monospace" FontSize="10" TextWrapping="NoWrap">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Type}" Value="Added">
                                    <Setter Property="Foreground" Value="#34D399"/>
                                    <Setter Property="Background" Value="#1A382B"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                    <Setter Property="Foreground" Value="#F87171"/>
                                    <Setter Property="Background" Value="#3D1A1A"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Type}" Value="Unchanged">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

            <!-- ================= VIEW 5: OMNI-SCRAPBOOK ================= -->
            <Grid x:Name="DrawerScrapbookView" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="OMNI-SCRAPBOOK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,2"/>
                <TextBlock Text="Research Dossiers &amp; Web Clips" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,10"/>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="Clip Selected" Click="ScrapbookClipSelection_Click" Height="30" Margin="0,0,4,0" Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="Ctrl+Shift+S"/>
                  <Button Grid.Column="1" Content="Export Dossier" Click="ScrapbookExportDossier_Click" Height="30" Margin="4,0,0,0" Background="{DynamicResource Zen_2C2C2E}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium" FontSize="11" Cursor="Hand"/>
                </Grid>

                <!-- Search / Filter -->
                <Border Height="30" CornerRadius="6" Background="{DynamicResource InputBackgroundBrush}">
                  <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Width="12" Height="12" Stroke="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="ScrapbookSearchBox" Grid.Column="1" TextChanged="ScrapbookSearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Clips List -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="ScrapbookClipsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="✕" Click="ScrapbookDeleteClip_Click" Tag="{Binding Id}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Cursor="Hand" Padding="4,0" BorderThickness="0"/>
                          </Grid>

                          <Border Background="#141416" CornerRadius="4" Padding="6" Margin="0,2,0,6">
                            <TextBlock Text="{Binding TextContent}" FontSize="11" Foreground="#D1D5DB" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                          </Border>

                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Copy Text" Click="ScrapbookCopyClip_Click" Tag="{Binding TextContent}" Background="#262629" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" Padding="6,2" Cursor="Hand">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                  </Border>
                                </ControlTemplate>
                              </Button.Template>
                            </Button>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!-- ================= VIEW 6: WHITEBOARD (Интерактивная школьная доска) ================= -->
            <Grid x:Name="DrawerWhiteboardView" Visibility="Collapsed" Background="#FFFFFF">
              <local:WhiteboardControl x:Name="WhiteboardPanel"/>
            </Grid>

          </Grid>
        </Grid>
      </Border>

      <Grid x:Name="SiteShell" Grid.Column="2" Margin="0,5,5,5" Background="{DynamicResource SurfaceInsetBrush}" ClipToBounds="True">
        


        <!-- Floating Window Controls & LumaAI (Single Toolbar Mode) -->
        <StackPanel x:Name="FloatingWindowControlsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Panel.ZIndex="100">
          <Button x:Name="FloatingAssistantButton" Style="{StaticResource AssistantPill}" Margin="0,0,8,0" Click="Assistant_Click" ToolTip="LumaAI (Ctrl+J)">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="Assets/luma-assistant.png" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="LumaAI" FontFamily="{StaticResource LumaDisplayFont}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="28" Height="26" Click="MinimizeWindow_Click" ToolTip="Свернуть">
            <Path Width="10" Height="10" Stretch="Uniform" Data="{StaticResource IconMinus}" Stroke="#8E8E93" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button Style="{StaticResource BareIconButton}" Width="28" Height="26" Click="MaximizeWindow_Click" ToolTip="Развернуть">
            <Path Width="10" Height="10" Stretch="Uniform" Data="{StaticResource IconSquare}" Stroke="#8E8E93" StrokeThickness="1.5" StrokeLineJoin="Round"/>
          </Button>
          <Button Style="{StaticResource WindowCloseButton}" Width="28" Height="26" Click="CloseWindow_Click" ToolTip="Закрыть">
            <Path Width="10" Height="10" Stretch="Uniform" Data="{StaticResource IconX}" Stroke="#8E8E93" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>

        <Grid x:Name="PaneHost" Background="Transparent" ClipToBounds="True"/>
        <Grid x:Name="EmptyBackground" Background="{DynamicResource ShellBrush}" ClipToBounds="True">
          <Grid.Resources>
            <Style x:Key="AccountInnerText" TargetType="TextBox">
              <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource ZenTextBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AccountInnerPassword" TargetType="PasswordBox">
              <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="AccountPrimary" TargetType="Button">
              <Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBorder" Property="Opacity" Value=".92"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryBorder" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryBorder" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="AccountTab" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ZenMutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value=".88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="AccountLink" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ZenMutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6"/></Style>
            <Style x:Key="AccountGhost" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Background" Value="{DynamicResource Zen_4B4B50}"/><Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource Zen_5A5A60}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="GhostBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource Zen_56565A}"/><Setter TargetName="GhostBorder" Property="BorderBrush" Value="{DynamicResource Zen_68686E}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="GhostBorder" Property="Opacity" Value=".82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="HomeOptionCard" TargetType="Button">
              <Setter Property="Height" Value="48"/>
              <Setter Property="Margin" Value="0,0,0,6"/>
              <Setter Property="Background" Value="{DynamicResource Zen_4B4B50}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Zen_505056}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="12,0">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Zen_5E5E64}"/>
                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Zen_56565A}"/>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardBorder" Property="Opacity" Value=".75"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="HomeSegmentButton" TargetType="Button">
              <Setter Property="Height" Value="36"/>
              <Setter Property="Background" Value="{DynamicResource Zen_4B4B50}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Zen_505056}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="OverridesDefaultStyle" Value="True"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="SegBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="8,0">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegBorder" Property="BorderBrush" Value="{DynamicResource Zen_5E5E64}"/></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="SegBorder" Property="Opacity" Value=".75"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>

          <!-- Custom Wallpaper Layer -->
          <Image x:Name="HomeCustomWallpaper" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Rectangle x:Name="HomeWallpaperDimOverlay" Fill="#000000" Opacity="0.35" Visibility="Collapsed" IsHitTestVisible="False"/>

          <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-270,-310,0,0" Opacity=".02" Fill="{DynamicResource HomeGlowBrush}" IsHitTestVisible="False" CacheMode="BitmapCache"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyOrb1Transform"/></Ellipse.RenderTransform></Ellipse>
          <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-230,-280" Opacity=".015" Fill="{DynamicResource HomeGlowBrush}" IsHitTestVisible="False" CacheMode="BitmapCache"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyOrb2Transform"/></Ellipse.RenderTransform></Ellipse>
          <Ellipse Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".015" Fill="{DynamicResource HomeGlowSoftBrush}" IsHitTestVisible="False" CacheMode="BitmapCache"><Ellipse.OpacityMask><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.OpacityMask><Ellipse.RenderTransform><TranslateTransform x:Name="EmptyOrb3Transform"/></Ellipse.RenderTransform></Ellipse>

          <Grid x:Name="HomeSurfaceContent" MaxWidth="820" Margin="40,20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel MaxWidth="660" HorizontalAlignment="Center">
              <!-- Minimalist Logo & Brand -->
              <StackPanel x:Name="HomeBrandPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Zen_4B4B50}" BorderBrush="{DynamicResource Zen_5A5A60}" BorderThickness="1">
                  <Image Source="Assets/luma-mark.png" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Luma" Foreground="{DynamicResource ZenTextBrush}" FontFamily="{StaticResource LumaDisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Swiss Digital Clock & Date -->
              <StackPanel x:Name="HomeClockPanel" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="HomeClockText" Text="12:00" Foreground="{DynamicResource ZenTextBrush}" FontFamily="{StaticResource LumaDisplayFont}" FontSize="60" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock x:Name="HomeDateText" Text="Сегодня" Foreground="{DynamicResource ZenMutedBrush}" FontFamily="{StaticResource LumaFont}" FontSize="13" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>

              <!-- Elegant Minimalist Headline -->
              <TextBlock x:Name="HomeHeadlineText" Text="Куда отправимся?" Foreground="{DynamicResource ZenTextBrush}" FontFamily="{StaticResource LumaDisplayFont}" FontSize="24" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,0,0,22"/>

              <!-- Minimalist Search Shell (Unified with Widget Design System) -->
              <Border x:Name="HomeSearchShell" Height="48" Width="640" CornerRadius="16" Background="{DynamicResource ZenCardBrush}" BorderBrush="{DynamicResource ZenCardBorderBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="16,0,7,0">
                <Border.Effect>
                  <DropShadowEffect x:Name="HomeSearchShadow" Color="#000000" BlurRadius="22" ShadowDepth="3" Opacity=".20"/>
                </Border.Effect>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="34"/>
                  </Grid.ColumnDefinitions>
                  <Path Style="{StaticResource ZLinePath}" Width="16" Height="16" Data="{StaticResource ZLineSearch}" Stroke="{DynamicResource ZenMutedBrush}" VerticalAlignment="Center"/>
                  <Grid Grid.Column="1" Margin="8,0,10,0">
                    <TextBlock x:Name="HomeSearchPlaceholder" Text="Поиск в интернете или адрес сайта..." FontFamily="{StaticResource LumaFont}" Foreground="{DynamicResource ZenMutedBrush}" FontSize="13.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="HomeSearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ZenTextBrush}" CaretBrush="{DynamicResource ZenTextBrush}" FontFamily="{StaticResource LumaFont}" FontSize="13.5" FontWeight="Normal" VerticalContentAlignment="Center" TextChanged="HomeSearchBox_TextChanged" KeyDown="HomeSearchBox_KeyDown"/>
                  </Grid>
                  <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" OverridesDefaultStyle="True" Cursor="Hand" Click="HomeSearchSubmit_Click" ToolTip="Искать">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="HomeSearchSubmitBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                          <Path Style="{StaticResource ZLinePath}" Width="14" Height="14" Data="{StaticResource ZLineRight}" Stroke="{DynamicResource ZenTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HomeSearchSubmitBorder" Property="Background" Value="{DynamicResource Zen_56565A}"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HomeSearchSubmitBorder" Property="Opacity" Value=".74"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Border>

              <!-- Quick Action Pills Row -->
              <Grid x:Name="HomeQuickPillsGrid" Width="640">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource HomeQuickPill}" Click="Downloads_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Style="{StaticResource ZLinePath}" Width="15" Height="15" Data="{StaticResource ZLineDownload}" Stroke="{DynamicResource ZenIconBrush}"/>
                    <TextBlock Text="Загрузки" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HomeQuickPill}" Click="History_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Style="{StaticResource ZLinePath}" Width="15" Height="15" Data="{StaticResource ZLineClock}" Stroke="{DynamicResource ZenIconBrush}"/>
                    <TextBlock Text="История" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource HomeQuickPill}" Click="Settings_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Style="{StaticResource ZLinePath}" Width="15" Height="15" Data="{StaticResource ZLineSliders}" Stroke="{DynamicResource ZenIconBrush}"/>
                    <TextBlock Text="Настройки" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource HomeQuickPill}" Click="Account_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Style="{StaticResource ZLinePath}" Width="15" Height="15" Data="{StaticResource ZLineUser}" Stroke="{DynamicResource ZenIconBrush}"/>
                    <TextBlock Text="Аккаунт" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Live Media Glance Card -->
              <Border x:Name="HomeMediaCard" Width="640" Height="60" CornerRadius="16" Background="{DynamicResource ZenCardBrush}" BorderBrush="{DynamicResource ZenCardBorderBrush}" BorderThickness="1" Margin="0,16,0,0" Padding="14,8" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="HomeMediaCard_Click" ToolTip="Перейти к вкладке с медиа">
                <Border.Effect>
                  <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity=".24"/>
                </Border.Effect>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="44" Height="44">
                    <Border CornerRadius="9" Background="{DynamicResource Zen_2C2C32}" ClipToBounds="True"/>
                    <Path x:Name="HomeMediaFallbackIcon" Style="{StaticResource ZLinePath}" Width="18" Height="18" Data="{StaticResource ZLineMusic}" Stroke="{DynamicResource ZenIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="HomeMediaArt" Visibility="Collapsed" Stretch="UniformToFill">
                      <Image.Clip>
                        <RectangleGeometry Rect="0,0,44,44" RadiusX="9" RadiusY="9"/>
                      </Image.Clip>
                    </Image>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HomeMediaTitle" Text="Воспроизведение" Foreground="{DynamicResource ZenTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomeMediaArtist" Text="Медиа" Foreground="{DynamicResource ZenMutedBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <!-- Audio visualizer wave bars -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,14,0">
                    <Border Width="2.5" Height="12" CornerRadius="1.25" Background="{DynamicResource ZenMutedBrush}" Margin="1.5,0"/>
                    <Border Width="2.5" Height="18" CornerRadius="1.25" Background="{DynamicResource ZenTextBrush}" Margin="1.5,0"/>
                    <Border Width="2.5" Height="9" CornerRadius="1.25" Background="{DynamicResource ZenMutedBrush}" Margin="1.5,0"/>
                    <Border Width="2.5" Height="16" CornerRadius="1.25" Background="{DynamicResource ZenTextBrush}" Margin="1.5,0"/>
                    <Border Width="2.5" Height="11" CornerRadius="1.25" Background="{DynamicResource ZenMutedBrush}" Margin="1.5,0"/>
                  </StackPanel>
                  <!-- Toggle Play/Pause -->
                  <Button Grid.Column="3" Width="34" Height="34" Style="{StaticResource BareIconButton}" Click="HomeMediaToggle_Click" ToolTip="Воспроизведение / пауза">
                    <Grid Width="34" Height="34">
                      <Border CornerRadius="8" Background="{DynamicResource Zen_4B4B50}" BorderBrush="{DynamicResource Zen_5A5A60}" BorderThickness="1"/>
                      <Path x:Name="HomeMediaToggleIcon" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconPause}" Fill="Transparent" Stroke="{DynamicResource ZenTextBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </Grid>
              </Border>

              <!-- Recent Sites Modern Grid -->
              <Grid x:Name="HomeRecentSitesGrid" Width="640" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="HomeRecentButton1" Grid.Column="0" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon1" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle1" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain1" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
                <Button x:Name="HomeRecentButton2" Grid.Column="2" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon2" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle2" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain2" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
                <Button x:Name="HomeRecentButton3" Grid.Column="4" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon3" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle3" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain3" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
                <Button x:Name="HomeRecentButton4" Grid.Column="6" Style="{StaticResource HomeRecentTile}" Click="HomeRecentSite_Click">
                  <Grid Margin="13,12,13,10">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="30" Height="30" HorizontalAlignment="Left">
                      <Border CornerRadius="9" Background="{DynamicResource SurfaceInsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                      <Image x:Name="HomeRecentIcon4" Width="18" Height="18" ImageFailed="HomeRecentIcon_Failed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="HomeRecentTitle4" Foreground="{DynamicResource ChromeText}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="HomeRecentDomain4" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </Grid>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Live Support Trigger Button -->
          <Button x:Name="HomeSupportButton" Click="HomeSupport_Click" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,70,22" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ToolTip="Чат с поддержкой" Cursor="Hand" Style="{StaticResource BareIconButton}" Panel.ZIndex="5">
            <Grid Width="38" Height="38">
              <Border CornerRadius="19" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
              <Path x:Name="HomeSupportIconPath" Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconChevronUp}" Stroke="{DynamicResource ChromeSecondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform x:Name="HomeSupportIconRotate" Angle="0"/>
                </Path.RenderTransform>
              </Path>
              <Border x:Name="HomeSupportBadge" Width="9" Height="9" CornerRadius="4.5" Background="#7468C7" BorderBrush="{DynamicResource SurfaceRaisedBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Collapsed"/>
            </Grid>
          </Button>

          <!-- Live Support Chat Popup Card -->
          <Border x:Name="HomeSupportChatCard" Visibility="Collapsed" Width="360" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,68" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Panel.ZIndex="12" MouseLeftButtonDown="HomeSupportChatCard_MouseDown">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity=".45"/>
            </Border.Effect>
            <Border.RenderTransform>
              <TranslateTransform x:Name="HomeSupportChatTranslate" Y="20"/>
            </Border.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Header -->
              <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="15,15,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- Support Avatar -->
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#7468C7" Margin="0,0,10,0">
                    <Path Stretch="Uniform" Width="14" Height="14" Data="{StaticResource IconMessageSquarePlus}" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <!-- Titles -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Поддержка Luma" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                      <Border Width="6" Height="6" CornerRadius="3" Background="#79D9A5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="dakower онлайн · чат с разработчиком" FontSize="10.5" Foreground="{DynamicResource ChromeMuted}"/>
                    </StackPanel>
                  </StackPanel>
                  <!-- Close / Minimize Button -->
                  <Button Grid.Column="2" Click="HomeSupportClose_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Свернуть чат" Style="{StaticResource BareIconButton}">
                    <Path Stretch="Uniform" Width="12" Height="12" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource ChromeMuted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </Border>

              <!-- Messages Area (Row 1) -->
              <Grid Grid.Row="1">
                <!-- Signed-out state prompt -->
                <StackPanel x:Name="HomeSupportAuthPrompt" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0" MaxWidth="280">
                  <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Stretch="Uniform" Width="18" Height="18" Data="{StaticResource IconUserRound}" Stroke="{DynamicResource ChromeSecondary}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Вход в аккаунт" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                  <TextBlock Text="Войдите в аккаунт Luma, чтобы писать в поддержку и получать ответы напрямую от разработчика в реальном времени." FontSize="11.5" Foreground="{DynamicResource ChromeMuted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16" Margin="0,0,0,16"/>
                  <Button Click="HomeSupportOpenAccount_Click" Content="Войти в аккаунт" Height="32" Padding="14,0" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Resources>
                      <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                  </Button>
                </StackPanel>

                <!-- Chat content when authenticated -->
                <Grid x:Name="HomeSupportChatPanel" Visibility="Visible">
                  <ScrollViewer x:Name="HomeSupportScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                    <StackPanel>
                      <!-- Welcome message card -->
                      <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                          <TextBlock Text="Прямой чат с разработчиком" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ChromeText}" Margin="0,0,0,3"/>
                          <TextBlock Text="Задайте любой вопрос, идею или опишите проблему. Ответ придёт прямо сюда из Telegram разработчика в реальном времени!" FontSize="11" Foreground="{DynamicResource ChromeMuted}" TextWrapping="Wrap" LineHeight="15"/>
                        </StackPanel>
                      </Border>

                      <!-- Messages ListBox -->
                      <ListBox x:Name="HomeSupportMessagesList" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                  <ContentPresenter/>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,2">
                              <!-- Admin message (dakower) -->
                              <StackPanel HorizontalAlignment="Left" MaxWidth="270" Visibility="{Binding AdminVisibility}">
                                <TextBlock Text="{Binding Author}" FontSize="10.5" Foreground="#A29BFE" FontWeight="SemiBold" Margin="4,0,0,2"/>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4,12,12,12" Padding="10,8">
                                  <TextBlock Text="{Binding Body}" Foreground="{DynamicResource ChromeText}" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                </Border>
                                <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource ChromeMuted}" Margin="4,2,0,0"/>
                              </StackPanel>
                              <!-- Tester / User message -->
                              <StackPanel HorizontalAlignment="Right" MaxWidth="270" Visibility="{Binding UserVisibility}">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="12,12,4,12" Padding="10,8">
                                  <TextBlock Text="{Binding Body}" Foreground="White" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                </Border>
                                <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource ChromeMuted}" HorizontalAlignment="Right" Margin="0,2,4,0"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- Empty conversation prompt -->
                      <TextBlock x:Name="HomeSupportEmptyPrompt" Visibility="Collapsed" Text="Сообщений пока нет. Напишите первое сообщение ниже!" FontSize="11" Foreground="{DynamicResource ChromeMuted}" TextAlignment="Center" Margin="0,20,0,0"/>

                      <!-- Sending indicator -->
                      <TextBlock x:Name="HomeSupportSendingStatus" Visibility="Collapsed" Text="Отправка в Telegram..." FontSize="10" Foreground="{DynamicResource ChromeMuted}" FontStyle="Italic" HorizontalAlignment="Right" Margin="0,4,4,0"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>

              <!-- Input composer (Row 2) -->
              <Border x:Name="HomeSupportComposer" Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="0,0,15,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <TextBox x:Name="HomeSupportInputBox" PreviewKeyDown="HomeSupportInput_PreviewKeyDown" TextChanged="HomeSupportInput_TextChanged" MaxHeight="80" MinHeight="34" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource ChromeText}" CaretBrush="{DynamicResource ChromeText}" BorderThickness="0" Padding="6,6" FontSize="12.5" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="HomeSupportPlaceholder" IsHitTestVisible="False" Text="Напишите сообщение..." FontSize="12.5" Foreground="{DynamicResource ChromeMuted}" Margin="6,7,0,0" VerticalAlignment="Top"/>
                  </Grid>
                  <Button Grid.Column="1" x:Name="HomeSupportSendButton" Click="HomeSupportSend_Click" Width="32" Height="32" Background="{DynamicResource AccentBrush}" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="Отправить (Enter)">
                    <Button.Resources>
                      <Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style>
                    </Button.Resources>
                    <Path Stretch="Uniform" Width="13" Height="13" Data="{StaticResource IconArrowUp}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Dashboard Customize Trigger Button (hidden in favor of new bottom-right HomeDock) -->
          <Button x:Name="HomeCustomizeButton" Click="HomeCustomize_Click" Visibility="Collapsed" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" ToolTip="Настроить стартовый экран" Cursor="Hand" Style="{StaticResource BareIconButton}" Panel.ZIndex="5">
            <Grid Width="34" Height="34">
              <Border CornerRadius="9" Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1"/>
              <Path Style="{StaticResource ZLinePath}" Width="15" Height="15" Data="{StaticResource ZLineSliders}" Stroke="{DynamicResource ZenIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Button>

          <!-- Dashboard Customization Drawer / Studio (Zen Sidebar Style) -->
          <Grid x:Name="HomeCustomizeDrawerOverlay" Visibility="Collapsed" HorizontalAlignment="Right" Width="376" Panel.ZIndex="10">
            <Border x:Name="HomeCustomizeDrawer" Width="360" HorizontalAlignment="Right" Margin="0,8,8,8" CornerRadius="14" Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" MouseLeftButtonDown="HomeCustomizeDrawer_MouseDown">
              <Border.RenderTransform><TranslateTransform x:Name="HomeStudioTranslate"/></Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="0" Opacity=".5"/>
              </Border.Effect>
              <Grid x:Name="HomeStudioRoot"/>
            </Border>
          </Grid>

          <Button x:Name="AccountSurfaceCloseButton" Click="AccountSurfaceClose_Click" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0" Style="{StaticResource BareIconButton}" Cursor="Hand" Panel.ZIndex="4" ToolTip="Закрыть профиль">
            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1">
              <Path Style="{StaticResource ZLinePath}" Width="14" Height="14" Data="{StaticResource ZLineX}" Stroke="{DynamicResource ZenIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Button>

          <ScrollViewer x:Name="AccountSurfaceScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
            <Grid x:Name="AccountSurfaceContent" MaxWidth="920" Margin="40,32,40,40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid.RenderTransform><TranslateTransform x:Name="AccountSurfaceTranslate"/></Grid.RenderTransform>
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="AccountHeroColumn" Width=".9*"/><ColumnDefinition x:Name="AccountCardColumn" Width="1.1*"/></Grid.ColumnDefinitions>

              <!-- Left Zen Overview / Statistics Pane -->
              <StackPanel x:Name="AccountHeroPane" Margin="0,0,36,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Zen_4B4B50}" BorderBrush="{DynamicResource Zen_5A5A60}" BorderThickness="1">
                    <Image Source="Assets/luma-mark.png" Width="20" Height="20"/>
                  </Border>
                  <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Luma" Foreground="{DynamicResource ZenTextBrush}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="ПРОСТРАНСТВО И ПРОФИЛЬ" Foreground="{DynamicResource ZenMutedBrush}" FontSize="9" FontWeight="Bold"/>
                  </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource Zen_3D3D42}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" CornerRadius="14" Padding="22,20" Margin="0,20,0,14">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource ZLinePath}" Width="13" Height="13" Data="{StaticResource ZLineSpark}" Stroke="{DynamicResource ZenMutedBrush}"/>
                      <TextBlock x:Name="AccountHeroEyebrow" Text="LUMA ACCOUNT" Foreground="{DynamicResource ZenMutedBrush}" FontSize="10" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="AccountHeroTitle" Text="Авторизация" Foreground="{DynamicResource ZenTextBrush}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,8"/>
                    <TextBlock x:Name="AccountHeroDescription" Text="Войдите или создайте аккаунт, чтобы открыть&#x0a;возможности Luma." Foreground="{DynamicResource ZenMutedBrush}" FontSize="13" LineHeight="20"/>

                    <Grid x:Name="AccountStatsPanel" Visibility="Collapsed" Margin="0,18,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource Zen_2C2C32}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" Padding="11,10">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ZLinePath}" Width="12" Height="12" Data="{StaticResource ZLineClock}" Stroke="{DynamicResource ZenMutedBrush}"/>
                            <TextBlock Text="ВРЕМЯ" Foreground="{DynamicResource ZenMutedBrush}" FontSize="9" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock x:Name="AccountStatTime" Text="0 мин" Foreground="{DynamicResource ZenTextBrush}" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource Zen_2C2C32}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" Padding="11,10">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ZLinePath}" Width="12" Height="12" Data="{StaticResource ZLineGlobe}" Stroke="{DynamicResource ZenMutedBrush}"/>
                            <TextBlock Text="ТОП САЙТ" Foreground="{DynamicResource ZenMutedBrush}" FontSize="9" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock x:Name="AccountStatSite" Text="—" Foreground="{DynamicResource ZenTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="4" CornerRadius="10" Background="{DynamicResource Zen_2C2C32}" BorderBrush="{DynamicResource Zen_505056}" BorderThickness="1" Padding="11,10">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ZLinePath}" Width="12" Height="12" Data="{StaticResource ZLineChart}" Stroke="{DynamicResource ZenMutedBrush}"/>
                            <TextBlock Text="ВИЗИТЫ" Foreground="{DynamicResource ZenMutedBrush}" FontSize="9" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
