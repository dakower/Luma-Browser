              </StackPanel>
            </Grid>

            <!-- Permissions Block -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="Это расширение может:" Foreground="{DynamicResource ChromeText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="ExtensionPromptPermissionsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="14"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentMutedBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource ChromeSecondary}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ProgressBar x:Name="ExtensionPromptProgress" Grid.Column="0" Height="3" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>

