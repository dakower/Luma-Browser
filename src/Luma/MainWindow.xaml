              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconGear}" Fill="Transparent" Stroke="#C8C3D4" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="&#x41D;&#x430;&#x441;&#x442;&#x440;&#x43E;&#x439;&#x43A;&#x438;" Foreground="{DynamicResource ChromeSecondary}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
