    <Popup x:Name="ExtensionPromptPopup" AllowsTransparency="True" PopupAnimation="None" Placement="Bottom" PlacementTarget="{Binding ElementName=ExtensionsButton}" StaysOpen="False" HorizontalOffset="-366" VerticalOffset="6" Opened="ExtensionPromptPopup_Opened">
      <Grid Margin="18,4,18,28">
