          <Button Style="{StaticResource MenuButton}" Height="40" Click="NewSpaceMenu_Click" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconPanelsTopLeft}" Stroke="#C8C3D4" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="&#x41D;&#x43E;&#x432;&#x43E;&#x435; &#x43F;&#x440;&#x43E;&#x441;&#x442;&#x440;&#x430;&#x43D;&#x441;&#x442;&#x432;&#x43E;" Foreground="{DynamicResource ChromeSecondary}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuButton}" Height="40" Click="ClearTabs_Click" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconTrash2}" Stroke="#C8C3D4" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="&#x41E;&#x447;&#x438;&#x441;&#x442;&#x438;&#x442;&#x44C; &#x432;&#x440;&#x435;&#x43C;&#x435;&#x43D;&#x43D;&#x44B;&#x435; &#x432;&#x43A;&#x43B;&#x430;&#x434;&#x43A;&#x438;" Foreground="{DynamicResource ChromeSecondary}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuButton}" Height="40" Click="DefaultBrowser_Click" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal"><Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconGlobe}" Fill="Transparent" Stroke="#C8C3D4" StrokeThickness="1.8" Margin="0,0,12,0"/><TextBlock Text="Браузер по умолчанию" Foreground="{DynamicResource ChromeSecondary}" FontSize="13.5" FontWeight="Medium"/></StackPanel></Button><Border Height="1" Background="#1FFFFFFF" Margin="8,7"/>
          <Button Style="{StaticResource MenuButton}" Height="40" Click="CheckUpdates_Click" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconReload}" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="Проверить обновления" Foreground="{DynamicResource ChromeSecondary}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuButton}" Height="40" Click="AboutMenu_Click" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal"><Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconInfo}" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.8" Margin="0,0,12,0"/><TextBlock Text="О версии" Foreground="{DynamicResource ChromeSecondary}" FontSize="13.5" FontWeight="Medium"/></StackPanel></Button>
          <Button Style="{StaticResource MenuButton}" Height="40" Click="Exit_Click" HorizontalContentAlignment="Stretch">
