                    <TextBlock Text="⚡ Краткий" FontSize="11" FontWeight="SemiBold"/>
                  </Button>
                  <Button x:Name="SummaryDetailedBtn" Height="24" Padding="10,0" Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Cursor="Hand" Click="SummaryDetailedBtn_Click">
                    <TextBlock Text="📖 Подробный" FontSize="11" FontWeight="SemiBold"/>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>

            <Button Width="24" Height="24" Click="SummaryClose_Click" HorizontalAlignment="Right" Cursor="Hand" Style="{StaticResource ZenTopActionButtonStyle}">
              <Path Data="{StaticResource IconX}" Width="9" Height="9" Stretch="Uniform" Stroke="{DynamicResource ZenMutedBrush}" StrokeThickness="1.8"/>
            </Button>
          </Grid>

          <!-- Title & Source -->
          <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryTitleText" Text="Заголовок материала" Foreground="{DynamicResource ZenTextBrush}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SummarySourceText" Text="youtube.com" Foreground="{DynamicResource ZenMutedBrush}" FontSize="11.5" Margin="0,2,0,0"/>
          </StackPanel>

          <!-- Scrollable content -->
          <ScrollViewer Grid.Row="2" MaxHeight="450" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <TextBlock x:Name="SummaryBodyText" Text="Анализирую содержание..." Foreground="#E4E4E7" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
          </ScrollViewer>

          <!-- Footer buttons -->
          <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button Height="30" Padding="12,0" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand" Click="SummaryCopy_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ZenIconLink}" Width="11" Height="11" Fill="#D4D4D8" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Скопировать" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Height="30" Padding="12,0" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" Cursor="Hand" Click="SummaryOpenInChat_Click">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M 2 4 C 2 2.9 2.9 2 4 2 L 16 2 C 17.1 2 18 2.9 18 4 L 18 12 C 18 13.1 17.1 14 16 14 L 6 14 L 2 18 Z" Fill="#A78BFA" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Спросить LumaAI" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock x:Name="SummaryStatusText" Text="" Foreground="#A1A1AA" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>
    </Popup>

    <Popup x:Name="ToastPopup" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" PlacementTarget="{Binding ElementName=SiteShell}" StaysOpen="True">
      <Border Width="300" MinHeight="63" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}" Padding="16,12">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity=".4"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="ToastIconBg" Width="24" Height="24" CornerRadius="12" Background="#1F3D2B" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path x:Name="ToastIcon" Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconCheck}" Stroke="#22C55E" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ToastTitle" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ToastSubtitle" Foreground="#9A96A6" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Background Voice Recognition Worker Host -->
    <Border Width="0" Height="0" Opacity="0" IsHitTestVisible="False" Focusable="False">
      <wv2:WebView2 x:Name="VoiceSpeechWebView" Focusable="False" />
    </Border>
  </Grid>
</Window>
