          </Button>
          <Button Style="{StaticResource MenuButton}" Height="40" Click="Import_Click" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconImport}" Stroke="#C8C3D4" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
