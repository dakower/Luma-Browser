        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="MenuRow" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="MenuRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
