                  <Path x:Name="ExtensionPromptFallbackIcon" Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconPuzzle}" Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
