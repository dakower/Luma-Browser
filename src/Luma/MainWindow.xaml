            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="ZenGlanceTitleText" Text="Предпросмотр вкладки" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ZenGlanceUrlText" Text="https://example.com" FontSize="11.5" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Height="30" Padding="12,0" Margin="0,0,6,0" Background="{DynamicResource Zen_28282E}" BorderBrush="{DynamicResource Zen_3A3A44}" BorderThickness="1" Foreground="#EBEBF5" Cursor="Hand" Click="ZenGlanceSplit_Click" ToolTip="Открыть рядом в Split View (Ctrl+Alt+V)">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ZenIconSplit}" Width="12" Height="12" Stroke="#EBEBF5" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="В Split View" FontSize="11.5" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <Button Height="30" Padding="12,0" Margin="0,0,8,0" Background="#7C5CE4" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Click="ZenGlanceExpand_Click" ToolTip="Перейти на вкладку полностью">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                      <TextBlock Text="Развернуть вкладку" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
              </Button>

              <Button Width="28" Height="28" Style="{StaticResource UtilityIconButtonStyle}" Click="ZenGlanceClose_Click" ToolTip="Закрыть Glance (Esc)">
                <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stroke="#8E8E93" StrokeThickness="1.8" Stretch="Uniform"/>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Glance Content Area -->
          <Border Grid.Row="1" CornerRadius="10" Background="#101013" BorderBrush="#26262C" BorderThickness="1" Padding="18" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Border Width="28" Height="28" CornerRadius="6" Background="#222228" Margin="0,0,10,0" ClipToBounds="True">
                    <Image x:Name="ZenGlanceFaviconImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ZenGlanceDomainBadge" Text="domain.com" FontSize="12" FontWeight="SemiBold" Foreground="#A59BF0"/>
                    <TextBlock x:Name="ZenGlanceContainerBadge" Text="Контейнер: По умолчанию" FontSize="10.5" Foreground="#8E8E93"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ZenGlanceBodyText" Text="Загрузка быстрого предпросмотра Luma Glance..." FontSize="13" Foreground="#D4D4DC" TextWrapping="Wrap" LineHeight="20"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Glance Footer -->
          <Grid Grid.Row="2" Margin="2,10,2,0">
            <TextBlock Text="Совет: зажмите Alt + Левый клик по любой вкладке в сайдбаре для мгновенного предпросмотра без потери фокуса." FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>
    </Popup>

