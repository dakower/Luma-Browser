<Window x:Class="Luma.FloatingVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="420" MinWidth="360" MinHeight="230" MaxWidth="1280" MaxHeight="820"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Inter, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Icons.xaml"/></ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="VideoSurface" Color="#202123"/><SolidColorBrush x:Key="VideoRaised" Color="#27282B"/>
      <SolidColorBrush x:Key="VideoInset" Color="#17181A"/><SolidColorBrush x:Key="VideoBorder" Color="#45464E"/>
      <SolidColorBrush x:Key="VideoAccent" Color="#7468C7"/><SolidColorBrush x:Key="VideoMuted" Color="#8B8C92"/>
      <Style x:Key="VideoIconButton" TargetType="Button"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource VideoMuted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource VideoRaised}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
      <Style TargetType="Slider"><Setter Property="Height" Value="20"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Height="4" Background="{DynamicResource VideoAccent}" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="{DynamicResource VideoBorder}" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Height="4" Background="#44FFFFFF" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="Card" Margin="10" CornerRadius="16" Background="#050505" BorderBrush="{DynamicResource VideoBorder}" BorderThickness="1" ClipToBounds="True">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity=".5"/></Border.Effect>
    <Grid x:Name="VideoSurface" MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown">
      <Image x:Name="VideoFrame" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <Grid x:Name="EmptyState" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Width="34" Height="34" Stretch="Uniform" Data="{StaticResource IconPictureInPicture}" Stroke="{DynamicResource VideoMuted}" StrokeThickness="1.7"/><TextBlock Text="Подключаем видео…" Foreground="{DynamicResource VideoMuted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Grid>

      <Border x:Name="InfoPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="12" Height="64" CornerRadius="12" Background="#E6202123" BorderBrush="{DynamicResource VideoBorder}" BorderThickness="1">
        <Grid Margin="9"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
          <Grid Width="44" Height="44"><Border CornerRadius="9" Background="{DynamicResource VideoRaised}"/><Path x:Name="PreviewFallback" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconPictureInPicture}" Stroke="{DynamicResource VideoMuted}" StrokeThickness="1.8"/><Image x:Name="PreviewImage" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="9" RadiusY="9"/></Image.Clip></Image></Grid>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center"><TextBlock x:Name="TitleText" Text="Видео" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SourceText" Foreground="{DynamicResource VideoMuted}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <Button Grid.Column="2" Style="{StaticResource VideoIconButton}" Width="36" Height="36" Click="ReturnToLuma_Click" ToolTip="Вернуться в Luma и открыть видео на весь экран"><Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconExternalLink}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
          <Button Grid.Column="3" Style="{StaticResource VideoIconButton}" Width="36" Height="36" Click="Close_Click" ToolTip="Закрыть"><Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconX}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
        </Grid>
      </Border>

      <Border x:Name="ControlsPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12" CornerRadius="12" Background="#E6202123" BorderBrush="{DynamicResource VideoBorder}" BorderThickness="1" Padding="12,9">
        <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="26"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource VideoIconButton}" Click="Back_Click" ToolTip="Назад на 15 секунд"><Grid><Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconRotateCcw15}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="15" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
            <Button Style="{StaticResource VideoIconButton}" Width="46" Height="46" Margin="10,0" Background="{DynamicResource VideoAccent}" Foreground="White" Click="Toggle_Click" ToolTip="Пауза / воспроизведение"><Path x:Name="ToggleIcon" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconPause}" Stroke="White" Fill="Transparent" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
            <Button Style="{StaticResource VideoIconButton}" Click="Forward_Click" ToolTip="Вперёд на 15 секунд"><Grid><Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconRotateCw15}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Text="15" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
          </StackPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" Text="0:00" Foreground="{DynamicResource VideoMuted}" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="7,0" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_DragStart" PreviewMouseLeftButtonUp="SeekSlider_DragEnd"/><TextBlock x:Name="RemainingText" Grid.Column="2" Text="−0:00" Foreground="{DynamicResource VideoMuted}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
