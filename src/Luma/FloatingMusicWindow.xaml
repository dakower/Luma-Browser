<Window x:Class="Luma.FloatingMusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="372" Height="82" MinWidth="260" MinHeight="72" MaxWidth="720" MaxHeight="420"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Inter, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseMove="Window_MouseMove" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Icons.xaml"/></ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="FloatSurface" Color="#202123"/><SolidColorBrush x:Key="FloatRaised" Color="#27282B"/>
      <SolidColorBrush x:Key="FloatInset" Color="#17181A"/><SolidColorBrush x:Key="FloatBorder" Color="#45464E"/>
      <SolidColorBrush x:Key="FloatAccent" Color="#7468C7"/><SolidColorBrush x:Key="FloatText" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="FloatMuted" Color="#8B8C92"/>
      <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource FloatMuted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource FloatRaised}"/><Setter Property="Foreground" Value="{DynamicResource FloatText}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
      <Style TargetType="Slider"><Setter Property="Height" Value="20"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Height="4" Background="{DynamicResource FloatAccent}" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="{DynamicResource FloatBorder}" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Height="4" Background="{DynamicResource FloatInset}" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource FloatSurface}" BorderBrush="{DynamicResource FloatBorder}" BorderThickness="1" Padding="10" MouseLeftButtonDown="Card_MouseLeftButtonDown">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity=".42"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ActionColumn" Width="46"/></Grid.ColumnDefinitions>
        <Viewbox MaxWidth="54" MaxHeight="54" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly"><Grid Width="54" Height="54"><Border CornerRadius="11" Background="{DynamicResource FloatRaised}"/><Path x:Name="Fallback" Width="23" Height="23" Stretch="Uniform" Data="{StaticResource IconMusicNote}" Stroke="{DynamicResource FloatAccent}" Fill="Transparent" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Image x:Name="Artwork" Visibility="Collapsed" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,54,54" RadiusX="11" RadiusY="11"/></Image.Clip></Image></Grid></Viewbox>
        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="TitleText" Foreground="{DynamicResource FloatText}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ArtistText" Foreground="{DynamicResource FloatMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Click="Toggle_Click" ToolTip="Пауза / воспроизведение"><Path x:Name="ToggleIcon" Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconPause}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button><Button x:Name="CloseButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Скрыть виджет"><Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconX}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button></StackPanel>
      </Grid>
      <Grid x:Name="Details" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="52"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" VerticalAlignment="Center" Foreground="{DynamicResource FloatMuted}" FontSize="10"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_DragStart" PreviewMouseLeftButtonUp="SeekSlider_DragEnd" Margin="6,0"/><TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource FloatMuted}" FontSize="10"/></Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Click="Previous_Click" ToolTip="Предыдущий трек"><Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconSkipBack}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
          <Button Style="{StaticResource IconButton}" Width="46" Height="46" Margin="8,0" Background="{DynamicResource FloatAccent}" Foreground="White" Click="Toggle_Click" ToolTip="Пауза / воспроизведение"><Path x:Name="ExpandedToggleIcon" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconPause}" Stroke="White" Fill="Transparent" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
          <Button Style="{StaticResource IconButton}" Click="Next_Click" ToolTip="Следующий трек"><Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconSkipNext}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
          <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="Repeat_Click" ToolTip="Повтор трека"><Path Width="18" Height="18" Stretch="Uniform" Data="{StaticResource IconRepeat2}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
        </StackPanel>
        <Grid Grid.Row="2" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Path Width="17" Height="17" Stretch="Uniform" Data="{StaticResource IconVolume}" Stroke="{DynamicResource FloatMuted}" Fill="Transparent" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" Margin="4,0,8,0" ValueChanged="VolumeSlider_ValueChanged" PreviewMouseLeftButtonDown="VolumeSlider_MouseDown" PreviewMouseMove="VolumeSlider_MouseMove" PreviewMouseLeftButtonUp="VolumeSlider_MouseUp"/><TextBlock x:Name="VolumeText" Grid.Column="2" Text="100%" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource FloatMuted}" FontSize="10"/></Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
