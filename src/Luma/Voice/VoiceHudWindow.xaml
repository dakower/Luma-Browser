<Window x:Class="Luma.Voice.VoiceHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luma Voice"
        Width="460"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Storyboard x:Key="PulseOrb" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbGlow" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.9" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.08" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.08" Duration="0:0:1.2" />
        </Storyboard>
    </Window.Resources>
    <Border Margin="16" CornerRadius="22" BorderThickness="1" BorderBrush="#453B66"
            Background="#E6161324">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (Draggable) -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Padding="18,14,14,8" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Orb / Icon -->
                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse x:Name="OrbGlow" Fill="#7B61FF" Opacity="0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="OrbScale" CenterX="16" CenterY="16" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <BlurEffect Radius="14" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Border Width="26" Height="26" CornerRadius="13" Background="#7B61FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3zm5 7a1 1 0 1 0-2 0 5 5 0 0 1-10 0 1 1 0 1 0-2 0 7 7 0 0 0 6 6.92V18H7a1 1 0 1 0 0 2h10a1 1 0 1 0 0-2h-2v-2.08A7 7 0 0 0 17 9z"
                                  Fill="White" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Title and Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Luma Voice" FontWeight="Bold" FontSize="14" Foreground="#F4F1FD" />
                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="8" Background="#292242" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadge" Text="Слушаю..." FontSize="10.5" FontWeight="SemiBold" Foreground="#B9A8FF" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Width="26" Height="26" Margin="4,0,0,0" Click="Close_Click"
                            Cursor="Hand" ToolTip="Закрыть" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="13">
                                    <Path Data="M18 6L6 18M6 6l12 12" Stroke="#8C85A8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#32284F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- User Query Display -->
            <Border Grid.Row="1" Margin="18,4,18,8" Padding="12,8" Background="#1D1830" CornerRadius="10"
                    BorderThickness="1" BorderBrush="#352B52" x:Name="QueryBorder" Visibility="Collapsed">
                <TextBlock x:Name="QueryText" Text="«...»" FontSize="12.5" Foreground="#D5CEF2" FontStyle="Italic"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Assistant Response Output -->
            <ScrollViewer Grid.Row="2" Margin="18,4,18,12" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ResponseText" Text="" FontSize="13" LineHeight="19" Foreground="#EDE8FA"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Action Bar -->
            <Border Grid.Row="3" Margin="18,0,18,14" x:Name="ActionBar" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenBrowserButton" Padding="12,6" Background="#7B61FF" Foreground="White"
                            FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="OpenBrowser_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#9079FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Открыть в Luma" />
                            <Path Data="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"
                                  Stroke="White" StrokeThickness="1.5" Width="10" Height="10" Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
