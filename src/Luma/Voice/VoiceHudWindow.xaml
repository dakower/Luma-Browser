<Window x:Class="Luma.Voice.VoiceHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luma Voice"
        Width="470"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Storyboard x:Key="PulseOrb" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbGlow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.9" Duration="0:0:1.1" />
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.12" Duration="0:0:1.1" />
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.12" Duration="0:0:1.1" />
        </Storyboard>
        <Storyboard x:Key="WaveVisualizer" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="WaveBar1" Storyboard.TargetProperty="Height"
                             From="5" To="18" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="WaveBar2" Storyboard.TargetProperty="Height"
                             From="16" To="6" Duration="0:0:0.42" BeginTime="0:0:0.08" />
            <DoubleAnimation Storyboard.TargetName="WaveBar3" Storyboard.TargetProperty="Height"
                             From="7" To="22" Duration="0:0:0.38" BeginTime="0:0:0.04" />
            <DoubleAnimation Storyboard.TargetName="WaveBar4" Storyboard.TargetProperty="Height"
                             From="14" To="5" Duration="0:0:0.45" BeginTime="0:0:0.12" />
        </Storyboard>
    </Window.Resources>

    <!-- Main Card with Glowing Frosted Gradient Border -->
    <Border Margin="16" CornerRadius="22" BorderThickness="1.5" Background="#F20F0C1B">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A855F7" Offset="0.0" />
                <GradientStop Color="#EC4899" Offset="0.5" />
                <GradientStop Color="#3B82F6" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (Draggable) -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Padding="16,14,14,8" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Orb + Voice Equalizer -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Glowing Orb -->
                        <Grid Width="34" Height="34" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="OrbGlow" Fill="#A855F7" Opacity="0.4">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="OrbScale" CenterX="17" CenterY="17" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <BlurEffect Radius="14" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#C084FC" Offset="0.0" />
                                        <GradientStop Color="#7C3AED" Offset="0.6" />
                                        <GradientStop Color="#4338CA" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Path Data="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3zm5 7a1 1 0 1 0-2 0 5 5 0 0 1-10 0 1 1 0 1 0-2 0 7 7 0 0 0 6 6.92V18H7a1 1 0 1 0 0 2h10a1 1 0 1 0 0-2h-2v-2.08A7 7 0 0 0 17 9z"
                                      Fill="White" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Equalizer Wave Bars -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border x:Name="WaveBar1" Width="3" Height="6" CornerRadius="1.5" Background="#C084FC" Margin="1,0" VerticalAlignment="Center" />
                            <Border x:Name="WaveBar2" Width="3" Height="12" CornerRadius="1.5" Background="#EC4899" Margin="1,0" VerticalAlignment="Center" />
                            <Border x:Name="WaveBar3" Width="3" Height="8" CornerRadius="1.5" Background="#A855F7" Margin="1,0" VerticalAlignment="Center" />
                            <Border x:Name="WaveBar4" Width="3" Height="10" CornerRadius="1.5" Background="#60A5FA" Margin="1,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Title & Status Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Luma AI" FontWeight="Bold" FontSize="14.5" Foreground="#FAF5FF" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="9" Background="#241B3D" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="#3D2D5E">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusBadge" Text="Слушаю..." FontSize="11" FontWeight="SemiBold" Foreground="#DDD6FE" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sound Mute/Unmute Toggle Button -->
                    <Button Grid.Column="2" x:Name="MuteButton" Width="28" Height="28" Margin="4,0,4,0" Click="MuteButton_Click"
                            Cursor="Hand" ToolTip="Озвучка ответов (вкл/выкл)" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#32284F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path x:Name="MuteIcon"
                              Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                              Fill="#C4B5FD" Stretch="Uniform" Width="14" Height="14" />
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="3" Width="28" Height="28" Click="Close_Click"
                            Cursor="Hand" ToolTip="Скрыть (Esc)" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                    <Path Data="M18 6L6 18M6 6l12 12" Stroke="#9CA3AF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3D1D2E" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- User Query Display -->
            <Border Grid.Row="1" Margin="16,4,16,8" Padding="12,8" Background="#1D1630" CornerRadius="10"
                    BorderThickness="1" BorderBrush="#3B2E58" x:Name="QueryBorder" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="«" FontSize="14" Foreground="#A78BFA" FontWeight="Bold" Margin="0,-2,4,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" x:Name="QueryText" Text="..." FontSize="12.5" Foreground="#E0D7FE"
                               FontStyle="Italic" TextWrapping="Wrap" LineHeight="17" />
                </Grid>
            </Border>

            <!-- Assistant Response Output -->
            <ScrollViewer Grid.Row="2" Margin="16,4,16,12" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ResponseText" Text="" FontSize="13.5" LineHeight="20" Foreground="#F5F3FF"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Action Bar -->
            <Border Grid.Row="3" Margin="16,0,16,14" x:Name="ActionBar" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="15 сек бездействия до скрытия" FontSize="11" Foreground="#7C739E"
                               VerticalAlignment="Center" Margin="2,0,0,0" />

                    <Button Grid.Column="1" x:Name="OpenBrowserButton" Padding="14,6" Foreground="White"
                            FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="OpenBrowser_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7C3AED" Offset="0.0" />
                                            <GradientStop Color="#4F46E5" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#9061FF" Offset="0.0" />
                                                    <GradientStop Color="#6366F1" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Открыть в Luma" />
                            <Path Data="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"
                                  Stroke="White" StrokeThickness="1.5" Width="10" Height="10" Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
