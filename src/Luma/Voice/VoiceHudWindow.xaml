<Window x:Class="Luma.Voice.VoiceHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luma Voice"
        Width="460"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Inter, Segoe UI">
    <Window.Resources>
        <!-- Window Entrance Animation (Smooth Glide & Fade) -->
        <Storyboard x:Key="EntranceAnimation">
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1.0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1.0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardTranslate" Storyboard.TargetProperty="Y"
                             From="-10" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Pulsing Soft Ripple for Lucide Mic Orb -->
        <Storyboard x:Key="PulseOrb" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbGlow" Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.65" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.18" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.18" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbGlowSecondary" Storyboard.TargetProperty="Opacity"
                             From="0.05" To="0.32" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbScaleSecondary" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.32" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbScaleSecondary" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.32" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Thinking Shimmer Animation for Status Dot & Accent Glow -->
        <Storyboard x:Key="ThinkingPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1.0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TopShimmer" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.85" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Query Bubble Slide-In Animation -->
        <Storyboard x:Key="QueryEnterAnimation">
            <DoubleAnimation Storyboard.TargetName="QueryBorder" Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="QueryTranslate" Storyboard.TargetProperty="Y"
                             From="-6" To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Main Card in Luma Signature Dark Style -->
    <Border x:Name="Card" Margin="16" CornerRadius="16" BorderThickness="1" BorderBrush="#45464E" Background="#202123">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" CenterX="230" CenterY="100" />
                <TranslateTransform x:Name="CardTranslate" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Subtle Ambient Shimmer Highlight along the top edge -->
            <Border Grid.Row="0" Height="1.5" VerticalAlignment="Top" Margin="16,0,16,0" CornerRadius="1">
                <Border.Background>
                    <LinearGradientBrush x:Name="TopShimmer" StartPoint="0,0" EndPoint="1,0" Opacity="0.3">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="#7468C7" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Header (Draggable) -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Padding="16,14,14,8" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Luma Icon with Multi-Layer Soft Ripple & Official Lucide Mic -->
                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                        <!-- Outer Soft Ripple 2 -->
                        <Ellipse x:Name="OrbGlowSecondary" Fill="#7468C7" Opacity="0.1" Width="32" Height="32">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="OrbScaleSecondary" CenterX="16" CenterY="16" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <BlurEffect Radius="14" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Outer Soft Ripple 1 -->
                        <Ellipse x:Name="OrbGlow" Fill="#7468C7" Opacity="0.25" Width="28" Height="28">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="OrbScale" CenterX="14" CenterY="14" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <BlurEffect Radius="9" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Inner Badge with Lucide Mic (Symmetric & Centered) -->
                        <Border Width="26" Height="26" CornerRadius="13" Background="#7468C7" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 12 2 A 3 3 0 0 0 9 5 V 12 A 3 3 0 0 0 15 12 V 5 A 3 3 0 0 0 12 2 Z M 19 10 V 12 A 7 7 0 0 1 5 12 V 10 M 12 19 V 22"
                                  Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Stretch="Uniform" Width="13" Height="13"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Border>
                    </Grid>

                    <!-- Title & Status Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Luma Voice" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="8" Background="#17181A" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="#323338">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#7468C7" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusBadge" Text="Слушаю..." FontSize="11" FontWeight="Medium" Foreground="#D1D2D6" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Close Button (Lucide X) -->
                    <Button Grid.Column="2" Width="28" Height="28" Click="Close_Click"
                            Cursor="Hand" ToolTip="Скрыть (Esc)" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                    <Path x:Name="ic" Data="M 18 6 L 6 18 M 6 6 L 18 18"
                                          Stroke="#8B8C92" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#27282B" />
                                        <Setter TargetName="ic" Property="Stroke" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- User Query Display with Smooth Slide-in -->
            <Border Grid.Row="1" Margin="16,4,16,8" Padding="12,8" Background="#17181A" CornerRadius="10"
                    BorderThickness="1" BorderBrush="#323338" x:Name="QueryBorder" Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="QueryTranslate" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="«" FontSize="13" Foreground="#7468C7" FontWeight="SemiBold" Margin="0,-1,4,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" x:Name="QueryText" Text="..." FontSize="12.5" Foreground="#D1D2D6"
                               FontStyle="Italic" TextWrapping="Wrap" LineHeight="17" />
                </Grid>
            </Border>

            <!-- Assistant Response Output -->
            <ScrollViewer Grid.Row="2" Margin="16,4,16,12" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ResponseText" Text="" FontSize="13" LineHeight="20" Foreground="#F4F0F6"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Action Bar -->
            <Border Grid.Row="3" Margin="16,0,16,14" x:Name="ActionBar" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="15 сек бездействия до скрытия" FontSize="11" Foreground="#716C82"
                               VerticalAlignment="Center" Margin="2,0,0,0" />

                    <Button Grid.Column="1" x:Name="OpenBrowserButton" Padding="14,6" Foreground="White"
                            FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="OpenBrowser_Click"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#7468C7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#8478DC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Открыть в Luma" />
                            <Path Data="M 15 3 H 21 V 9 M 10 14 L 21 3 M 18 13 V 19 A 2 2 0 0 1 16 21 H 5 A 2 2 0 0 1 3 19 V 8 A 2 2 0 0 1 5 6 H 11"
                                  Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Width="10" Height="10" Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
