<Window x:Class="Luma.UpdatePromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Обновление Luma" Width="620" SizeToContent="Height" MaxHeight="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Inter, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Lucide X and Check, embedded for this standalone dialog. -->
    <Geometry x:Key="IconX">M 18 6 L 6 18 M 6 6 L 18 18</Geometry>
    <Geometry x:Key="IconCheck">M 20 6 L 9 17 L 4 12</Geometry>
    <SolidColorBrush x:Key="UpdateAccent" Color="#7468C7"/><SolidColorBrush x:Key="UpdateSoft" Color="#2F2B47"/><SolidColorBrush x:Key="UpdateSurface" Color="#202123"/><SolidColorBrush x:Key="UpdateRaised" Color="#27282B"/><SolidColorBrush x:Key="UpdateInset" Color="#17181A"/><SolidColorBrush x:Key="UpdateBorder" Color="#323338"/><SolidColorBrush x:Key="UpdateStrong" Color="#45464E"/><SolidColorBrush x:Key="UpdateMutedAccent" Color="#B5AEDF"/><SolidColorBrush x:Key="UpdateMuted" Color="#8B8C92"/><SolidColorBrush x:Key="UpdateSecondary" Color="#D1D2D6"/>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Height" Value="50"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource UpdateRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource UpdateBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonChrome" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="18,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource UpdateSoft}"/><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource UpdateStrong}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value=".76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Background" Value="{DynamicResource UpdateAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource UpdateMutedAccent}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonChrome" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="18,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value=".9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CloseButtonStyle" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{DynamicResource UpdateSecondary}"/><Setter Property="Background" Value="{DynamicResource UpdateRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource UpdateBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CloseChrome" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseChrome" Property="Background" Value="{DynamicResource UpdateSoft}"/><Setter TargetName="CloseChrome" Property="BorderBrush" Value="{DynamicResource UpdateAccent}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseChrome" Property="Opacity" Value=".68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="24"><Border CornerRadius="30" Background="{DynamicResource UpdateSurface}" BorderBrush="{DynamicResource UpdateStrong}" BorderThickness="1" Padding="36" MouseLeftButtonDown="Window_Drag"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="48" ShadowDepth="17" Opacity=".7"/></Border.Effect><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Grid Width="56" Height="56" HorizontalAlignment="Left"><Border CornerRadius="18" Background="{DynamicResource UpdateAccent}"/><Image Source="Assets/luma-mark.png" Width="39"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ОБНОВЛЕНИЕ LUMA" Foreground="{DynamicResource UpdateMuted}" FontSize="10.5" FontWeight="Medium"/><Border Margin="0,7,0,0" Padding="10,5" HorizontalAlignment="Left" CornerRadius="9" Background="{DynamicResource UpdateInset}" BorderBrush="{DynamicResource UpdateBorder}" BorderThickness="1"><TextBlock x:Name="VersionText" Foreground="{DynamicResource UpdateSecondary}" FontSize="12.5" FontWeight="Medium"/></Border></StackPanel><Button x:Name="CloseButton" Grid.Column="2" Click="Later_Click" Style="{StaticResource CloseButtonStyle}"><Path Stretch="Uniform" Width="15" Height="15" Data="{StaticResource IconX}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button></Grid>
    <TextBlock x:Name="TitleText" Text="Новая версия готова" Foreground="White" FontSize="29" FontWeight="SemiBold" LineHeight="36" TextWrapping="Wrap" Margin="0,30,0,0"/><TextBlock Text="Обновление уже загружено и проверено. Перезапустите Luma, чтобы установить новую версию." Foreground="{DynamicResource UpdateSecondary}" FontSize="13.5" FontWeight="Medium" LineHeight="22" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <Border CornerRadius="18" Background="{DynamicResource UpdateInset}" BorderBrush="{DynamicResource UpdateBorder}" BorderThickness="1" Padding="18" Margin="0,24,0,0"><StackPanel><TextBlock Text="ЧТО ИЗМЕНИЛОСЬ" Foreground="{DynamicResource UpdateMuted}" FontSize="9.5" FontWeight="SemiBold"/><TextBlock x:Name="NotesText" Foreground="{DynamicResource UpdateSecondary}" FontSize="13" FontWeight="SemiBold" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
    <Border CornerRadius="14" Background="#14261F" BorderBrush="#2B5744" BorderThickness="1" Padding="14" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="11" Background="#214A37"><Path Stretch="Uniform" Width="13" Height="13" Data="{StaticResource IconCheck}" Stroke="#79E0A5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Обновление проверено" Foreground="#BCE9CD" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="Цифровая подпись · размер · SHA-256" Foreground="#6FA487" FontSize="10.5" FontWeight="Medium" Margin="0,2,0,0"/></StackPanel></Grid></Border>
    <Grid Margin="0,26,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width=".82*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions><Button x:Name="LaterButton" Grid.Column="0" Content="Позже" Click="Later_Click" Style="{StaticResource DialogButton}"/><Button x:Name="InstallButton" Grid.Column="2" Content="Перезапустить и обновить" Click="Install_Click" Style="{StaticResource PrimaryButton}"/></Grid><TextBlock Text="Вкладки, профиль и настройки сохранятся" Foreground="{DynamicResource UpdateMuted}" FontSize="10.5" FontWeight="Medium" TextAlignment="Center" Margin="0,16,0,0"/>
  </StackPanel></Border></Grid>
</Window>
